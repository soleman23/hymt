---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Newsletter from "../components/Newsletter.astro";
import Accordion from "../components/Accordion.astro";
import Analytics from "../components/Analytics.astro";

interface Props {
  title: string;
  description?: string;
  active?: string;
  ogImage?: string;
  pageCss?: string;
  extraCss?: string;
  showNewsletter?: boolean;
  canonicalPath?: string;
  schemaType?: "website" | "article";
  publishDate?: string;
  /** ISO date of last substantive update; emitted as Article.dateModified. */
  modifiedDate?: string;
  /** Hero image URL to preload — the LCP element on every templated page is a
   *  CSS background-image the browser cannot discover until CSSOM is built. */
  preloadImage?: string;
}

const {
  title,
  description = "Hit Your Mark Travel designs bespoke journeys for the time-poor, taste-rich traveler. A lifetime of experience. A global network. And someone who actually picks up the phone.",
  active = "",
  ogImage = "/assets/og-default.jpg",
  pageCss = "",
  extraCss = "",
  showNewsletter = true,
  canonicalPath = "",
  schemaType = "website",
  publishDate = "",
  modifiedDate = "",
  preloadImage = "",
} = Astro.props;

/* Canonicals, og:url and the JSON-LD all derive from astro.config.mjs `site`,
   which is the single place the production domain is written. Change it there
   and every tag here follows. */
const site = (Astro.site?.href ?? "https://www.hymtravel.com/").replace(/\/$/, "");
/* Astro.url.pathname carries NO query string — that is load-bearing, not an
   omission (P1-7/F14). The footer links /plan-your-trip/?type=group and
   ?type=honeymoon; both must canonical to /plan-your-trip/ or they become
   duplicate pages. Never "improve" this to include Astro.url.search. */
const canonical = canonicalPath || Astro.url.pathname;
const fullTitle = title.includes("Hit Your Mark") ? title : `${title} — Hit Your Mark Travel`;

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "TravelAgency",
  "name": "Hit Your Mark Travel",
  "url": site,
  "logo": `${site}/assets/logo.png`,
  "description": "Single-agent luxury travel firm designing bespoke journeys for time-poor, taste-rich travelers.",
  "telephone": "+1-408-568-1404",
  "email": "mark@hymtravel.com",
  "founder": { "@type": "Person", "name": "Mark Sole", "jobTitle": "Founder & Travel Director" },
  "areaServed": "United States",
  "sameAs": ["https://www.instagram.com/travelwithsoleman/"]
};

const articleSchema = schemaType === "article" ? {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "author": { "@type": "Person", "name": "Mark Sole" },
  "publisher": { "@type": "Organization", "name": "Hit Your Mark Travel", "logo": { "@type": "ImageObject", "url": `${site}/assets/logo.png` } },
  ...(publishDate ? { "datePublished": publishDate } : {}),
  ...(publishDate ? { "dateModified": modifiedDate || publishDate } : {}),
  "mainEntityOfPage": `${site}${canonical}`
} : null;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{fullTitle}</title>
<meta name="description" content={description}>
<link rel="canonical" href={`${site}${canonical}`}>
<meta name="theme-color" content="#0d1b2a">

{preloadImage && (
  <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
)}

<meta property="og:type" content={schemaType === "article" ? "article" : "website"}>
<meta property="og:site_name" content="Hit Your Mark Travel">
<meta property="og:title" content={fullTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={`${site}${canonical}`}>
<meta property="og:image" content={`${site}${ogImage}`}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={fullTitle}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={`${site}${ogImage}`}>

<link rel="icon" type="image/png" href="/assets/logo.png">
<link rel="apple-touch-icon" href="/assets/logo.png">

<!-- Self-hosted fonts (P1-3): declared in styles-master.css, served from
     /assets/fonts/. Only the two families every fold uses get preloaded;
     font preloads require crossorigin even same-origin. -->
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/raleway-var.woff2" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/dmsans-var.woff2" crossorigin>

<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
{articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}

<style is:global>
  @import "../styles-master.css";
  @import "../styles-site.css";
</style>
{pageCss && <style is:global set:html={pageCss} />}
{extraCss && <style is:global set:html={extraCss} />}
</head>
<body class="theme-dark">
<a class="skip-link" href="#main">Skip to content</a>
<Header active={active} />
<main id="main">
  <slot />
</main>
{showNewsletter && <Newsletter />}
<Footer />
<Accordion />
<Analytics />
</body>
</html>
