---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Newsletter from "../components/Newsletter.astro";
import Accordion from "../components/Accordion.astro";
import Analytics from "../components/Analytics.astro";
import Schema from "../components/Schema.astro";

interface Props {
  title: string;
  description?: string;
  active?: string;
  ogImage?: string;
  /** Alt text for og:image. Describes the IMAGE, not the page — the default
   *  below describes the crest plate, so a page that falls back to it does
   *  not end up claiming the plate is a photograph of a destination. The
   *  section layouts pass a real description only when a hero crop is
   *  actually used. CONTENT-STANDARDS § 4 requires this. */
  ogImageAlt?: string;
  pageCss?: string;
  extraCss?: string;
  showNewsletter?: boolean;
  canonicalPath?: string;
  /** og:type only. JSON-LD shapes live in src/lib/schema.ts (P2-1). */
  schemaType?: "website" | "article";
  /** JSON-LD node(s) for this page, built with src/lib/schema.ts builders.
   *  Base knows nothing about schema shapes — it prints what it is handed. */
  schema?: object | object[];
  /** Hero image URL to preload — the LCP element on every templated page is a
   *  CSS background-image the browser cannot discover until CSSOM is built. */
  preloadImage?: string;
}

const {
  title,
  description = "Hit Your Mark Travel designs bespoke journeys for the time-poor, taste-rich traveler. A lifetime of experience. A global network. And someone who actually picks up the phone.",
  active = "",
  ogImage = "/assets/og-default.jpg",
  ogImageAlt = "Hit Your Mark Travel",
  pageCss = "",
  extraCss = "",
  showNewsletter = true,
  canonicalPath = "",
  schemaType = "website",
  schema = undefined,
  preloadImage = "",
} = Astro.props;

/* Canonicals, og:url and the JSON-LD all derive from astro.config.mjs `site`,
   which is the single place the production domain is written. Change it there
   and every tag here follows. */
const site = (Astro.site?.href ?? "https://www.hymtravel.com/").replace(/\/$/, "");
/* Astro.url.pathname carries NO query string — that is load-bearing, not an
   omission (P1-7/F14). The footer links /plan-your-trip/?type=group and
   ?type=honeymoon; both must canonical to /plan-your-trip/ or they become
   duplicate pages. Never "improve" this to include Astro.url.search. */
const canonical = canonicalPath || Astro.url.pathname;
const fullTitle = title.includes("Hit Your Mark") ? title : `${title} — Hit Your Mark Travel`;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{fullTitle}</title>
<meta name="description" content={description}>
<link rel="canonical" href={`${site}${canonical}`}>
<meta name="theme-color" content="#0d1b2a">

{preloadImage && (
  <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
)}

<meta property="og:type" content={schemaType === "article" ? "article" : "website"}>
<meta property="og:site_name" content="Hit Your Mark Travel">
<meta property="og:title" content={fullTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={`${site}${canonical}`}>
<meta property="og:image" content={`${site}${ogImage}`}>
{/* Every og:image on this site is 1200x630 — the default plate and all 70
    hero crops. The literals are safe because og-image asserts each target's
    real header dimensions against them, so a differently-shaped image fails
    the build rather than shipping a lie a crawler would size a card from. */}
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={ogImageAlt}>
<meta property="og:locale" content="en_US">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={fullTitle}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={`${site}${ogImage}`}>
<meta name="twitter:image:alt" content={ogImageAlt}>

<link rel="icon" type="image/png" href="/assets/logo.png">
<link rel="apple-touch-icon" href="/assets/logo.png">

<!-- Self-hosted fonts (P1-3): declared in styles-master.css, served from
     /assets/fonts/. Only the two families every fold uses get preloaded;
     font preloads require crossorigin even same-origin. -->
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/raleway-var.woff2" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/dmsans-var.woff2" crossorigin>

{schema && <Schema schema={schema} />}

<style is:global>
  @import "../styles-master.css";
  @import "../styles-site.css";
</style>
{pageCss && <style is:global set:html={pageCss} />}
{extraCss && <style is:global set:html={extraCss} />}
</head>
<body class="theme-dark">
<a class="skip-link" href="#main">Skip to content</a>
<Header active={active} />
<main id="main">
  <slot />
</main>
{showNewsletter && <Newsletter />}
<Footer />
<Accordion />
<Analytics />
</body>
</html>
