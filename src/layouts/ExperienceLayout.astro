---
/**
 * ExperienceLayout — the one template every /experiences/<slug>/ page uses.
 *
 * Same shape as DestinationLayout: it owns the breadcrumb and the hero so
 * they cannot drift page to page, pages pass their copy in as props, and the
 * body sections come through the default slot. Styling is styles/experience.css,
 * imported normally so Astro bundles it into a cached asset rather than
 * inlining a copy into all 12 pages.
 *
 * Copy fields render with set:html because the content carries HTML entities
 * and <br> line breaks the original pages depend on.
 *
 * The hub at /experiences/ is a different page type and is not on this layout.
 */
import Base from "./Base.astro";
import { breadcrumbs, extractFaq, faq, plain, service, webPage } from "../lib/schema";
// section-shared.css must stay first: experience.css overrides .intro-content
// and .seasons-grid from it, and later source order is what makes that work.
import "../styles/section-shared.css";
import "../styles/experience.css";

import { OG_CROPS } from "../lib/og-crops";
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalPath?: string;
  schemaType?: "website" | "article";
  /** Breadcrumb leaf — the experience's own name. */
  name: string;
  hero: {
    /** Full-bleed background photo. Falls back to the placeholder plate. */
    image?: string;
    /** Placeholder caption shown while no photograph exists. */
    placeholder?: string;
    eyebrow: string;
    headline: string;
    sub: string;
    ctaPrimary: { label: string; href: string };
    ctaSecondary?: { label: string; href: string };
  };
}

const { title, description, ogImage, canonicalPath, schemaType, name, hero } = Astro.props;
const bgStyle = hero.image ? `background-image:url('${hero.image}')` : undefined;

/* ── JSON-LD (P2-4/P2-5) — same pattern as DestinationLayout ── */
const SITE = (Astro.site?.href ?? "https://www.hymtravel.com/").replace(/\/$/, "");
const path = canonicalPath || Astro.url.pathname;
const trail = [
  { name: "Home", path: "/" },
  { name: "Experiences", path: "/experiences/" },
  { name },
];
const bodyHtml = await Astro.slots.render("default");
const faqPairs = extractFaq(bodyHtml);
const schema = [
  breadcrumbs(SITE, trail.map((c) => ({ ...c, name: plain(c.name) }))),
  webPage(SITE, { name: plain(name), description: description ?? "", path }),
  service(SITE, {
    name: plain(name),
    serviceType: plain(name),
    description: description ?? "",
    path,
  }),
  faqPairs.length ? faq(faqPairs) : null,
].filter(Boolean);

/* og:image (#98 follow-up): every page shipped the same crest plate, so
   every social and AI share of any page looked identical. The crop is
   derived from the hero the page already declares — see
   tools/make-og-crops.mjs. An explicit ogImage prop still wins, and a
   hero with no crop falls through to Base.astro's default. */
const ogCrop = ogImage ?? (hero?.image ? OG_CROPS[hero.image] : undefined);

---
<Base
  title={title}
  description={description}
  ogImage={ogCrop}
  canonicalPath={canonicalPath}
  schemaType={schemaType}
  schema={schema}
  preloadImage={hero.image}
  active="experiences"
>
  {/* Rendered from the SAME trail array the BreadcrumbList schema uses. */}
  <div class="breadcrumb">
    <div class="breadcrumb__inner">
      {trail.map((c, i) => (
        <>
          {i > 0 && <span class="breadcrumb__sep">&rsaquo;</span>}
          {i < trail.length - 1
            ? <a class="breadcrumb__link" href={c.path} set:html={c.name} />
            : <span class="breadcrumb__current" set:html={c.name} />}
        </>
      ))}
    </div>
  </div>

  <section class="exp-hero">
    <div class="exp-hero__bg" style={bgStyle}>
      {!hero.image && hero.placeholder && (
        <span class="exp-hero__bg-ph" set:html={hero.placeholder} />
      )}
    </div>
    <img src="/assets/logo.png" class="exp-hero__watermark" alt="" aria-hidden="true" width="256" height="256" decoding="async">
    <div class="exp-hero__overlay"></div>
    <div class="exp-hero__content">
      <div class="label" set:html={hero.eyebrow} />
      <h1 class="exp-hero__headline" set:html={hero.headline} />
      <p class="exp-hero__sub" set:html={hero.sub} />
      <div class="exp-hero__ctas">
        <a href={hero.ctaPrimary.href} class="btn-primary-gold" set:html={hero.ctaPrimary.label} />
        {hero.ctaSecondary && (
          <a href={hero.ctaSecondary.href} class="btn-ghost-gold" set:html={hero.ctaSecondary.label} />
        )}
      </div>
    </div>
  </section>

  {/* The slot was already rendered above for FAQ extraction — emit that
      capture rather than rendering the content a second time. */}
  <Fragment set:html={bodyHtml} />
</Base>
