---
/**
 * JournalLayout — the one template every /travel-journal/<slug>/ post uses.
 *
 * Same idea as DestinationLayout and ExperienceLayout: the layout owns the
 * hero and breadcrumb so they cannot drift, posts pass their copy as props,
 * and the article body comes through the default slot. Styling is
 * styles/journal.css, imported normally so Astro bundles it into one cached
 * asset instead of inlining a copy into all 29 posts.
 *
 * Note the order here is hero-then-breadcrumb, which is the journal's own
 * arrangement and the reverse of the other two sections. The breadcrumb also
 * uses bare anchors rather than .breadcrumb__link — kept as-is so the
 * existing journal CSS still matches.
 *
 * Copy renders with set:html because the content carries HTML entities and
 * <br> line breaks the original posts depend on.
 *
 * The hub at /travel-journal/ is a different page type and is not on this.
 */
import Base from "./Base.astro";
import { article, breadcrumbs, plain } from "../lib/schema";
import "../styles/journal.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalPath?: string;
  /**
   * ISO date (YYYY-MM-DD). Deliberately unset until DNS cutover: DECISIONS.md
   * D6 dates every post the day it goes live, never earlier. The launch
   * runbook runs `node tools/set-journal-dates.mjs --date <launch date>` to
   * stamp all 29 posts in one pass. When set, the hero shows a real <time>
   * element instead of the legacy display string, and Base emits
   * Article.datePublished / dateModified.
   */
  publishDate?: string;
  /** ISO date of the last substantive update. Defaults to publishDate. */
  modifiedDate?: string;
  /** Breadcrumb leaf and hero headline are separate: the crumb is usually shorter. */
  name: string;
  category: { label: string; href?: string };
  hero: {
    image?: string;
    /** Placeholder plate shown while no photograph exists. */
    placeholder?: string;
    headline: string;
    deck: string;
    date: string;
    readTime: string;
  };
}

const { title, description, ogImage, canonicalPath, publishDate, modifiedDate, name, category, hero } = Astro.props;
const bgStyle = hero.image ? `background-image:url('${hero.image}')` : undefined;
const catHref = category.href ?? "/travel-journal/";

/* en-US long form; parsed at UTC noon so the displayed day never shifts
   across timezones. */
const fmt = (iso: string) =>
  new Date(iso + "T12:00:00Z").toLocaleDateString("en-US", {
    year: "numeric", month: "long", day: "numeric", timeZone: "UTC",
  });
const effectiveModified = modifiedDate || publishDate;
const showUpdated = publishDate && effectiveModified && effectiveModified !== publishDate;

/* ── JSON-LD (P2-4/P2-5) ──
   Article author/publisher reference the Person and org nodes by @id
   instead of restating them. Dates stay absent until the launch runbook
   stamps publishDate (DECISIONS.md D6). The visible breadcrumb below
   renders from this same trail array. */
const SITE = (Astro.site?.href ?? "https://www.hymtravel.com/").replace(/\/$/, "");
const path = canonicalPath || Astro.url.pathname;
const trail = [
  { name: "Home", path: "/" },
  { name: "Travel Journal", path: "/travel-journal/" },
  { name: category.label, path: catHref },
  { name },
];
const bodyHtml = await Astro.slots.render("default");
const wordCount = plain(bodyHtml).split(" ").filter(Boolean).length;
const schema = [
  breadcrumbs(SITE, trail.map((c) => ({ ...c, name: plain(c.name) }))),
  article(SITE, {
    headline: plain(hero.headline),
    description: description ?? "",
    path,
    image: hero.image ?? "/assets/og-default.jpg",
    datePublished: publishDate || undefined,
    dateModified: effectiveModified || undefined,
    section: plain(category.label),
    wordCount,
  }),
];
---
<Base
  title={title}
  description={description}
  ogImage={ogImage}
  canonicalPath={canonicalPath}
  schemaType="article"
  schema={schema}
  preloadImage={hero.image}
  active="journal"
>
  <section class="post-hero">
    <div class="post-hero__bg" style={bgStyle}>
      {!hero.image && hero.placeholder && (
        <span class="post-hero__bg-ph" set:html={hero.placeholder} />
      )}
    </div>
    <img src="/assets/logo.png" class="post-hero__watermark" alt="" aria-hidden="true" width="1254" height="1254" decoding="async">
    <div class="post-hero__overlay"></div>
    <div class="post-hero__content">
      <div class="post-hero__meta">
        <span class="post-hero__cat" set:html={category.label} />
        <span class="post-hero__dot"></span>
        {publishDate ? (
          <span class="post-hero__date">
            <time datetime={publishDate}>{fmt(publishDate)}</time>
            {showUpdated && <> · Updated <time datetime={effectiveModified}>{fmt(effectiveModified)}</time></>}
          </span>
        ) : (
          <span class="post-hero__date" set:html={hero.date} />
        )}
        <span class="post-hero__dot"></span>
        <span class="post-hero__read" set:html={hero.readTime} />
      </div>
      <h1 class="post-hero__headline" set:html={hero.headline} />
      <p class="post-hero__deck" set:html={hero.deck} />
    </div>
  </section>

  {/* Rendered from the SAME trail array the BreadcrumbList schema uses.
      Bare anchors, not .breadcrumb__link — the journal CSS keys on these. */}
  <nav class="breadcrumb" aria-label="Breadcrumb">
    {trail.map((c, i) => (
      <>
        {i > 0 && <span class="breadcrumb__sep" aria-hidden="true">&rsaquo;</span>}
        {i < trail.length - 1
          ? <a href={c.path} set:html={c.name} />
          : <span class="breadcrumb__current" aria-current="page" set:html={c.name} />}
      </>
    ))}
  </nav>

  {/* The slot was already rendered above for the word count — emit that
      capture rather than rendering the content a second time. */}
  <Fragment set:html={bodyHtml} />
</Base>
