---
import Base from "../../layouts/Base.astro";
import Content from "../../content-pages/about.html?raw";
const pageCss = "\n/* \u2500\u2500 ABOUT PAGE EXTRAS \u2500\u2500 */\n\n/* PAGE HERO */\n.page-hero {\n  position:relative;min-height:60vh;margin-top:76px;\n  background:var(--navy-800);display:flex;align-items:flex-end;\n  overflow:hidden;\n}\n.page-hero__bg {\n  position:absolute;inset:0;background:var(--navy-800);\n  display:flex;align-items:center;justify-content:center;\n}\n.page-hero__watermark {\n  position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);\n  width:min(480px,60vw);height:min(480px,60vw);object-fit:contain;\n  opacity:.04;pointer-events:none;\n}\n.page-hero__overlay {\n  position:absolute;inset:0;\n  background:linear-gradient(180deg,rgba(8,15,26,0) 0%,rgba(8,15,26,.6) 60%,rgba(8,15,26,.95) 100%);\n}\n.page-hero__content {\n  position:relative;z-index:1;width:100%;\n  padding:0 52px 72px;max-width:800px;\n}\n.page-hero__eyebrow { margin-bottom:16px }\n.page-hero__headline {\n  font-family:var(--font-d);font-size:clamp(32px,5vw,60px);font-weight:700;\n  letter-spacing:-.03em;line-height:1.0;color:var(--cream-100);margin-bottom:18px;\n}\n.page-hero__sub {\n  font-family:var(--font-b);font-size:17px;color:var(--silver-300);\n  line-height:1.7;max-width:52ch;\n}\n\n/* STORY SECTION */\n.story {\n  display:grid;grid-template-columns:5fr 7fr;min-height:680px;\n  background:var(--bg-surface);border-bottom:1px solid var(--border-subtle);\n}\n.story__photo {\n  position:relative;background:var(--bg-card);min-height:500px;\n  display:flex;align-items:center;justify-content:center;overflow:hidden;\n}\n.story__photo-ph {\n  font-family:var(--font-d);font-size:10px;font-weight:600;\n  letter-spacing:.16em;text-transform:uppercase;color:rgba(138,155,176,.3);\n  text-align:center;padding:20px;\n}\n.story__photo-caption {\n  position:absolute;bottom:24px;left:24px;right:24px;\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;color:var(--gold-700);\n}\n.story__content {\n  padding:72px 64px;display:flex;flex-direction:column;justify-content:center;\n}\n.story__name {\n  font-family:var(--font-d);font-size:clamp(24px,2.5vw,32px);font-weight:700;\n  letter-spacing:-.02em;color:var(--text-primary);margin-bottom:4px;\n}\n.story__title {\n  font-family:var(--font-d);font-size:11px;font-weight:700;\n  letter-spacing:.2em;text-transform:uppercase;color:var(--gold-500);\n  margin-bottom:32px;\n}\n.story__body {\n  font-family:var(--font-b);font-size:16px;color:var(--text-secondary);\n  line-height:1.8;max-width:54ch;margin-bottom:20px;\n}\n.story__body:last-of-type { margin-bottom:0 }\n.story__divider {\n  width:40px;height:1px;background:var(--border-gold);margin:28px 0;\n}\n\n/* CREDENTIALS STRIP */\n.credentials {\n  display:grid;grid-template-columns:repeat(4,1fr);\n  background:var(--bg-page);border-bottom:1px solid var(--border-subtle);\n}\n.credential {\n  padding:40px 40px;border-right:1px solid var(--border-subtle);\n}\n.credential:last-child { border-right:none }\n.credential__num {\n  font-family:var(--font-d);font-size:40px;font-weight:700;\n  letter-spacing:-.02em;color:var(--gold-500);line-height:1;margin-bottom:8px;\n}\n.credential__label {\n  font-family:var(--font-b);font-size:13px;color:var(--text-secondary);\n  line-height:1.5;\n}\n\n/* PHILOSOPHY */\n.philosophy {\n  padding:96px 52px;background:var(--bg-surface);\n  border-bottom:1px solid var(--border-subtle);\n}\n.philosophy__header { margin-bottom:56px;max-width:640px }\n.philosophy__title {\n  font-family:var(--font-d);font-size:clamp(26px,3vw,38px);font-weight:700;\n  letter-spacing:-.02em;color:var(--text-primary);margin-bottom:14px;\n}\n.philosophy__sub {\n  font-family:var(--font-b);font-size:16px;color:var(--text-secondary);line-height:1.7;\n}\n.philosophy__grid { display:grid;grid-template-columns:repeat(2,1fr);gap:3px }\n.philosophy__item {\n  padding:40px 44px;background:var(--bg-elevated);\n  border:1px solid var(--border-subtle);\n}\n.philosophy__item:hover { border-color:var(--border-gold) }\n.philosophy__num {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.2em;text-transform:uppercase;color:var(--gold-700);\n  margin-bottom:16px;display:block;\n}\n.philosophy__item-title {\n  font-family:var(--font-d);font-size:22px;font-weight:700;\n  letter-spacing:-.01em;color:var(--text-primary);margin-bottom:12px;\n}\n.philosophy__item-body {\n  font-family:var(--font-b);font-size:14px;color:var(--text-secondary);\n  line-height:1.75;\n}\n\n/* LETTER */\n.letter {\n  padding:96px 52px;background:var(--bg-page);\n  border-bottom:1px solid var(--border-subtle);\n  display:grid;grid-template-columns:1fr 2fr;gap:80px;align-items:start;\n}\n.letter__aside {}\n.letter__aside-title {\n  font-family:var(--font-d);font-size:11px;font-weight:700;\n  letter-spacing:.2em;text-transform:uppercase;color:var(--gold-500);\n  margin-bottom:20px;display:block;\n}\n.letter__aside-logo { width:80px;height:80px;object-fit:contain;margin-bottom:20px;\n  filter:drop-shadow(0 4px 16px rgba(201,168,76,.2)) }\n.letter__aside-sig {\n  font-family:var(--font-d);font-size:28px;font-weight:300;\n  font-style:italic;color:var(--cream-100);line-height:1.2;\n}\n.letter__aside-sig strong { font-weight:700;font-style:normal }\n.letter__aside-role {\n  font-family:var(--font-b);font-size:12px;color:var(--silver-400);\n  margin-top:6px;\n}\n.letter__body {}\n.letter__opening {\n  font-family:var(--font-d);font-size:clamp(18px,2vw,22px);font-weight:400;\n  font-style:italic;letter-spacing:-.01em;color:var(--text-primary);\n  line-height:1.55;margin-bottom:28px;\n}\n.letter__para {\n  font-family:var(--font-b);font-size:16px;color:var(--text-secondary);\n  line-height:1.8;max-width:60ch;margin-bottom:20px;\n}\n.letter__close {\n  font-family:var(--font-d);font-size:16px;font-style:italic;\n  color:var(--text-primary);margin-top:32px;\n}\n.letter__name {\n  font-family:var(--font-d);font-size:13px;font-weight:700;\n  letter-spacing:.08em;color:var(--gold-400);margin-top:8px;\n}\n\n/* TESTIMONIAL PULL */\n.pull-quote {\n  padding:80px 52px;background:var(--navy-800);\n  border-bottom:1px solid var(--border-subtle);\n  display:flex;align-items:center;gap:48px;\n}\nbody.theme-light .pull-quote { background:var(--cream-100) }\n.pull-quote__mark {\n  font-family:var(--font-d);font-size:120px;font-weight:700;\n  color:var(--gold-500);opacity:.2;line-height:1;flex-shrink:0;margin-top:-24px;\n}\n.pull-quote__content {}\n.pull-quote__text {\n  font-family:var(--font-d);font-size:clamp(18px,2.2vw,26px);font-weight:400;\n  font-style:italic;color:var(--cream-100);line-height:1.55;margin-bottom:20px;\n}\nbody.theme-light .pull-quote__text { color:var(--navy-800) }\n.pull-quote__attr {\n  font-family:var(--font-d);font-size:11px;font-weight:700;\n  letter-spacing:.18em;text-transform:uppercase;color:var(--gold-500);\n}\n\n/* CTA SECTION */\n.about-cta {\n  padding:96px 52px;background:var(--bg-surface);\n  display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;\n}\n.about-cta__title {\n  font-family:var(--font-d);font-size:clamp(28px,3.5vw,44px);font-weight:700;\n  letter-spacing:-.02em;color:var(--text-primary);margin-bottom:16px;\n}\n.about-cta__body {\n  font-family:var(--font-b);font-size:16px;color:var(--text-secondary);\n  line-height:1.7;max-width:48ch;margin-bottom:32px;\n}\n.about-cta__details {\n  display:flex;flex-direction:column;gap:14px;\n}\n.about-cta__detail {\n  display:flex;align-items:flex-start;gap:16px;\n}\n.about-cta__detail-label {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.2em;text-transform:uppercase;color:var(--gold-500);\n  width:52px;flex-shrink:0;margin-top:2px;\n}\n.about-cta__detail-val {\n  font-family:var(--font-b);font-size:14px;color:var(--text-secondary);\n  line-height:1.5;\n}\n.about-cta__detail-val a {\n  color:var(--text-secondary);transition:color .15s;\n}\n.about-cta__detail-val a:hover { color:var(--gold-400) }\n.about-cta__cta {\n  display:inline-flex;align-items:center;gap:10px;margin-top:36px;\n  font-family:var(--font-d);font-size:11px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;\n  background:var(--gold-500);color:var(--navy-900);\n  padding:16px 36px;border:none;cursor:pointer;transition:all .15s;\n}\n.about-cta__cta:hover { background:var(--gold-400);box-shadow:0 0 32px rgba(201,168,76,.25) }\n.about-cta__license {\n  margin-top:20px;font-family:var(--font-b);font-size:11px;\n  color:var(--text-muted);line-height:1.6;\n}\n\n/* RESPONSIVE */\n@media (max-width:900px) {\n  .story { grid-template-columns:1fr }\n  .story__photo { min-height:340px }\n  .story__content { padding:48px 28px }\n  .credentials { grid-template-columns:repeat(2,minmax(0,1fr)) }\n  .credential { padding:32px 28px }\n  .credential { border-right:none;border-bottom:1px solid var(--border-subtle) }\n  .philosophy__grid { grid-template-columns:1fr }\n  .letter { grid-template-columns:1fr;gap:40px;padding:64px 28px }\n  .pull-quote { flex-direction:column;gap:0;padding:64px 28px }\n  .pull-quote__mark { font-size:72px;margin-top:0 }\n  .about-cta { grid-template-columns:1fr;gap:48px;padding:64px 28px }\n  .page-hero__content { padding:0 28px 56px }\n  .philosophy { padding:64px 28px }\n}\n";
---
<Base title="About Mark Sole — Hit Your Mark Travel" description="Mark Sole is the founder and Travel Director of Hit Your Mark Travel. A lifetime of experience, a global network, and someone who actually picks up the phone." active="about" pageCss={pageCss} schemaType="website">
  <Fragment set:html={Content} />
</Base>
