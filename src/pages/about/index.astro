---
import Base from "../../layouts/Base.astro";
import Content from "../../content-pages/about.html?raw";
import { breadcrumbs, person, webPage } from "../../lib/schema";

/* P2-3: the Person node lives here and only here — Articles reference it
   by @id. The visible pairing is already in the page copy: the photo, the
   Travel Leaders Network affiliation, and the three Seller of Travel
   numbers in the body.

   image points at the same crop the page displays (#87). It used to name
   the 1024x1536 PNG, which stopped being rendered when the story panel moved
   to a lazy JPEG — leaving the one image we hand Google as a 2.6 MB PNG that
   no visitor ever loaded. Keep these two in step: if the story photo
   changes, this changes with it. */
const SITE = (Astro.site?.href ?? "https://www.hymtravel.com/").replace(/\/$/, "");
const description =
  "Mark Sole is the founder and Travel Director of Hit Your Mark Travel. A lifetime of experience, a global network, and someone who actually picks up the phone.";
const schema = [
  person(SITE, {
    sameAs: ["https://www.instagram.com/travelwithsoleman/"],
    image: "/assets/img/sp-mark-sole-portrait.jpg",
  }),
  webPage(SITE, { type: "AboutPage", name: "About Mark Sole", description, path: "/about/" }),
  breadcrumbs(SITE, [{ name: "Home", path: "/" }, { name: "About" }]),
];
const pageCss = "\n/* \u2500\u2500 ABOUT PAGE EXTRAS \u2500\u2500 */\n\n/* PAGE HERO */\n.page-hero {\n  position:relative;min-height:42vh;margin-top:76px;\n  background:var(--navy-800);display:flex;align-items:flex-end;\n  overflow:hidden;\n}\n.page-hero__bg {\n  position:absolute;inset:0;background:var(--navy-800);\n  display:flex;align-items:center;justify-content:center;\n}\n.page-hero__watermark {\n  position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);\n  width:min(320px,42vw);height:min(320px,42vw);object-fit:contain;\n  opacity:.04;pointer-events:none;\n}\n.page-hero__overlay {\n  position:absolute;inset:0;\n  background:linear-gradient(180deg,rgba(8,15,26,0) 0%,rgba(8,15,26,.6) 60%,rgba(8,15,26,.95) 100%);\n}\n.page-hero__content {\n  position:relative;z-index:1;width:100%;\n  padding:0 52px 72px;max-width:800px;\n}\n.page-hero__eyebrow { margin-bottom:16px }\n.page-hero__headline {\n  font-family:var(--font-d);font-size:clamp(32px,5vw,60px);font-weight:700;\n  letter-spacing:-.03em;line-height:1.0;color:var(--cream-100);margin-bottom:18px;\n}\n.page-hero__sub {\n  font-family:var(--font-b);font-size:17px;color:var(--silver-300);\n  line-height:1.7;max-width:52ch;\n}\n\n/* STORY SECTION */\n.story {\n  display:grid;grid-template-columns:5fr 7fr;min-height:680px;\n  background:var(--bg-surface);border-bottom:1px solid var(--border-subtle);\n}\n.story__photo {\n  position:relative;background:var(--bg-card);min-height:500px;\n  display:flex;align-items:center;justify-content:center;overflow:hidden;\n}\n/* The copy column runs ~1040px tall. Stretching the panel to match forced\n   object-fit:cover to crop ~39% of the portrait's width away, which read as\n   a tight zoom on Mark. Hold the panel at the source ratio (900x1086) so\n   nothing is cropped, and stick it under the 76px nav so the shorter panel\n   travels with the reader instead of leaving a dead band beneath it.\n   Scoped above the 900px breakpoint: below it the panel is a wide band\n   whose crop is already tuned by object-position. */\n@media (min-width:901px) {\n  .story__photo {\n    align-self:start;aspect-ratio:900/1086;\n    position:sticky;top:76px;\n  }\n}\n/* #87: was a 2.6 MB PNG background-image; now a lazy JPEG the panel can defer. */\n.story__photo-img {\n  position:absolute;inset:0;width:100%;height:100%;object-fit:cover;\n}\n.story__photo-ph {\n  font-family:var(--font-d);font-size:10px;font-weight:600;\n  letter-spacing:.16em;text-transform:uppercase;color:rgba(138,155,176,.3);\n  text-align:center;padding:20px;\n}\n.story__photo::after {\n  content:'';position:absolute;left:0;right:0;bottom:0;height:150px;\n  background:linear-gradient(180deg,rgba(8,15,26,0),rgba(8,15,26,.8));\n  pointer-events:none;\n}\n.story__photo-caption {\n  position:absolute;z-index:1;bottom:24px;left:24px;right:24px;\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;color:var(--gold-700);\n}\n.story__content {\n  padding:72px 64px;display:flex;flex-direction:column;justify-content:center;\n}\n.story__name {\n  font-family:var(--font-d);font-size:clamp(24px,2.5vw,32px);font-weight:700;\n  letter-spacing:-.02em;color:var(--text-primary);margin-bottom:4px;\n}\n.story__title {\n  font-family:var(--font-d);font-size:11px;font-weight:700;\n  letter-spacing:.2em;text-transform:uppercase;color:var(--gold-500);\n  margin-bottom:32px;\n}\n.story__body {\n  font-family:var(--font-b);font-size:16px;color:var(--text-secondary);\n  line-height:1.8;max-width:54ch;margin-bottom:20px;\n}\n.story__body:last-of-type { margin-bottom:0 }\n.story__divider {\n  width:40px;height:1px;background:var(--border-gold);margin:28px 0;\n}\n\n/* CREDENTIALS STRIP */\n.credentials {\n  display:grid;grid-template-columns:repeat(4,1fr);\n  background:var(--bg-page);border-bottom:1px solid var(--border-subtle);\n}\n.credential {\n  padding:40px 40px;border-right:1px solid var(--border-subtle);\n}\n.credential:last-child { border-right:none }\n.credential__num {\n  font-family:var(--font-d);font-size:40px;font-weight:700;\n  letter-spacing:-.02em;color:var(--gold-500);line-height:1;margin-bottom:8px;\n}\n.credential__label {\n  font-family:var(--font-b);font-size:13px;color:var(--text-secondary);\n  line-height:1.5;\n}\n\n/* PHILOSOPHY */\n.philosophy {\n  padding:96px 52px;background:var(--bg-surface);\n  border-bottom:1px solid var(--border-subtle);\n}\n.philosophy__header { margin-bottom:56px;max-width:640px }\n.philosophy__title {\n  font-family:var(--font-d);font-size:clamp(26px,3vw,38px);font-weight:700;\n  letter-spacing:-.02em;color:var(--text-primary);margin-bottom:14px;\n}\n.philosophy__sub {\n  font-family:var(--font-b);font-size:16px;color:var(--text-secondary);line-height:1.7;\n}\n.philosophy__grid { display:grid;grid-template-columns:repeat(2,1fr);gap:3px }\n.philosophy__item {\n  padding:40px 44px;background:var(--bg-elevated);\n  border:1px solid var(--border-subtle);\n}\n.philosophy__item:hover { border-color:var(--border-gold) }\n.philosophy__num {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.2em;text-transform:uppercase;color:var(--gold-700);\n  margin-bottom:16px;display:block;\n}\n.philosophy__item-title {\n  font-family:var(--font-d);font-size:22px;font-weight:700;\n  letter-spacing:-.01em;color:var(--text-primary);margin-bottom:12px;\n}\n.philosophy__item-body {\n  font-family:var(--font-b);font-size:14px;color:var(--text-secondary);\n  line-height:1.75;\n}\n\n/* LETTER */\n.letter {\n  padding:96px 52px;background:var(--bg-page);\n  border-bottom:1px solid var(--border-subtle);\n  display:grid;grid-template-columns:1fr 2fr;gap:80px;align-items:start;\n}\n.letter__aside {}\n.letter__aside-title {\n  font-family:var(--font-d);font-size:11px;font-weight:700;\n  letter-spacing:.2em;text-transform:uppercase;color:var(--gold-500);\n  margin-bottom:20px;display:block;\n}\n.letter__aside-logo { width:80px;height:80px;object-fit:contain;margin-bottom:20px;\n  filter:drop-shadow(0 4px 16px rgba(201,168,76,.2)) }\n.letter__aside-sig {\n  font-family:var(--font-d);font-size:28px;font-weight:300;\n  font-style:italic;color:var(--cream-100);line-height:1.2;\n}\n.letter__aside-sig strong { font-weight:700;font-style:normal }\n.letter__aside-role {\n  font-family:var(--font-b);font-size:12px;color:var(--silver-400);\n  margin-top:6px;\n}\n.letter__body {}\n.letter__opening {\n  font-family:var(--font-d);font-size:clamp(18px,2vw,22px);font-weight:400;\n  font-style:italic;letter-spacing:-.01em;color:var(--text-primary);\n  line-height:1.55;margin-bottom:28px;\n}\n.letter__para {\n  font-family:var(--font-b);font-size:16px;color:var(--text-secondary);\n  line-height:1.8;max-width:60ch;margin-bottom:20px;\n}\n.letter__close {\n  font-family:var(--font-d);font-size:16px;font-style:italic;\n  color:var(--text-primary);margin-top:32px;\n}\n.letter__name {\n  font-family:var(--font-d);font-size:13px;font-weight:700;\n  letter-spacing:.08em;color:var(--gold-400);margin-top:8px;\n}\n\n/* TESTIMONIAL PULL */\n.pull-quote {\n  padding:80px 52px;background:var(--navy-800);\n  border-bottom:1px solid var(--border-subtle);\n  display:flex;align-items:center;gap:48px;\n}\nbody.theme-light .pull-quote { background:var(--cream-100) }\n.pull-quote__mark {\n  font-family:var(--font-d);font-size:120px;font-weight:700;\n  color:var(--gold-500);opacity:.2;line-height:1;flex-shrink:0;margin-top:-24px;\n}\n.pull-quote__content {}\n.pull-quote__text {\n  font-family:var(--font-d);font-size:clamp(18px,2.2vw,26px);font-weight:400;\n  font-style:italic;color:var(--cream-100);line-height:1.55;margin-bottom:20px;\n}\nbody.theme-light .pull-quote__text { color:var(--navy-800) }\n.pull-quote__attr {\n  font-family:var(--font-d);font-size:11px;font-weight:700;\n  letter-spacing:.18em;text-transform:uppercase;color:var(--gold-500);\n}\n\n/* CTA SECTION */\n.about-cta {\n  padding:96px 52px;background:var(--bg-surface);\n  display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;\n}\n.about-cta__title {\n  font-family:var(--font-d);font-size:clamp(28px,3.5vw,44px);font-weight:700;\n  letter-spacing:-.02em;color:var(--text-primary);margin-bottom:16px;\n}\n.about-cta__body {\n  font-family:var(--font-b);font-size:16px;color:var(--text-secondary);\n  line-height:1.7;max-width:48ch;margin-bottom:32px;\n}\n.about-cta__details {\n  display:flex;flex-direction:column;gap:14px;\n}\n.about-cta__detail {\n  display:flex;align-items:flex-start;gap:16px;\n}\n.about-cta__detail-label {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.2em;text-transform:uppercase;color:var(--gold-500);\n  width:52px;flex-shrink:0;margin-top:2px;\n}\n.about-cta__detail-val {\n  font-family:var(--font-b);font-size:14px;color:var(--text-secondary);\n  line-height:1.5;\n}\n.about-cta__detail-val a {\n  color:var(--text-secondary);transition:color .15s;\n}\n.about-cta__detail-val a:hover { color:var(--gold-400) }\n.about-cta__cta {\n  display:inline-flex;align-items:center;gap:10px;margin-top:36px;\n  font-family:var(--font-d);font-size:11px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;\n  background:var(--gold-500);color:var(--navy-900);\n  padding:16px 36px;border:none;cursor:pointer;transition:all .15s;\n}\n.about-cta__cta:hover { background:var(--gold-400);box-shadow:0 0 32px rgba(201,168,76,.25) }\n.about-cta__license {\n  margin-top:20px;font-family:var(--font-b);font-size:11px;\n  color:var(--text-muted);line-height:1.6;\n}\n\n/* RESPONSIVE */\n@media (max-width:900px) {\n  .story { grid-template-columns:1fr }\n  .story__photo { min-height:340px }\n  /* The panel collapses to a wide band here. A centred cover-crop of a\n     portrait lands on Mark's beard and hands, so bias it toward his face. */\n  .story__photo-img { object-position:center 10% }\n  .story__content { padding:48px 28px }\n  .credentials { grid-template-columns:repeat(2,minmax(0,1fr)) }\n  .credential { padding:32px 28px }\n  .credential { border-right:none;border-bottom:1px solid var(--border-subtle) }\n  .philosophy__grid { grid-template-columns:1fr }\n  .letter { grid-template-columns:1fr;gap:40px;padding:64px 28px }\n  .pull-quote { flex-direction:column;gap:0;padding:64px 28px }\n  .pull-quote__mark { font-size:72px;margin-top:0 }\n  .about-cta { grid-template-columns:1fr;gap:48px;padding:64px 28px }\n  .page-hero__content { padding:0 28px 56px }\n  .philosophy { padding:64px 28px }\n}\n";
---
<Base title="About Mark Sole — Hit Your Mark Travel" description={description} active="about" pageCss={pageCss} schemaType="website" schema={schema}>
  <Fragment set:html={Content} />
</Base>
