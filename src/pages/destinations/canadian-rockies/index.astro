---
import DestinationLayout from "../../../layouts/DestinationLayout.astro";
import Content from "../../../content-pages/destinations__canadian-rockies.html?raw";
---
<DestinationLayout
  title="Canadian Rockies | Banff, Lake Louise & Jasper — Hit Your Mark Travel"
  description="Banff and Jasper timed right — dawn at Moraine Lake, the Icefields Parkway, larch season's golden window, and the great railway hotels."
  name={"Canadian Rockies"}
  region={{ label: "North America", href: "/destinations/north-america/" }}
  hero={{
    image: "/assets/img/e-22-heli-ski-landing.jpg",
    eyebrow: "Western Canada",
    headline: "The Alps Without<br>the Crowds",
    sub: "Banff, Lake Louise, and Jasper deliver mountain scenery on a scale that rivals Switzerland — turquoise lakes, hanging glaciers, and wildlife that walks through town — with a fraction of the European crowds and none of the jet lag for North Americans.",
    ctaPrimary: { label: "Plan a Canadian Rockies Trip", href: "/plan-your-trip/" },
    ctaSecondary: { label: "Explore Canadian Rockies ↓", href: "#places" },
    // Best For and Flight Time still need Mark: fill docs/hero-stat-rail-worksheet.csv.
    // Format follows destinations/maldives: value: "Honeymoons<br>&amp; Couples" and
    // value: "~10h from NYC<br>~9h from LHR". Do not estimate flight times.
    stats: [
      { label: "Best Season", value: "Mid-June – Early September" },
    ],
  }}
>
  <Fragment set:html={Content} />
</DestinationLayout>
