---
import DestinationLayout from "../../../layouts/DestinationLayout.astro";
import Content from "../../../content-pages/destinations__france.html?raw";
---
<DestinationLayout
  title="France — Hit Your Mark Travel"
  description="Paris, Provence, Bordeaux, the Loire Valley, Alsace, and Normandy. French travel planned around the food specialists, property selections, and the depth that converts a visit into an understanding."
  schemaType="website"
  name={"France"}
  region={{ label: "Europe", href: "/destinations/europe/" }}
  hero={{
    image: "/assets/img/dh-05-france-provence-dusk.jpg",
    eyebrow: "Western Europe",
    headline: "The Original<br>Standard.",
    sub: "France invented the standards that the rest of the world's gastronomy, wine, hospitality, fashion, and garden design are still measured against. The country is broad enough that no two regions feel like the same country — Brittany's coast, the Provence light, Alsace's wine route, the Loire châteaux, the Champagne hills. The work of planning France is choosing which version of it you want, then making the choices that produce it.",
    ctaPrimary: { label: "Plan a France Trip", href: "/plan-your-trip/" },
    ctaSecondary: { label: "Explore France ↓", href: "#places" },
    // Best For and Flight Time still need Mark: fill docs/hero-stat-rail-worksheet.csv.
    // Format follows destinations/maldives: value: "Honeymoons<br>&amp; Couples" and
    // value: "~10h from NYC<br>~9h from LHR". Do not estimate flight times.
    stats: [
      { label: "Best Season", value: "May – June" },
    ],
  }}
>
  <Fragment set:html={Content} />
</DestinationLayout>
