---
import Base from "../../../layouts/Base.astro";
import Content from "../../../content-pages/destinations__north-america.html?raw";
const pageCss = "\n/* \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n   REGIONAL DESTINATION PAGE TEMPLATE\n   Swap: all content text, hero bg-ph, image labels,\n   destination cards, itinerary cards, season copy,\n   testimonial, mark's note, footer highlight.\n   Structure, classes, and CSS are identical across\n   all regional pages \u2014 do not modify.\n   \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 */\n\n.breadcrumb {\n  background:var(--bg-surface);border-bottom:1px solid var(--border-subtle);\n  padding:14px 52px;margin-top:76px;\n}\n.breadcrumb__inner {\n  display:flex;align-items:center;gap:10px;\n  font-family:var(--font-d);font-size:10px;font-weight:600;\n  letter-spacing:.12em;text-transform:uppercase;\n}\n.breadcrumb__link { color:var(--text-muted);text-decoration:none;transition:color .15s }\n.breadcrumb__link:hover { color:var(--gold-400) }\n.breadcrumb__sep { color:var(--text-muted);font-size:10px }\n.breadcrumb__current { color:var(--gold-500) }\n\n/* \u2500\u2500 HERO \u2500\u2500 */\n.dest-hero {\n  position:relative;min-height:72vh;\n  background:var(--navy-800);display:flex;align-items:center;justify-content:center;\n  overflow:hidden;text-align:center;\n}\n.dest-hero__bg {\n  position:absolute;inset:0;background:var(--navy-800);\n  display:flex;align-items:center;justify-content:center;\n}\n.dest-hero__bg-ph {\n  font-family:var(--font-d);font-size:10px;font-weight:600;\n  letter-spacing:.18em;text-transform:uppercase;color:rgba(138,155,176,.2);\n}\n.dest-hero__watermark {\n  position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);\n  width:min(500px,62vw);height:min(500px,62vw);object-fit:contain;\n  opacity:.04;pointer-events:none;\n}\n.dest-hero__overlay {\n  position:absolute;inset:0;\n  background:linear-gradient(180deg,rgba(8,15,26,.1) 0%,rgba(8,15,26,.4) 40%,rgba(8,15,26,.9) 100%);\n}\n.dest-hero__content {\n  position:relative;z-index:1;padding:0 52px;max-width:800px;\n}\n.dest-hero__headline {\n  font-family:var(--font-d);font-size:clamp(36px,6vw,72px);font-weight:700;\n  letter-spacing:-.03em;line-height:1.0;color:var(--cream-100);margin-bottom:20px;margin-top:14px;\n}\n.dest-hero__sub {\n  font-family:var(--font-b);font-size:17px;color:var(--silver-300);\n  line-height:1.75;max-width:54ch;margin:0 auto 36px;\n}\n.dest-hero__ctas { display:flex;gap:16px;justify-content:center;flex-wrap:wrap }\n\n/* \u2500\u2500 BUTTONS \u2500\u2500 */\n.btn-primary-gold {\n  display:inline-flex;align-items:center;gap:8px;\n  font-family:var(--font-d);font-size:11px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;\n  background:var(--gold-500);color:var(--navy-900);\n  padding:16px 36px;border:none;cursor:pointer;transition:all .15s;text-decoration:none;\n}\n.btn-primary-gold:hover { background:var(--gold-400);box-shadow:0 0 32px rgba(201,168,76,.25) }\n.btn-ghost-gold {\n  display:inline-flex;align-items:center;gap:8px;\n  font-family:var(--font-d);font-size:11px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;\n  background:transparent;color:var(--cream-100);\n  padding:15px 32px;border:1px solid rgba(255,255,255,.25);\n  cursor:pointer;transition:all .15s;text-decoration:none;\n}\n.btn-ghost-gold:hover { border-color:var(--gold-500);color:var(--gold-400) }\n\n/* \u2500\u2500 INTRO \u2500\u2500 */\n.intro-section {\n  display:grid;grid-template-columns:1fr 1fr;\n  background:var(--bg-surface);border-bottom:1px solid var(--border-subtle);\n}\n.intro-content { padding:72px 64px }\n.intro-title {\n  font-family:var(--font-d);font-size:clamp(24px,3vw,36px);font-weight:700;\n  letter-spacing:-.02em;color:var(--text-primary);margin-bottom:24px;\n}\n.intro-body {\n  font-family:var(--font-b);font-size:15px;color:var(--text-secondary);\n  line-height:1.8;margin-bottom:18px;\n}\n.intro-image {\n  background:var(--bg-card);position:relative;\n  display:flex;align-items:center;justify-content:center;min-height:480px;\n  font-family:var(--font-d);font-size:10px;font-weight:600;\n  letter-spacing:.16em;text-transform:uppercase;color:rgba(138,155,176,.25);\n}\n.intro-image-label {\n  position:absolute;bottom:20px;left:24px;\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.18em;text-transform:uppercase;color:var(--gold-700);\n}\n\n/* \u2500\u2500 DESTINATIONS GRID \u2500\u2500 */\n.places-section { padding:72px 52px;background:var(--bg-page) }\n.places-grid {\n  display:grid;grid-template-columns:repeat(3,1fr);grid-auto-rows:280px;gap:3px;\n}\n.place-card {\n  position:relative;overflow:hidden;cursor:pointer;background:var(--bg-card);\n  display:flex;flex-direction:column;justify-content:flex-end;\n  text-decoration:none;\n}\n.place-card--featured { grid-column:span 2 }\n.place-card__ph {\n  position:absolute;inset:0;display:flex;align-items:center;justify-content:center;\n  font-family:var(--font-d);font-size:10px;font-weight:600;\n  letter-spacing:.14em;text-transform:uppercase;color:rgba(138,155,176,.25);\n  transition:transform .5s cubic-bezier(.16,1,.3,1);\n}\n.place-card:hover .place-card__ph { transform:scale(1.04) }\n.place-card__overlay {\n  position:absolute;inset:0;\n  background:linear-gradient(0deg,rgba(8,15,26,.92) 0%,rgba(8,15,26,.2) 50%,transparent 100%);\n  transition:opacity .3s;\n}\n.place-card:hover .place-card__overlay { opacity:.7 }\n.place-card__body {\n  position:relative;z-index:1;padding:24px;\n  border-top:1px solid transparent;transition:border-color .3s;\n}\n.place-card:hover .place-card__body { border-color:rgba(201,168,76,.35) }\n.place-card__region {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.22em;text-transform:uppercase;color:var(--gold-500);margin-bottom:6px;\n}\n.place-card__name {\n  font-family:var(--font-d);font-size:22px;font-weight:700;color:var(--cream-100);margin-bottom:8px;\n}\n.place-card--featured .place-card__name { font-size:30px }\n.place-card__desc {\n  font-family:var(--font-b);font-size:13px;color:var(--silver-300);\n  line-height:1.55;margin-bottom:12px;\n}\n.place-card__tags { display:flex;gap:6px;flex-wrap:wrap }\n.place-tag {\n  font-family:var(--font-d);font-size:8px;font-weight:700;\n  letter-spacing:.14em;text-transform:uppercase;\n  padding:3px 8px;background:rgba(201,168,76,.12);\n  border:1px solid rgba(201,168,76,.25);color:var(--gold-400);\n}\n.place-card__arrow {\n  position:absolute;bottom:24px;right:24px;z-index:2;\n  font-family:var(--font-d);font-size:10px;font-weight:700;\n  letter-spacing:.14em;text-transform:uppercase;\n  color:var(--gold-500);opacity:0;transition:opacity .2s;\n}\n.place-card:hover .place-card__arrow { opacity:1 }\n\n/* \u2500\u2500 ITINERARIES GRID \u2500\u2500 */\n.itineraries-section {\n  padding:72px 52px;background:var(--bg-surface);\n  border-top:1px solid var(--border-subtle);border-bottom:1px solid var(--border-subtle);\n}\n.itineraries-grid { display:grid;grid-template-columns:1fr 1fr;gap:3px }\n.itin-card {\n  display:grid;grid-template-columns:1fr 1fr;\n  background:var(--bg-elevated);border:1px solid var(--border-subtle);\n  overflow:hidden;transition:border-color .2s;\n}\n.itin-card:hover { border-color:var(--border-gold) }\n.itin-image {\n  min-height:260px;background:var(--bg-card);\n  display:flex;align-items:center;justify-content:center;\n  font-family:var(--font-d);font-size:9px;font-weight:600;\n  letter-spacing:.14em;text-transform:uppercase;color:rgba(138,155,176,.25);\n  padding:16px;text-align:center;\n}\n.itin-body {\n  padding:32px 28px;display:flex;flex-direction:column;justify-content:center;\n}\n.itin-duration {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.2em;text-transform:uppercase;color:var(--gold-500);margin-bottom:8px;\n}\n.itin-name {\n  font-family:var(--font-d);font-size:18px;font-weight:700;\n  letter-spacing:-.01em;color:var(--text-primary);line-height:1.2;margin-bottom:10px;\n}\n.itin-desc {\n  font-family:var(--font-b);font-size:13px;color:var(--text-secondary);\n  line-height:1.65;margin-bottom:14px;\n}\n.itin-meta {\n  display:flex;gap:16px;margin-bottom:14px;\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.12em;text-transform:uppercase;color:var(--text-muted);\n}\n.itin-cta {\n  font-family:var(--font-d);font-size:10px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;color:var(--gold-500);\n  display:inline-flex;align-items:center;gap:6px;\n  background:none;border:none;cursor:pointer;padding:0;transition:gap .15s;\n}\n.itin-cta:hover { gap:12px }\n.itin-cta::after { content:'\u2192' }\n\n/* \u2500\u2500 WHY PLAN WITH US \u2500\u2500 */\n.why-section {\n  padding:72px 52px;background:var(--bg-page);\n  border-bottom:1px solid var(--border-subtle);\n}\n.why-grid { display:grid;grid-template-columns:repeat(4,1fr);gap:3px }\n.why-item {\n  background:var(--bg-elevated);border:1px solid var(--border-subtle);\n  padding:32px 28px;transition:border-color .2s;\n}\n.why-item:hover { border-color:var(--border-gold) }\n.why-icon {\n  width:44px;height:44px;border:1px solid var(--border-gold);\n  display:flex;align-items:center;justify-content:center;\n  margin-bottom:20px;color:var(--gold-500);font-size:18px;\n}\n.why-title {\n  font-family:var(--font-d);font-size:14px;font-weight:700;\n  color:var(--text-primary);margin-bottom:8px;\n}\n.why-desc {\n  font-family:var(--font-b);font-size:13px;color:var(--text-secondary);line-height:1.6;\n}\n\n/* \u2500\u2500 SEASONS \u2500\u2500 */\n.seasons-strip {\n  background:var(--bg-surface);border-bottom:1px solid var(--border-subtle);\n  padding:64px 52px;\n}\n.seasons-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:3px }\n.season-item {\n  padding:28px 28px;border:1px solid var(--border-subtle);\n  background:var(--bg-elevated);\n}\n.season-item--best { border-color:var(--border-gold);background:var(--accent-subtle) }\n.season-name {\n  font-family:var(--font-d);font-size:10px;font-weight:700;\n  letter-spacing:.2em;text-transform:uppercase;color:var(--text-secondary);margin-bottom:8px;\n}\n.season-item--best .season-name { color:var(--gold-500) }\n.season-months {\n  font-family:var(--font-d);font-size:18px;font-weight:600;\n  color:var(--text-primary);margin-bottom:10px;\n}\n.season-desc {\n  font-family:var(--font-b);font-size:13px;color:var(--text-muted);line-height:1.6;\n}\n.season-badge {\n  display:inline-block;margin-top:10px;\n  font-family:var(--font-d);font-size:8px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;\n  padding:4px 10px;background:var(--gold-500);color:var(--navy-900);\n}\n\n/* \u2500\u2500 TESTIMONIAL \u2500\u2500 */\n.testimonial-section {\n  padding:80px 52px;background:var(--navy-800);\n  border-bottom:1px solid var(--border-subtle);text-align:center;\n}\n.testimonial-mark {\n  font-family:var(--font-d);font-size:80px;font-weight:700;\n  color:var(--gold-500);opacity:.2;line-height:1;margin-bottom:-20px;\n}\n.testimonial-quote {\n  font-family:var(--font-d);font-size:clamp(16px,2.2vw,22px);font-weight:400;\n  font-style:italic;color:var(--cream-100);line-height:1.65;\n  max-width:780px;margin:0 auto 24px;\n}\n.testimonial-attr {\n  font-family:var(--font-d);font-size:11px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;color:var(--gold-500);\n}\n\n/* \u2500\u2500 MARK'S NOTE \u2500\u2500 */\n.mark-note {\n  padding:72px 52px;background:var(--bg-surface);\n  border-bottom:1px solid var(--border-subtle);\n}\n.mark-note__grid {\n  display:grid;grid-template-columns:auto 1fr;gap:48px;\n  max-width:840px;margin:0 auto;align-items:start;\n}\n.mark-note__photo {\n  width:96px;height:96px;object-fit:contain;\n  filter:drop-shadow(0 4px 16px rgba(201,168,76,.2));flex-shrink:0;\n}\n.mark-note__name {\n  font-family:var(--font-d);font-size:16px;font-weight:700;\n  color:var(--gold-500);margin-bottom:2px;\n}\n.mark-note__title {\n  font-family:var(--font-b);font-size:12px;color:var(--text-muted);\n  letter-spacing:.04em;margin-bottom:20px;\n}\n.mark-note__quote {\n  font-family:var(--font-b);font-size:15px;color:var(--text-secondary);\n  line-height:1.8;font-style:italic;\n}\n\n/* \u2500\u2500 FINAL CTA \u2500\u2500 */\n.dest-cta {\n  padding:96px 52px;background:var(--bg-page);text-align:center;\n  border-bottom:1px solid var(--border-subtle);\n}\n.dest-cta__title {\n  font-family:var(--font-d);font-size:clamp(28px,3.5vw,44px);font-weight:700;\n  letter-spacing:-.02em;color:var(--text-primary);margin-bottom:16px;\n}\n.dest-cta__body {\n  font-family:var(--font-b);font-size:16px;color:var(--text-secondary);\n  line-height:1.7;max-width:52ch;margin:0 auto 36px;\n}\n.dest-cta__note {\n  font-family:var(--font-b);font-size:12px;color:var(--text-muted);\n  margin-top:16px;letter-spacing:.04em;\n}\n\n/* \u2500\u2500 RESPONSIVE \u2500\u2500 */\n@media(max-width:900px){\n  .breadcrumb { padding:12px 28px }\n  .intro-section { grid-template-columns:1fr }\n  .intro-content { padding:48px 28px }\n  .intro-image { min-height:280px;aspect-ratio:16/9 }\n  .places-grid { grid-template-columns:1fr 1fr }\n  .place-card--featured { grid-column:span 2 }\n  .itineraries-grid { grid-template-columns:1fr }\n  .itin-card { grid-template-columns:1fr }\n  .itin-image { min-height:180px }\n  .why-grid { grid-template-columns:repeat(2,1fr) }\n  .seasons-grid { grid-template-columns:1fr }\n  .mark-note__grid { grid-template-columns:1fr;text-align:center }\n  .mark-note__photo { margin:0 auto }\n  .places-section,.itineraries-section,.why-section,.seasons-strip,.testimonial-section,.mark-note,.dest-cta { padding-left:28px;padding-right:28px }\n  .dest-hero__content { padding:0 28px }\n}\n@media(max-width:540px){\n  .places-grid { grid-template-columns:1fr;grid-auto-rows:240px }\n  .place-card--featured { grid-column:span 1 }\n  .why-grid { grid-template-columns:1fr }\n}\n\n/* \u2500\u2500 PAGE FAQ \u2500\u2500 */\n.page-faq{padding:80px 52px;background:var(--bg-surface);border-top:1px solid var(--border-subtle);border-bottom:1px solid var(--border-subtle)}\n.page-faq__header{max-width:640px;margin-bottom:48px}\n.page-faq__label{font-family:var(--font-d);font-size:10px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--gold-500);margin-bottom:12px}\n.page-faq__title{font-family:var(--font-d);font-size:clamp(24px,3vw,36px);font-weight:700;letter-spacing:-.02em;color:var(--text-primary);margin-bottom:16px}\n.page-faq__sub{font-family:var(--font-b);font-size:15px;color:var(--text-secondary);line-height:1.7}\n.pf-grid{display:grid;grid-template-columns:1fr 1fr;gap:3px}\n.pf-item{background:var(--bg-elevated);border:1px solid var(--border-subtle);transition:border-color .2s}\n.pf-item.open{border-color:var(--border-gold)}\n.pf-q{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;padding:24px 28px;cursor:pointer}\n.pf-q__text{font-family:var(--font-d);font-size:14px;font-weight:700;color:var(--text-primary);line-height:1.35}\n.pf-q__icon{width:28px;height:28px;flex-shrink:0;border:1px solid var(--border-subtle);display:flex;align-items:center;justify-content:center;color:var(--gold-500);font-size:18px;line-height:1;transition:transform .2s,border-color .2s;margin-top:2px}\n.pf-item.open .pf-q__icon{transform:rotate(45deg);border-color:var(--border-gold)}\n.pf-a{display:none;padding:0 28px 24px;font-family:var(--font-b);font-size:14px;color:var(--text-secondary);line-height:1.75}\n.pf-item.open .pf-a{display:block}\n.page-faq__more{margin-top:36px;display:flex;align-items:center;gap:12px}\n.page-faq__more-link{font-family:var(--font-d);font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--gold-500);text-decoration:none;display:inline-flex;align-items:center;gap:6px;transition:gap .15s}\n.page-faq__more-link:hover{gap:10px}\n.page-faq__more-link::after{content:'\u2192'}\n@media(max-width:768px){.pf-grid{grid-template-columns:1fr}.page-faq{padding:64px 28px}}\n";
---
<Base title="North America — Hit Your Mark Travel" description="Napa & Sonoma, Hawaii, Alaska, New York, the Canadian Rockies, and New Orleans. North American travel planned around the specific places, properties, and experiences that actually deliver — not the ones that photograph well." active="destinations" pageCss={pageCss} schemaType="website">
  <Fragment set:html={Content} />
</Base>
