---
import DestinationLayout from "../../../layouts/DestinationLayout.astro";
import Content from "../../../content-pages/destinations__south-america.html?raw";
---
<DestinationLayout
  title="South America — Hit Your Mark Travel"
  description="Patagonia, Peru, the Galápagos, Brazil, Colombia and Argentina — planned around the landscapes, lodges and windows that deliver the continent."
  schemaType="website"
  name={"South America"}
  hero={{
    image: "/assets/img/dh-22-south-america-andes-lake.jpg",
    eyebrow: "South America",
    headline: "The Continent Most<br>Travelers Underbook.",
    sub: "Patagonia contains some of the most dramatic mountain and glacier landscape on earth. Peru's Sacred Valley rivals any archaeological site in the world. The Galápagos Islands offer wildlife encounters with a proximity and fearlessness that no other place replicates. Argentina's wine country sits in the shadow of the Andes. South America is a continent that consistently overdelivers for travelers who arrive knowing what to plan around.",
    ctaPrimary: { label: "Plan a South America Trip", href: "/plan-your-trip/" },
    ctaSecondary: { label: "Explore Destinations ↓", href: "#places" },
    // Best For and Flight Time still need Mark: fill docs/hero-stat-rail-worksheet.csv.
    // Format follows destinations/maldives: value: "Honeymoons<br>&amp; Couples" and
    // value: "~10h from NYC<br>~9h from LHR". Do not estimate flight times.
    stats: [
      { label: "Best Season", value: "October – April" },
    ],
  }}
>
  <Fragment set:html={Content} />
</DestinationLayout>
