---
import DestinationLayout from "../../../layouts/DestinationLayout.astro";
import Content from "../../../content-pages/destinations__africa.html?raw";
---
<DestinationLayout
  title="Africa — Hit Your Mark Travel"
  description="Kenya, Tanzania, Botswana, South Africa, Rwanda, and Morocco. African travel planned around the camps, guides, and windows that actually deliver the continent at its most extraordinary."
  schemaType="website"
  name={"Africa"}
  hero={{
    image: "/assets/img/x-01-serengeti-elephants.jpg",
    eyebrow: "Africa",
    headline: "Nothing Else<br>Comes Close.",
    sub: "Every traveler who has been on a genuine African safari says the same thing: nothing they had read or seen prepared them for what it actually was. The scale of the landscape. The proximity of the animals. The silence at dawn. Africa is a region where the planning work — camp selection, guide quality, timing — is the difference between a good experience and one that resets how you understand what travel can be.",
    ctaPrimary: { label: "Plan an Africa Trip", href: "/plan-your-trip/" },
    ctaSecondary: { label: "Explore Destinations ↓", href: "#places" },
    // Best For and Flight Time still need Mark: fill docs/hero-stat-rail-worksheet.csv.
    // Format follows destinations/maldives: value: "Honeymoons<br>&amp; Couples" and
    // value: "~10h from NYC<br>~9h from LHR". Do not estimate flight times.
    stats: [
      { label: "Best Season", value: "July – October" },
    ],
  }}
>
  <Fragment set:html={Content} />
</DestinationLayout>
