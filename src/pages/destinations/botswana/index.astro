---
import DestinationLayout from "../../../layouts/DestinationLayout.astro";
import Content from "../../../content-pages/destinations__botswana.html?raw";
---
<DestinationLayout
  title="Botswana — Hit Your Mark Travel"
  description="The Okavango Delta, Chobe, Central Kalahari, and Linyanti. Botswana's low-volume, high-value safari model produces the most pristine wilderness experience available anywhere in Africa."
  schemaType="website"
  name={"Botswana"}
  region={{ label: "Africa", href: "/destinations/africa/" }}
  hero={{
    image: "/assets/img/e-11-elephant-herd-aerial.jpg",
    eyebrow: "Southern Africa",
    headline: "The Gold Standard of<br>Exclusive Safari.",
    sub: "Botswana's entire tourism model was built around a simple premise: limit the number of guests, charge accordingly, and deliver a wilderness experience that cannot be replicated anywhere else in Africa. The Okavango Delta, Chobe's elephant herds, the Linyanti Concession, and the Central Kalahari are not comparable to other safari destinations — they are the benchmark against which other safari destinations are measured.",
    ctaPrimary: { label: "Plan a Botswana Trip", href: "/plan-your-trip/" },
    ctaSecondary: { label: "Explore Destinations ↓", href: "#places" },
    // Add { label: "Best For", value: "..." } and "Flight Time" as the copy is written.
    stats: [
      { label: "Best Season", value: "June – October" },
    ],
  }}
>
  <Fragment set:html={Content} />
</DestinationLayout>
