---
import DestinationLayout from "../../../layouts/DestinationLayout.astro";
import Content from "../../../content-pages/destinations__peru.html?raw";
---
<DestinationLayout
  title="Peru | Machu Picchu & the Sacred Valley — Hit Your Mark Travel"
  description="Machu Picchu, the Sacred Valley, Cusco, Lake Titicaca and the Amazon — altitude acclimatization, archaeological context, and an Andean journey."
  schemaType="website"
  name={"Peru"}
  region={{ label: "South America", href: "/destinations/south-america/" }}
  hero={{
    image: "/assets/img/dh-17-peru-machu-picchu-dawn.jpg",
    eyebrow: "South America",
    headline: "Machu Picchu Is<br>the Beginning,<br>Not the End.",
    sub: "The Sacred Valley of the Incas with its living Quechua communities and working salt terraces. Cusco as a city built on Inca foundations — Spanish churches on top of Inca walls still visible at the join. Lima's food scene, genuinely one of the best in the world. Lake Titicaca and the floating reed islands. Peru rewards the traveler who plans beyond the headline.",
    ctaPrimary: { label: "Plan a Peru Trip", href: "/plan-your-trip/" },
    ctaSecondary: { label: "Explore Peru ↓", href: "#places" },
    // Best For and Flight Time still need Mark: fill docs/hero-stat-rail-worksheet.csv.
    // Format follows destinations/maldives: value: "Honeymoons<br>&amp; Couples" and
    // value: "~10h from NYC<br>~9h from LHR". Do not estimate flight times.
    stats: [
      { label: "Best Season", value: "May – October" },
    ],
  }}
>
  <Fragment set:html={Content} />
</DestinationLayout>
