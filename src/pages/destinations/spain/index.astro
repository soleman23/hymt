---
import DestinationLayout from "../../../layouts/DestinationLayout.astro";
import Content from "../../../content-pages/destinations__spain.html?raw";
---
<DestinationLayout
  title="Spain | Basque Country, Andalusia & Rioja — Hit Your Mark Travel"
  description="Spain by region and by table — San Sebastián's pintxos, Andalusia's Moorish triangle, Rioja's wineries, Galicia's seafood. One region deeply, not five superficially."
  name={"Spain"}
  region={{ label: "Europe", href: "/destinations/europe/" }}
  hero={{
    image: "/assets/img/dh-23-spain-andalusia-dusk.jpg",
    eyebrow: "Southern Europe",
    headline: "Not One Country.<br>Five Cuisines.",
    sub: "Spain is really several nations sharing a peninsula — Basque pintxos culture, Catalan modernism, Andalusian heat and Moorish geometry, Galician seafood, Rioja's wine country. The mistake is trying to see it all. The skill is choosing.",
    ctaPrimary: { label: "Plan a Spain Trip", href: "/plan-your-trip/" },
    ctaSecondary: { label: "Explore Spain ↓", href: "#places" },
    // Best For and Flight Time still need Mark: fill docs/hero-stat-rail-worksheet.csv.
    // Format follows destinations/maldives: value: "Honeymoons<br>&amp; Couples" and
    // value: "~10h from NYC<br>~9h from LHR". Do not estimate flight times.
    stats: [
      { label: "Best Season", value: "April – June · Sept – Oct" },
    ],
  }}
>
  <Fragment set:html={Content} />
</DestinationLayout>
