<DestinationLayout
  title="Dominican Republic Beyond Punta Cana — Hit Your Mark Travel"
  description="Punta Cana is not the country. Humpbacks fill Samaná Bay mid-January to late March, the dry season runs December to April, and the golf is at Casa de Campo."
  schemaType="website"
  name={"Dominican Republic"}
  region={{ label: "Caribbean &amp; Mexico", href: "/destinations/caribbean-mexico/" }}
  hero={{
    image: "/assets/img/caribbean-mexico-dominican-republic.jpg",
    eyebrow: "Caribbean",
    headline: "Two Countries<br>Wearing One Flag.",
    sub: "The country splits in two, and only one half shows up in the search results. Punta Cana's all-inclusive corridor does a beach week with children better than almost anywhere, and it is not the Dominican Republic. Casa de Campo's golf, the Samaná peninsula in whale season and Santo Domingo's colonial core are the other half, and they run on the same December-to-April window.",
    ctaPrimary: { label: "Plan a Dominican Republic Trip", href: "/plan-your-trip/" },
    ctaSecondary: { label: "Explore Dominican Republic ↓", href: "#places" },
    stats: [
      { label: "Best Season", value: "Dec – April" },
      { label: "Best For", value: "Golf, Beaches<br>&amp; Whales" },
    ],
  }}
>
  <Fragment set:html={Content} />
</DestinationLayout>
