---
import DestinationLayout from "../../../layouts/DestinationLayout.astro";
import Content from "../../../content-pages/destinations__antarctica.html?raw";
---
<DestinationLayout
  title="Antarctica | Expedition Cruises — Hit Your Mark Travel"
  description="Antarctica planned properly — which expedition ship, whether to fly the Drake, when to go for whales or penguins, and how to avoid the trips that disappoint."
  name={"Antarctica"}
  region={{ label: "Polar Regions", href: "/destinations/polar-regions/" }}
  hero={{
    image: "/assets/img/dh-01-antarctica-ice-cliffs.jpg",
    eyebrow: "The Last Continent",
    headline: "The Only Place<br>That Still Humbles.",
    sub: "Antarctica is the one destination that consistently exceeds what people expect of it, and the one where the choice of ship determines almost everything about the experience. There are no hotels, no roads and no residents. What there is, for about five months a year, is a coastline of ice and wildlife that reorders most travellers&#39; sense of scale.",
    ctaPrimary: { label: "Plan an Antarctic Expedition", href: "/plan-your-trip/" },
    ctaSecondary: { label: "Explore Antarctica &darr;", href: "#places" },
    // Best For and Flight Time still need Mark: fill docs/hero-stat-rail-worksheet.csv.
    // Format follows destinations/maldives: value: "Honeymoons<br>&amp; Couples" and
    // value: "~10h from NYC<br>~9h from LHR". Do not estimate flight times.
    stats: [
      { label: "Best Season", value: "December &ndash; January" },
    ],
  }}
>
  <Fragment set:html={Content} />
</DestinationLayout>
