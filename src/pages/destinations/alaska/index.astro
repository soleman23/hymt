---
import DestinationLayout from "../../../layouts/DestinationLayout.astro";
import Content from "../../../content-pages/destinations__alaska.html?raw";
---
<DestinationLayout
  title="Alaska | Wilderness Lodges & Glaciers — Hit Your Mark Travel"
  description="The Inside Passage, Denali and the Kenai Peninsula — planned around the wilderness lodges and float planes that make Alaska's scale comprehensible."
  schemaType="website"
  name={"Alaska"}
  region={{ label: "North America", href: "/destinations/north-america/" }}
  hero={{
    image: "/assets/img/na-alaska-brown-bear-salmon.jpg",
    eyebrow: "North America",
    headline: "Scale That Has<br>No Reference Point.",
    sub: "A state twice the size of Texas where the human footprint is visible from float plane windows as a thin ribbon of road in an otherwise uninterrupted wilderness. Alaska is the destination that resets how travelers understand scale — and why the wilderness lodge approach is the difference between seeing Alaska and being in it.",
    ctaPrimary: { label: "Plan an Alaska Trip", href: "/plan-your-trip/" },
    ctaSecondary: { label: "Explore Alaska ↓", href: "#places" },
    // Best For and Flight Time still need Mark: fill docs/hero-stat-rail-worksheet.csv.
    // Format follows destinations/maldives: value: "Honeymoons<br>&amp; Couples" and
    // value: "~10h from NYC<br>~9h from LHR". Do not estimate flight times.
    stats: [
      { label: "Best Season", value: "June – August" },
    ],
  }}
>
  <Fragment set:html={Content} />
</DestinationLayout>
