---
import DestinationLayout from "../../../layouts/DestinationLayout.astro";
import Content from "../../../content-pages/destinations__rwanda.html?raw";
---
<DestinationLayout
  title="Rwanda — Hit Your Mark Travel"
  description="Mountain gorilla trekking in the Volcanoes National Park. Rwanda's highlands offer the most profound wildlife encounter available anywhere — and a country rebuilt around extraordinary small-group tourism."
  schemaType="website"
  name={"Rwanda"}
  region={{ label: "Africa", href: "/destinations/africa/" }}
  hero={{
    image: "/assets/img/dh-21-rwanda-volcano-hills.jpg",
    eyebrow: "Central Africa",
    headline: "One Hour That<br>Changes Everything.",
    sub: "The gorilla trekking permit allows one hour with a habituated gorilla family in the volcanic forest above 2,500 meters. The rule exists because any longer would stress the animals. One hour is also more than enough to understand why seventy countries of travel experience does not prepare you for this particular encounter — the intelligence in the eyes, the proximity, the forest itself, the silence above the clouds.",
    ctaPrimary: { label: "Plan a Rwanda Trip", href: "/plan-your-trip/" },
    ctaSecondary: { label: "Explore Rwanda ↓", href: "#places" },
    // Add { label: "Best For", value: "..." } and "Flight Time" as the copy is written.
    stats: [
      { label: "Best Season", value: "June – September" },
    ],
  }}
>
  <Fragment set:html={Content} />
</DestinationLayout>
