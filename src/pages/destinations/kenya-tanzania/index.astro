---
import DestinationLayout from "../../../layouts/DestinationLayout.astro";
import Content from "../../../content-pages/destinations__kenya-tanzania.html?raw";
---
<DestinationLayout
  title="Kenya &amp; Tanzania — Hit Your Mark Travel"
  description="The Masai Mara, Serengeti, Amboseli, Ngorongoro, and Laikipia. East Africa's greatest wildlife theater planned around the camps, guides, and seasonal windows that put you in the right place at the right moment."
  schemaType="website"
  name={"Kenya &amp; Tanzania"}
  region={{ label: "Africa", href: "/destinations/africa/" }}
  hero={{
    image: "/assets/img/x-01-serengeti-elephants.jpg",
    eyebrow: "East Africa",
    headline: "Nothing Prepares You<br>For the Real Thing.",
    sub: "Every traveler who returns from a properly planned East Africa safari says the same thing. The photographs don't do it. The documentaries don't do it. Nothing fully conveys the scale of a wildebeest crossing, the proximity of a lion pride at dawn, or the silence of the Mara at first light until you're actually there. Kenya and Tanzania together form the most complete wildlife destination on earth — planned around the right camps, the right guides, and the right moment in the migration cycle.",
    ctaPrimary: { label: "Plan an East Africa Trip", href: "/plan-your-trip/" },
    ctaSecondary: { label: "Explore Destinations ↓", href: "#places" },
    // Best For and Flight Time still need Mark: fill docs/hero-stat-rail-worksheet.csv.
    // Format follows destinations/maldives: value: "Honeymoons<br>&amp; Couples" and
    // value: "~10h from NYC<br>~9h from LHR". Do not estimate flight times.
    stats: [
      { label: "Best Season", value: "July – October" },
    ],
  }}
>
  <Fragment set:html={Content} />
</DestinationLayout>
