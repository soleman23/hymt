    image: "/assets/img/dh-16-oman-wadi-fort.jpg",
    eyebrow: "Arabian Peninsula",
    headline: "The Middle East<br>Nobody Knows About<br>Yet.",
    sub: "A country that has maintained its culture and landscape without transformation. Desert, fjord, mountain, and coast within a single week's drive. A hospitality standard that exceeds expectation at every turn. And a self-drive road trip culture that rewards the traveler who plans properly and arrives with open time.",
    ctaPrimary: { label: "Plan an Oman Trip", href: "/plan-your-trip/" },
    ctaSecondary: { label: "Explore Oman ↓", href: "#places" },
    // Add { label: "Best For", value: "..." } and "Flight Time" as the copy is written.
    stats: [
      { label: "Best Season", value: "October – March" },
    ],
  }}
>
  <Fragment set:html={Content} />
