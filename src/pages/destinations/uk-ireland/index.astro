---
import DestinationLayout from "../../../layouts/DestinationLayout.astro";
import Content from "../../../content-pages/destinations__uk-ireland.html?raw";
---
<DestinationLayout
  title="UK & Ireland | Scotland, Ireland & England — Hit Your Mark Travel"
  description="Scottish Highlands by private driver, Ireland's Wild Atlantic Way, London done properly, and the castle hotels worth booking a year out."
  name={"UK & Ireland"}
  region={{ label: "Europe", href: "/destinations/europe/" }}
  hero={{
    image: "/assets/img/dh-25-uk-ireland-highland-loch.jpg",
    eyebrow: "Northern Europe",
    headline: "Castles, Coast,<br>and Proper Tables",
    sub: "London done deeply, the Highlands by private driver, Ireland's west coast at its wildest, and country-house hotels that invented the category. The British Isles reward travelers who get out of the cities — and know which rooms to book when they do.",
    ctaPrimary: { label: "Plan a UK & Ireland Trip", href: "/plan-your-trip/" },
    ctaSecondary: { label: "Explore UK & Ireland ↓", href: "#places" },
    // Best For and Flight Time still need Mark: fill docs/hero-stat-rail-worksheet.csv.
    // Format follows destinations/maldives: value: "Honeymoons<br>&amp; Couples" and
    // value: "~10h from NYC<br>~9h from LHR". Do not estimate flight times.
    stats: [
      { label: "Best Season", value: "May – September" },
    ],
  }}
>
  <Fragment set:html={Content} />
</DestinationLayout>
