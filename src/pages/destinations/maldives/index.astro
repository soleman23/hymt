---
import Base from "../../../layouts/Base.astro";
import Content from "../../../content-pages/destinations__maldives.html?raw";
const pageCss = "\n/* \u2500\u2500 INDIVIDUAL DESTINATION PAGE \u2500\u2500 */\n\n.breadcrumb {\n  background:var(--bg-surface);border-bottom:1px solid var(--border-subtle);\n  padding:14px 52px;margin-top:76px;\n}\n.breadcrumb__inner {\n  display:flex;align-items:center;gap:10px;\n  font-family:var(--font-d);font-size:10px;font-weight:600;\n  letter-spacing:.12em;text-transform:uppercase;\n}\n.breadcrumb__link { color:var(--text-muted);text-decoration:none;transition:color .15s }\n.breadcrumb__link:hover { color:var(--gold-400) }\n.breadcrumb__sep { color:var(--text-muted);font-size:10px }\n.breadcrumb__current { color:var(--gold-500) }\n\n/* HERO */\n.dest-hero {\n  position:relative;min-height:80vh;\n  background:var(--navy-800);display:flex;align-items:flex-end;\n  overflow:hidden;\n}\n.dest-hero__bg {\n  position:absolute;inset:0;background:var(--navy-800);\n  display:flex;align-items:center;justify-content:center;\n  font-family:var(--font-d);font-size:11px;font-weight:600;\n  letter-spacing:.18em;text-transform:uppercase;color:rgba(138,155,176,.18);\n}\n.dest-hero__watermark {\n  position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);\n  width:min(480px,60vw);height:min(480px,60vw);object-fit:contain;\n  opacity:.03;pointer-events:none;\n}\n.dest-hero__overlay {\n  position:absolute;inset:0;\n  background:linear-gradient(180deg,rgba(8,15,26,.05) 0%,rgba(8,15,26,.35) 45%,rgba(8,15,26,.93) 100%);\n}\n.dest-hero__content {\n  position:relative;z-index:1;padding:0 52px 72px;width:100%;\n  display:grid;grid-template-columns:1fr auto;gap:40px;align-items:flex-end;\n}\n.dest-hero__left {}\n.dest-hero__region {\n  display:inline-flex;align-items:center;gap:10px;margin-bottom:14px;\n}\n.dest-hero__headline {\n  font-family:var(--font-d);font-size:clamp(40px,7vw,88px);font-weight:700;\n  letter-spacing:-.03em;line-height:.95;color:var(--cream-100);margin-bottom:20px;\n}\n.dest-hero__sub {\n  font-family:var(--font-b);font-size:17px;color:var(--silver-300);\n  line-height:1.7;max-width:52ch;margin-bottom:32px;\n}\n.dest-hero__ctas { display:flex;gap:12px;flex-wrap:wrap }\n.dest-hero__right {\n  display:flex;flex-direction:column;gap:20px;\n  padding-left:40px;border-left:1px solid var(--border-gold);\n  align-self:flex-end;padding-bottom:4px;\n  min-width:180px;\n}\n.dest-hero__stat-label {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.2em;text-transform:uppercase;color:var(--gold-500);\n  display:block;margin-bottom:4px;\n}\n.dest-hero__stat-val {\n  font-family:var(--font-d);font-size:18px;font-weight:600;\n  color:var(--cream-100);line-height:1.2;\n}\n.btn-primary-gold {\n  display:inline-flex;align-items:center;gap:8px;\n  font-family:var(--font-d);font-size:11px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;\n  background:var(--gold-500);color:var(--navy-900);\n  padding:15px 32px;border:none;cursor:pointer;transition:all .15s;text-decoration:none;\n}\n.btn-primary-gold:hover { background:var(--gold-400);box-shadow:0 0 28px rgba(201,168,76,.25) }\n.btn-outline-gold {\n  display:inline-flex;align-items:center;gap:8px;\n  font-family:var(--font-d);font-size:11px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;\n  background:transparent;color:var(--gold-500);\n  padding:14px 28px;border:1px solid var(--gold-500);\n  cursor:pointer;transition:all .15s;text-decoration:none;\n}\n.btn-outline-gold:hover { background:var(--accent-subtle) }\n\n/* INTRO */\n.dest-intro {\n  display:grid;grid-template-columns:1fr 1fr;\n  background:var(--bg-surface);border-bottom:1px solid var(--border-subtle);\n}\n.dest-intro__content { padding:72px 64px }\n.dest-intro__title {\n  font-family:var(--font-d);font-size:clamp(22px,2.8vw,32px);font-weight:700;\n  letter-spacing:-.02em;color:var(--text-primary);margin-bottom:22px;\n}\n.dest-intro__body {\n  font-family:var(--font-b);font-size:15px;color:var(--text-secondary);\n  line-height:1.8;margin-bottom:16px;max-width:52ch;\n}\n.dest-intro__image {\n  background:var(--bg-card);position:relative;min-height:460px;\n  display:flex;align-items:center;justify-content:center;\n  font-family:var(--font-d);font-size:10px;font-weight:600;\n  letter-spacing:.14em;text-transform:uppercase;color:rgba(138,155,176,.25);\n}\n.dest-intro__caption {\n  position:absolute;bottom:20px;left:24px;\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.18em;text-transform:uppercase;color:var(--gold-700);\n}\n\n/* SEASONS */\n.seasons-strip {\n  background:var(--bg-page);border-bottom:1px solid var(--border-subtle);\n  padding:48px 52px;\n}\n.seasons-grid { display:grid;grid-template-columns:repeat(4,1fr);gap:3px }\n.season-item {\n  padding:24px 24px;border:1px solid var(--border-subtle);\n  background:var(--bg-elevated);\n}\n.season-item--best { border-color:var(--border-gold);background:var(--accent-subtle) }\n.season-name {\n  font-family:var(--font-d);font-size:10px;font-weight:700;\n  letter-spacing:.2em;text-transform:uppercase;color:var(--text-secondary);\n  margin-bottom:8px;\n}\n.season-item--best .season-name { color:var(--gold-500) }\n.season-months {\n  font-family:var(--font-d);font-size:16px;font-weight:600;\n  color:var(--text-primary);margin-bottom:8px;\n}\n.season-desc {\n  font-family:var(--font-b);font-size:12px;color:var(--text-muted);line-height:1.5;\n}\n.season-badge {\n  display:inline-block;margin-top:8px;\n  font-family:var(--font-d);font-size:8px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;\n  padding:4px 10px;background:var(--gold-500);color:var(--navy-900);\n}\n\n/* EXPERIENCES */\n.dest-exp-section { padding:72px 52px;background:var(--bg-page) }\n.dest-exp-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:3px }\n.dest-exp-card {\n  background:var(--bg-elevated);border:1px solid var(--border-subtle);\n  padding:32px 28px;transition:border-color .2s;\n}\n.dest-exp-card:hover { border-color:var(--border-gold) }\n.dest-exp-num {\n  font-family:var(--font-d);font-size:48px;font-weight:800;\n  color:var(--gold-500);opacity:.16;line-height:1;margin-bottom:12px;\n}\n.dest-exp-name {\n  font-family:var(--font-d);font-size:16px;font-weight:700;\n  color:var(--text-primary);margin-bottom:10px;\n}\n.dest-exp-body {\n  font-family:var(--font-b);font-size:13px;color:var(--text-secondary);\n  line-height:1.7;\n}\n\n/* WHERE TO STAY */\n.stay-section {\n  padding:72px 52px;background:var(--bg-surface);\n  border-top:1px solid var(--border-subtle);border-bottom:1px solid var(--border-subtle);\n}\n.stay-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:3px }\n.stay-card {\n  background:var(--bg-elevated);border:1px solid var(--border-subtle);\n  overflow:hidden;transition:border-color .2s;\n}\n.stay-card:hover { border-color:var(--border-gold) }\n.stay-card__image {\n  height:200px;background:var(--bg-card);\n  display:flex;align-items:center;justify-content:center;\n  font-family:var(--font-d);font-size:9px;font-weight:600;\n  letter-spacing:.14em;text-transform:uppercase;color:rgba(138,155,176,.25);\n}\n.stay-card__body { padding:24px }\n.stay-card__atoll {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.2em;text-transform:uppercase;color:var(--gold-500);\n  margin-bottom:6px;\n}\n.stay-card__name {\n  font-family:var(--font-d);font-size:18px;font-weight:700;\n  color:var(--text-primary);margin-bottom:8px;\n}\n.stay-card__desc {\n  font-family:var(--font-b);font-size:13px;color:var(--text-secondary);\n  line-height:1.65;margin-bottom:16px;\n}\n.stay-card__tags { display:flex;flex-wrap:wrap;gap:6px }\n.stay-tag {\n  font-family:var(--font-b);font-size:11px;color:var(--silver-300);\n  padding:4px 10px;background:var(--bg-card);\n  border:1px solid var(--border-subtle);\n}\n\n/* PRACTICALITIES */\n.practical-section {\n  padding:72px 52px;background:var(--bg-page);\n  border-bottom:1px solid var(--border-subtle);\n}\n.practical-grid { display:grid;grid-template-columns:1fr 1fr;gap:3px }\n.practical-col {\n  background:var(--bg-elevated);border:1px solid var(--border-subtle);padding:40px 36px;\n}\n.practical-title {\n  font-family:var(--font-d);font-size:11px;font-weight:700;\n  letter-spacing:.2em;text-transform:uppercase;color:var(--gold-500);\n  margin-bottom:20px;\n}\n.practical-list { list-style:none;display:flex;flex-direction:column;gap:0 }\n.practical-item {\n  display:grid;grid-template-columns:120px 1fr;gap:16px;\n  padding:12px 0;border-bottom:1px solid var(--border-subtle);\n  font-family:var(--font-b);font-size:13px;\n}\n.practical-item:last-child { border-bottom:none }\n.practical-item-label { color:var(--text-muted);font-weight:500 }\n.practical-item-val { color:var(--text-primary) }\n\n/* RELATED */\n.related-section {\n  padding:72px 52px;background:var(--bg-surface);\n  border-bottom:1px solid var(--border-subtle);\n}\n.related-grid { display:grid;grid-template-columns:repeat(3,1fr);grid-auto-rows:220px;gap:3px }\n.related-card {\n  position:relative;overflow:hidden;cursor:pointer;\n  background:var(--bg-card);\n  display:flex;flex-direction:column;justify-content:flex-end;\n  text-decoration:none;\n}\n.related-card__ph {\n  position:absolute;inset:0;display:flex;align-items:center;justify-content:center;\n  font-family:var(--font-d);font-size:9px;font-weight:600;\n  letter-spacing:.14em;text-transform:uppercase;color:rgba(138,155,176,.25);\n  transition:transform .4s cubic-bezier(.16,1,.3,1);\n}\n.related-card:hover .related-card__ph { transform:scale(1.04) }\n.related-card__overlay {\n  position:absolute;inset:0;\n  background:linear-gradient(0deg,rgba(8,15,26,.88) 0%,rgba(8,15,26,.15) 60%,transparent 100%);\n}\n.related-card__body {\n  position:relative;z-index:1;padding:20px;\n  border-top:1px solid transparent;transition:border-color .3s;\n}\n.related-card:hover .related-card__body { border-color:rgba(201,168,76,.35) }\n.related-card__region {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.2em;text-transform:uppercase;color:var(--gold-500);margin-bottom:4px;\n}\n.related-card__name {\n  font-family:var(--font-d);font-size:17px;font-weight:700;\n  color:var(--cream-100);\n}\n\n/* MARK CTA */\n.dest-cta {\n  padding:80px 52px;background:var(--navy-800);\n  display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;\n}\n.dest-cta__logo { width:80px;height:80px;object-fit:contain;margin-bottom:20px;filter:drop-shadow(0 4px 16px rgba(201,168,76,.2)) }\n.dest-cta__title {\n  font-family:var(--font-d);font-size:clamp(24px,3vw,36px);font-weight:700;\n  letter-spacing:-.02em;color:var(--cream-100);margin-bottom:14px;\n}\n.dest-cta__body {\n  font-family:var(--font-b);font-size:15px;color:var(--silver-300);\n  line-height:1.75;margin-bottom:28px;max-width:48ch;\n}\n.dest-cta__note {\n  font-family:var(--font-b);font-size:12px;color:var(--silver-400);margin-top:14px;\n}\n.dest-cta__aside {\n  display:flex;flex-direction:column;gap:0;\n  border-left:1px solid var(--border-gold);padding-left:48px;\n}\n.dest-cta__aside-item {\n  padding:20px 0;border-bottom:1px solid var(--border-subtle);\n}\n.dest-cta__aside-item:last-child { border-bottom:none }\n.dest-cta__aside-label {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.2em;text-transform:uppercase;color:var(--gold-500);\n  margin-bottom:4px;display:block;\n}\n.dest-cta__aside-val {\n  font-family:var(--font-b);font-size:14px;color:var(--cream-100);\n}\n.dest-cta__aside-val a { color:var(--silver-300);transition:color .15s }\n.dest-cta__aside-val a:hover { color:var(--gold-400) }\n\n@media(max-width:900px){\n  .breadcrumb { padding:12px 28px }\n  .dest-hero__content { grid-template-columns:1fr;padding:0 28px 56px }\n  .dest-hero__right { display:none }\n  .dest-intro { grid-template-columns:1fr }\n  .dest-intro__content { padding:48px 28px }\n  .dest-intro__image { min-height:260px;aspect-ratio:16/9 }\n  .seasons-grid { grid-template-columns:1fr 1fr }\n  .dest-exp-grid,.stay-grid,.related-grid { grid-template-columns:1fr }\n  .practical-grid { grid-template-columns:1fr }\n  .dest-cta { grid-template-columns:1fr;gap:40px }\n  .dest-cta__aside { padding-left:0;border-left:none;border-top:1px solid var(--border-gold);padding-top:28px }\n  .seasons-strip,.dest-exp-section,.stay-section,.practical-section,.related-section,.dest-cta { padding-left:28px;padding-right:28px }\n}\n\n/* \u2500\u2500 PAGE FAQ \u2500\u2500 */\n.page-faq{padding:80px 52px;background:var(--bg-surface);border-top:1px solid var(--border-subtle);border-bottom:1px solid var(--border-subtle)}\n.page-faq__header{max-width:640px;margin-bottom:48px}\n.page-faq__label{font-family:var(--font-d);font-size:10px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--gold-500);margin-bottom:12px}\n.page-faq__title{font-family:var(--font-d);font-size:clamp(24px,3vw,36px);font-weight:700;letter-spacing:-.02em;color:var(--text-primary);margin-bottom:16px}\n.page-faq__sub{font-family:var(--font-b);font-size:15px;color:var(--text-secondary);line-height:1.7}\n.pf-grid{display:grid;grid-template-columns:1fr 1fr;gap:3px}\n.pf-item{background:var(--bg-elevated);border:1px solid var(--border-subtle);transition:border-color .2s}\n.pf-item.open{border-color:var(--border-gold)}\n.pf-q{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;padding:24px 28px;cursor:pointer}\n.pf-q__text{font-family:var(--font-d);font-size:14px;font-weight:700;color:var(--text-primary);line-height:1.35}\n.pf-q__icon{width:28px;height:28px;flex-shrink:0;border:1px solid var(--border-subtle);display:flex;align-items:center;justify-content:center;color:var(--gold-500);font-size:18px;line-height:1;transition:transform .2s,border-color .2s;margin-top:2px}\n.pf-item.open .pf-q__icon{transform:rotate(45deg);border-color:var(--border-gold)}\n.pf-a{display:none;padding:0 28px 24px;font-family:var(--font-b);font-size:14px;color:var(--text-secondary);line-height:1.75}\n.pf-item.open .pf-a{display:block}\n.page-faq__more{margin-top:36px;display:flex;align-items:center;gap:12px}\n.page-faq__more-link{font-family:var(--font-d);font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--gold-500);text-decoration:none;display:inline-flex;align-items:center;gap:6px;transition:gap .15s}\n.page-faq__more-link:hover{gap:10px}\n.page-faq__more-link::after{content:'\u2192'}\n@media(max-width:768px){.pf-grid{grid-template-columns:1fr}.page-faq{padding:64px 28px}}\n";
---
<Base title="The Maldives — Hit Your Mark Travel" description="The Maldives: overwater villas, private atolls, and lagoons that glow at dusk. Every property personally visited. Every itinerary built from scratch." active="destinations" pageCss={pageCss} schemaType="website">
  <Fragment set:html={Content} />
</Base>
