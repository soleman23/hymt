---
import DestinationLayout from "../../../layouts/DestinationLayout.astro";
import Content from "../../../content-pages/destinations__maldives.html?raw";
---
<DestinationLayout
  title="The Maldives — Hit Your Mark Travel"
  description="The Maldives: overwater villas, private atolls, and lagoons that glow at dusk. Every resort vetted reef by reef. Every itinerary built from scratch."
  schemaType="website"
  name={"The Maldives"}
  region={{ label: "Asia", href: "/destinations/asia/" }}
  hero={{
    image: "/assets/img/h-01-maldives-aerial.jpg",
    eyebrow: "Asia &nbsp;·&nbsp; Indian Ocean",
    headline: "The<br>Maldives",
    sub: "Where the sky meets the sea and every sunrise feels made for two. Overwater villas, private atolls, and lagoons that glow at dusk. The benchmark for seclusion done properly.",
    ctaPrimary: { label: "Plan My Trip", href: "/plan-your-trip/" },
    ctaSecondary: { label: "Explore the Islands ↓", href: "#experiences" },
    // Best For and Flight Time still need Mark: fill docs/hero-stat-rail-worksheet.csv.
    // Format follows destinations/maldives: value: "Honeymoons<br>&amp; Couples" and
    // value: "~10h from NYC<br>~9h from LHR". Do not estimate flight times.
    stats: [
      { label: "Best Season", value: "Nov – Apr" },
      { label: "Best For", value: "Honeymoons<br>&amp; Couples" },
      { label: "Flight Time", value: "~10h from NYC<br>~9h from LHR" },
    ],
  }}
>
  <Fragment set:html={Content} />
</DestinationLayout>
