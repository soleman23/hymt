---
import DestinationLayout from "../../../layouts/DestinationLayout.astro";
import Content from "../../../content-pages/destinations__new-york.html?raw";
---
<DestinationLayout
  title="New York — Hit Your Mark Travel"
  description="Manhattan, Brooklyn, the Hudson Valley and the Hamptons — the neighborhoods, food specialists and escapes that most visitors never find."
  schemaType="website"
  name={"New York"}
  region={{ label: "North America", href: "/destinations/north-america/" }}
  hero={{
    image: "/assets/img/dh-13-new-york-skyline-dusk.jpg",
    eyebrow: "North America",
    headline: "The City That Rewards<br>Knowing It.",
    sub: "The difference between Times Square and the West Village at 7am is the difference between New York as a postcard and New York as a city. The difference between a dinner reservation at a known restaurant and a counter seat at an eight-seat omakase whose chef worked under a three-Michelin-star kitchen for ten years. New York rewards the traveler who knows where to look.",
    ctaPrimary: { label: "Plan a New York Trip", href: "/plan-your-trip/" },
    ctaSecondary: { label: "Explore New York ↓", href: "#places" },
    // Best For and Flight Time still need Mark: fill docs/hero-stat-rail-worksheet.csv.
    // Format follows destinations/maldives: value: "Honeymoons<br>&amp; Couples" and
    // value: "~10h from NYC<br>~9h from LHR". Do not estimate flight times.
    stats: [
      { label: "Best Season", value: "May – June" },
    ],
  }}
>
  <Fragment set:html={Content} />
</DestinationLayout>
