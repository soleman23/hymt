<DestinationLayout
  title="Turks &amp; Caicos — Hit Your Mark Travel"
  description="Grace Bay, North Caicos, Salt Cay, Pine Cay, and Parrot Cay. Turks &amp; Caicos planned around the right villa or resort on Providenciales, the quieter outer cays, and the diving and whale-watching that the brochures don't always mention."
  schemaType="website"
  name={"Turks &amp; Caicos"}
  region={{ label: "Caribbean &amp; Mexico", href: "/destinations/caribbean-mexico/" }}
  hero={{
    image: "/assets/img/d-02-grace-bay.jpg",
    eyebrow: "British West Indies",
    headline: "The Best Beach in the<br>Western Hemisphere<br>Is Here.",
    sub: "Grace Bay Beach is consistently ranked among the finest beaches in the world — and the ranking is accurate. Twelve miles of uninterrupted white sand and water that is genuinely that color in person. The planning work in Turks &amp; Caicos is choosing between a Grace Bay villa or resort, and whether to extend the trip to the quieter outer cays where the rest of the country lives at a completely different pace.",
    ctaPrimary: { label: "Plan a Turks &amp; Caicos Trip", href: "/plan-your-trip/" },
    ctaSecondary: { label: "Explore the Islands ↓", href: "#places" },
    // Best For and Flight Time still need Mark: fill docs/hero-stat-rail-worksheet.csv.
    // Format follows destinations/maldives: value: "Honeymoons<br>&amp; Couples" and
    // value: "~10h from NYC<br>~9h from LHR". Do not estimate flight times.
    stats: [
      { label: "Best Season", value: "December – April" },
    ],
  }}
>
  <Fragment set:html={Content} />
</DestinationLayout>
