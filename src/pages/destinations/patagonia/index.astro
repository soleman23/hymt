---
import DestinationLayout from "../../../layouts/DestinationLayout.astro";
import Content from "../../../content-pages/destinations__patagonia.html?raw";
---
<DestinationLayout
  title="Patagonia — Hit Your Mark Travel"
  description="Torres del Paine, Los Glaciares, El Chaltén and Tierra del Fuego — planned around the weather windows, the right lodges, and the trekking."
  schemaType="website"
  name={"Patagonia"}
  region={{ label: "South America", href: "/destinations/south-america/" }}
  hero={{
    image: "/assets/img/e-12-patagonia-trek.jpg",
    eyebrow: "South America",
    headline: "The End of the Earth,<br>Worth Every Mile.",
    sub: "Patagonia is the landscape that travelers consistently describe as having no reference point — the granite spires of Torres del Paine, the Perito Moreno glacier advancing six feet a day into Lago Argentino, the constant wind that makes the steppe feel actively alive. The planning work here is choosing the lodge-supported trek over the tent, the right week against weather variability, and the Chilean and Argentine sides as a combined circuit rather than separate trips.",
    ctaPrimary: { label: "Plan a Patagonia Trip", href: "/plan-your-trip/" },
    ctaSecondary: { label: "Explore Patagonia ↓", href: "#places" },
    // Best For and Flight Time still need Mark: fill docs/hero-stat-rail-worksheet.csv.
    // Format follows destinations/maldives: value: "Honeymoons<br>&amp; Couples" and
    // value: "~10h from NYC<br>~9h from LHR". Do not estimate flight times.
    stats: [
      { label: "Best Season", value: "November – March" },
    ],
  }}
>
  <Fragment set:html={Content} />
</DestinationLayout>
