---
import DestinationLayout from "../../../layouts/DestinationLayout.astro";
import Content from "../../../content-pages/destinations__riviera-maya-los-cabos.html?raw";
---
<DestinationLayout
  title="Riviera Maya &amp; Los Cabos | Mexico Beach Travel Done Properly — Hit Your Mark Travel"
  description="Mexico&#39;s two great beach coasts, planned properly — which Riviera Maya resorts are worth it, when Los Cabos is at its best, and how to avoid the versions that disappoint."
  name={"Riviera Maya &amp; Los Cabos"}
  region={{ label: "Caribbean &amp; Mexico", href: "/destinations/caribbean-mexico/" }}
  hero={{
    image: "/assets/img/dh-20-riviera-maya-coast.jpg",
    eyebrow: "Mexico",
    headline: "Two Coasts,<br>Two Different Trips.",
    sub: "Riviera Maya and Los Cabos get sold as the same holiday and they could hardly be less alike. One is jungle, cenotes and Caribbean water with Mayan ruins an hour inland. The other is desert meeting Pacific, with a sea that is often too rough to swim and a restaurant scene that has quietly become the best in the country. Choosing correctly between them is most of the work.",
    ctaPrimary: { label: "Plan a Mexico Trip", href: "/plan-your-trip/" },
    ctaSecondary: { label: "Explore Riviera Maya &amp; Los Cabos &darr;", href: "#places" },
    // Best For and Flight Time still need Mark: fill docs/hero-stat-rail-worksheet.csv.
    // Format follows destinations/maldives: value: "Honeymoons<br>&amp; Couples" and
    // value: "~10h from NYC<br>~9h from LHR". Do not estimate flight times.
    stats: [
      { label: "Best Season", value: "November &ndash; April" },
    ],
  }}
>
  <Fragment set:html={Content} />
</DestinationLayout>
