---
import Base from "../../layouts/Base.astro";
import Content from "../../content-pages/destinations.html?raw";
import { breadcrumbs, collection } from "../../lib/schema";

/* P2-5: CollectionPage + ItemList of the child destination pages. Children
   are discovered from the filesystem so a new page joins the list by
   existing; names are title-cased from the slug, with explicit entries where
   the slug loses punctuation the real name carries. */
const SITE = (Astro.site?.href ?? "https://www.hymtravel.com/").replace(/\/$/, "");
const description =
  "60+ handpicked luxury destinations across 9 regions — every one personally visited and vetted. From Maldives overwater villas to Botswana safaris, Santorini caldera suites to Patagonian wilderness lodges.";
const NAME_EXCEPTIONS: Record<string, string> = {
  "caribbean-mexico": "Caribbean & Mexico",
  "galapagos": "Galápagos",
  "kenya-tanzania": "Kenya & Tanzania",
  "maldives": "The Maldives",
  "napa-sonoma": "Napa & Sonoma",
  "riviera-maya-los-cabos": "Riviera Maya & Los Cabos",
  "st-barths": "St. Barth's",
  "turks-caicos": "Turks & Caicos",
  "uk-ireland": "UK & Ireland",
};
const nameOf = (slug: string) =>
  NAME_EXCEPTIONS[slug] ??
  slug.split("-").map((w) => w[0].toUpperCase() + w.slice(1)).join(" ");
const children = Object.keys(import.meta.glob("./*/index.astro"))
  .map((p) => p.replace("./", "").replace("/index.astro", ""))
  .sort();
const schema = [
  collection(SITE, {
    name: "Destinations",
    description,
    path: "/destinations/",
    items: children.map((s) => ({ name: nameOf(s), path: `/destinations/${s}/` })),
  }),
  breadcrumbs(SITE, [{ name: "Home", path: "/" }, { name: "Destinations" }]),
];
const pageCss = "\n/* \u2500\u2500 DESTINATIONS PAGE EXTRAS \u2500\u2500 */\n\n.page-hero {\n  position:relative;min-height:52vh;margin-top:76px;\n  background:var(--navy-800);display:flex;align-items:flex-end;overflow:hidden;\n}\n.page-hero__bg { position:absolute;inset:0;background:var(--navy-800) }\n.page-hero__watermark {\n  position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);\n  width:min(460px,58vw);height:min(460px,58vw);object-fit:contain;\n  opacity:.04;pointer-events:none;\n}\n.page-hero__overlay {\n  position:absolute;inset:0;\n  background:linear-gradient(180deg,rgba(8,15,26,0) 0%,rgba(8,15,26,.55) 55%,rgba(8,15,26,.94) 100%);\n}\n.page-hero__content {\n  position:relative;z-index:1;width:100%;padding:0 52px 64px;\n}\n.page-hero__headline {\n  font-family:var(--font-d);font-size:clamp(32px,5vw,60px);font-weight:700;\n  letter-spacing:-.03em;line-height:1.0;color:var(--cream-100);margin-bottom:14px;margin-top:12px;\n}\n.page-hero__sub {\n  font-family:var(--font-b);font-size:17px;color:var(--silver-300);\n  line-height:1.7;max-width:54ch;\n}\n\n/* FILTER */\n.filter-bar {\n  position:sticky;top:76px;z-index:90;\n  background:var(--bg-surface);border-bottom:1px solid var(--border-gold);\n  overflow-x:auto;scrollbar-width:none;\n}\n.filter-bar::-webkit-scrollbar{display:none}\n.filter-bar__inner { display:flex;justify-content:center;width:max-content;min-width:100%;padding:0 52px;white-space:nowrap }\n.filter-pill {\n  font-family:var(--font-d);font-size:10px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;\n  color:var(--text-muted);background:transparent;border:none;\n  padding:18px 14px;cursor:pointer;transition:all .15s;\n  border-bottom:2px solid transparent;white-space:nowrap;\n  display:inline-flex;align-items:center;text-decoration:none;\n}\n.filter-pill:hover { color:var(--gold-400) }\n.filter-pill.active { color:var(--gold-400);border-bottom-color:var(--gold-500) }\n\n/* DESTINATIONS GRID */\n.dest-section { padding:64px 52px;background:var(--bg-page) }\n.dest-grid {\n  display:grid;\n  grid-template-columns:repeat(3,1fr);\n  grid-auto-rows:320px;\n  gap:3px;\n}\n\n/* CARD */\n.dest-card {\n  position:relative;overflow:hidden;\n  background:var(--bg-card);\n  display:flex;flex-direction:column;justify-content:flex-end;\n  transition:none;\n}\n.dest-card__ph {\n  position:absolute;inset:0;\n  display:flex;align-items:center;justify-content:center;\n  font-family:var(--font-d);font-size:10px;font-weight:600;\n  letter-spacing:.14em;text-transform:uppercase;color:rgba(138,155,176,.25);\n  transition:transform .5s cubic-bezier(.16,1,.3,1);\n}\na.dest-card:hover .dest-card__ph { transform:scale(1.04) }\n.dest-card__overlay {\n  position:absolute;inset:0;\n  background:linear-gradient(0deg,rgba(8,15,26,.92) 0%,rgba(8,15,26,.3) 40%,rgba(8,15,26,.05) 100%);\n  transition:opacity .3s;\n}\na.dest-card:hover .dest-card__overlay { opacity:.75 }\n.dest-card__body {\n  position:relative;z-index:1;padding:24px;\n  border-top:1px solid transparent;transition:border-color .3s;\n}\na.dest-card:hover .dest-card__body { border-color:rgba(201,168,76,.35) }\n.dest-card__region {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.22em;text-transform:uppercase;color:var(--gold-500);\n  margin-bottom:5px;display:block;\n}\n.dest-card__name {\n  font-family:var(--font-d);font-size:18px;font-weight:700;\n  color:var(--cream-100);line-height:1.15;margin-bottom:6px;\n}\n.dest-card__desc {\n  font-family:var(--font-b);font-size:12px;color:var(--silver-300);\n  line-height:1.5;margin-bottom:10px;\n  max-height:0;overflow:hidden;transition:max-height .3s ease,opacity .3s;opacity:0;\n}\na.dest-card:hover .dest-card__desc { max-height:60px;opacity:1 }\n.dest-card__tags { display:flex;gap:6px;flex-wrap:wrap }\n.dest-tag {\n  font-family:var(--font-d);font-size:8px;font-weight:700;\n  letter-spacing:.12em;text-transform:uppercase;\n  padding:3px 8px;background:rgba(201,168,76,.12);\n  border:1px solid rgba(201,168,76,.25);color:var(--gold-400);\n}\n\n/* FILTERED-OUT CARDS — .dest-card is display:flex, which beats [hidden]'s\n   UA display:none, so this override is required for filtering to work. */\n.dest-card[hidden] { display:none !important }\n\n/* REGION HUB LINK + EMPTY STATE */\n.dest-hubline { margin:0 0 28px }\n.dest-hubline__link {\n  display:inline-flex;align-items:center;gap:8px;\n  font-family:var(--font-d);font-size:10px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;color:var(--gold-500);\n  transition:gap .15s;\n}\n.dest-hubline__link::after { content:'\\2192' }\n.dest-hubline__link:hover { gap:14px;color:var(--gold-400) }\n.dest-empty {\n  font-family:var(--font-b);font-size:15px;color:var(--text-muted);\n  padding:32px 0 0;\n}\n\n/* COMPARE */\n.compare-section {\n  padding:80px 52px;background:var(--bg-surface);\n  border-top:1px solid var(--border-subtle);border-bottom:1px solid var(--border-subtle);\n}\n.compare-header { margin-bottom:48px }\n.compare-title {\n  font-family:var(--font-d);font-size:clamp(24px,2.8vw,36px);font-weight:700;\n  letter-spacing:-.02em;color:var(--text-primary);margin-bottom:10px;\n}\n.compare-sub {\n  font-family:var(--font-b);font-size:15px;color:var(--text-secondary);\n  line-height:1.6;max-width:52ch;\n}\n.compare-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:3px }\n.compare-card {\n  background:var(--bg-elevated);border:1px solid var(--border-subtle);\n  padding:36px 32px;transition:border-color .2s;\n}\n.compare-card:hover { border-color:var(--border-gold) }\n.compare-card__vs {\n  font-family:var(--font-d);font-size:17px;font-weight:700;\n  letter-spacing:-.01em;color:var(--text-primary);margin-bottom:10px;\n}\n.compare-card__desc {\n  font-family:var(--font-b);font-size:13px;color:var(--text-secondary);\n  line-height:1.65;margin-bottom:20px;\n}\n.compare-card__cta {\n  font-family:var(--font-d);font-size:10px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;color:var(--gold-500);\n  display:inline-flex;align-items:center;gap:8px;\n  background:none;border:none;cursor:pointer;padding:0;transition:gap .15s;\n}\n.compare-card__cta:hover { gap:14px }\n.compare-card__cta::after { content:'\u2192' }\n\n/* FINAL CTA */\n.final-cta {\n  padding:96px 52px;background:var(--bg-page);\n  display:grid;grid-template-columns:2fr 1fr;gap:80px;align-items:center;\n}\n.final-cta__title {\n  font-family:var(--font-d);font-size:clamp(28px,3.5vw,44px);font-weight:700;\n  letter-spacing:-.02em;color:var(--text-primary);margin-bottom:14px;\n}\n.final-cta__body {\n  font-family:var(--font-b);font-size:16px;color:var(--text-secondary);\n  line-height:1.75;max-width:52ch;margin-bottom:32px;\n}\n.final-cta__note {\n  font-family:var(--font-b);font-size:12px;color:var(--text-muted);\n  margin-top:14px;letter-spacing:.04em;\n}\n.final-cta__aside {\n  display:flex;flex-direction:column;gap:20px;\n  padding-left:48px;border-left:1px solid var(--border-gold);\n}\n.final-cta__aside-stat {}\n.final-cta__aside-num {\n  font-family:var(--font-d);font-size:36px;font-weight:700;\n  color:var(--gold-400);line-height:1;letter-spacing:-.02em;\n}\n.final-cta__aside-desc {\n  font-family:var(--font-b);font-size:13px;color:var(--text-secondary);\n  line-height:1.5;margin-top:4px;\n}\n.btn-gold {\n  display:inline-flex;align-items:center;gap:10px;\n  font-family:var(--font-d);font-size:11px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;\n  background:var(--gold-500);color:var(--navy-900);\n  padding:16px 36px;border:none;cursor:pointer;transition:all .15s;\n}\n.btn-gold:hover { background:var(--gold-400);box-shadow:0 0 32px rgba(201,168,76,.25) }\n\n@media(max-width:900px){\n  .dest-grid{grid-template-columns:repeat(2,1fr)}\n  .compare-grid{grid-template-columns:1fr}\n  .final-cta{grid-template-columns:1fr;gap:40px}\n  .final-cta__aside{padding-left:0;border-left:none;flex-direction:row;flex-wrap:wrap;gap:28px;border-top:1px solid var(--border-gold);padding-top:28px}\n  .page-hero__content,.dest-section,.compare-section,.final-cta{padding-left:28px;padding-right:28px}\n  .filter-bar__inner{padding:0 20px}\n}\n@media(max-width:540px){\n  .dest-grid{grid-template-columns:1fr;grid-auto-rows:260px}\n}\n";
---
<Base title="Destinations — Hit Your Mark Travel" description={description} active="destinations" pageCss={pageCss} schemaType="website" schema={schema}>
  <Fragment set:html={Content} />
</Base>
