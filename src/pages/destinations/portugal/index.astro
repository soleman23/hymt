---
import DestinationLayout from "../../../layouts/DestinationLayout.astro";
import Content from "../../../content-pages/destinations__portugal.html?raw";
---
<DestinationLayout
  title="Portugal | Lisbon, Porto & the Douro — Hit Your Mark Travel"
  description="Lisbon's tasca culture, Porto's wine lodges, Douro harvest, the slow Alentejo and the western Algarve. Tables and quintas booked before you land."
  name={"Portugal"}
  region={{ label: "Europe", href: "/destinations/europe/" }}
  hero={{
    image: "/assets/img/dh-19-portugal-douro-valley.jpg",
    eyebrow: "Southern Europe",
    headline: "Europe's Quietest<br>Great Destination",
    sub: "Portugal delivers what the rest of Western Europe keeps promising — extraordinary food, serious wine, golden light, and hotels worth the journey — at a pace and price that feel like a different decade.",
    ctaPrimary: { label: "Plan a Portugal Trip", href: "/plan-your-trip/" },
    ctaSecondary: { label: "Explore Portugal ↓", href: "#places" },
    stats: [
      { label: "Best Season", value: "May – June · Sept – Oct" },
      { label: "Best For", value: "Food, Wine<br>&amp; Value" },
    ],
  }}
>
  <Fragment set:html={Content} />
</DestinationLayout>
