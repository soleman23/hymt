---
import Base from "../../../layouts/Base.astro";
import Content from "../../../content-pages/destinations__portugal.html?raw";
const pageCss = "\n.breadcrumb{background:var(--bg-surface);border-bottom:1px solid var(--border-subtle);padding:14px 52px;margin-top:76px}\n.breadcrumb__inner{display:flex;align-items:center;gap:10px;font-family:var(--font-d);font-size:10px;font-weight:600;letter-spacing:.12em;text-transform:uppercase}\n.breadcrumb__link{color:var(--text-muted);text-decoration:none;transition:color .15s}\n.breadcrumb__link:hover{color:var(--gold-400)}\n.breadcrumb__sep{color:var(--text-muted);font-size:10px}\n.breadcrumb__current{color:var(--gold-500)}\n.dest-hero{position:relative;min-height:72vh;background:var(--navy-800);display:flex;align-items:center;justify-content:center;overflow:hidden;text-align:center}\n.dest-hero__bg{position:absolute;inset:0;background:var(--navy-800);display:flex;align-items:center;justify-content:center}\n.dest-hero__bg-ph{font-family:var(--font-d);font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:rgba(138,155,176,.2)}\n.dest-hero__watermark{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:min(500px,62vw);height:min(500px,62vw);object-fit:contain;opacity:.04;pointer-events:none}\n.dest-hero__overlay{position:absolute;inset:0;background:linear-gradient(180deg,rgba(8,15,26,.1) 0%,rgba(8,15,26,.4) 40%,rgba(8,15,26,.9) 100%)}\n.dest-hero__content{position:relative;z-index:1;padding:0 52px;max-width:800px}\n.dest-hero__headline{font-family:var(--font-d);font-size:clamp(36px,6vw,72px);font-weight:700;letter-spacing:-.03em;line-height:1.0;color:var(--cream-100);margin-bottom:20px;margin-top:14px}\n.dest-hero__sub{font-family:var(--font-b);font-size:17px;color:var(--silver-300);line-height:1.75;max-width:54ch;margin:0 auto 36px}\n.dest-hero__ctas{display:flex;gap:16px;justify-content:center;flex-wrap:wrap}\n.btn-primary-gold{display:inline-flex;align-items:center;gap:8px;font-family:var(--font-d);font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;background:var(--gold-500);color:var(--navy-900);padding:16px 36px;border:none;cursor:pointer;transition:all .15s;text-decoration:none}\n.btn-primary-gold:hover{background:var(--gold-400);box-shadow:0 0 32px rgba(201,168,76,.25)}\n.btn-ghost-gold{display:inline-flex;align-items:center;gap:8px;font-family:var(--font-d);font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;background:transparent;color:var(--cream-100);padding:15px 32px;border:1px solid rgba(255,255,255,.25);cursor:pointer;transition:all .15s;text-decoration:none}\n.btn-ghost-gold:hover{border-color:var(--gold-500);color:var(--gold-400)}\n.intro-section{display:grid;grid-template-columns:1fr 1fr;background:var(--bg-surface);border-bottom:1px solid var(--border-subtle)}\n.intro-content{padding:72px 64px}\n.intro-title{font-family:var(--font-d);font-size:clamp(24px,3vw,36px);font-weight:700;letter-spacing:-.02em;color:var(--text-primary);margin-bottom:24px}\n.intro-body{font-family:var(--font-b);font-size:15px;color:var(--text-secondary);line-height:1.8;margin-bottom:18px}\n.intro-image{background:var(--bg-card);position:relative;display:flex;align-items:center;justify-content:center;min-height:480px;font-family:var(--font-d);font-size:10px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:rgba(138,155,176,.25)}\n.intro-image-label{position:absolute;bottom:20px;left:24px;font-family:var(--font-d);font-size:9px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--gold-700)}\n.places-section{padding:72px 52px;background:var(--bg-page)}\n.places-grid{display:grid;grid-template-columns:repeat(3,1fr);grid-auto-rows:280px;gap:3px}\n.place-card{position:relative;overflow:hidden;cursor:pointer;background:var(--bg-card);display:flex;flex-direction:column;justify-content:flex-end;text-decoration:none}\n.place-card--featured{grid-column:span 2}\n.place-card__ph{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:var(--font-d);font-size:10px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:rgba(138,155,176,.25);transition:transform .5s cubic-bezier(.16,1,.3,1)}\n.place-card:hover .place-card__ph{transform:scale(1.04)}\n.place-card__overlay{position:absolute;inset:0;background:linear-gradient(0deg,rgba(8,15,26,.92) 0%,rgba(8,15,26,.2) 50%,transparent 100%);transition:opacity .3s}\n.place-card:hover .place-card__overlay{opacity:.7}\n.place-card__body{position:relative;z-index:1;padding:24px;border-top:1px solid transparent;transition:border-color .3s}\n.place-card:hover .place-card__body{border-color:rgba(201,168,76,.35)}\n.place-card__region{font-family:var(--font-d);font-size:9px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--gold-500);margin-bottom:6px}\n.place-card__name{font-family:var(--font-d);font-size:22px;font-weight:700;color:var(--cream-100);margin-bottom:8px}\n.place-card--featured .place-card__name{font-size:30px}\n.place-card__desc{font-family:var(--font-b);font-size:13px;color:var(--silver-300);line-height:1.55;margin-bottom:12px}\n.place-card__tags{display:flex;gap:6px;flex-wrap:wrap}\n.place-tag{font-family:var(--font-d);font-size:8px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;padding:3px 8px;background:rgba(201,168,76,.12);border:1px solid rgba(201,168,76,.25);color:var(--gold-400)}\n.place-card__arrow{position:absolute;bottom:24px;right:24px;z-index:2;font-family:var(--font-d);font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--gold-500);opacity:0;transition:opacity .2s}\n.place-card:hover .place-card__arrow{opacity:1}\n.itineraries-section{padding:72px 52px;background:var(--bg-surface);border-top:1px solid var(--border-subtle);border-bottom:1px solid var(--border-subtle)}\n.itineraries-grid{display:grid;grid-template-columns:1fr 1fr;gap:3px}\n.itin-card{display:grid;grid-template-columns:1fr 1fr;background:var(--bg-elevated);border:1px solid var(--border-subtle);overflow:hidden;transition:border-color .2s}\n.itin-card:hover{border-color:var(--border-gold)}\n.itin-image{min-height:260px;background:var(--bg-card);display:flex;align-items:center;justify-content:center;font-family:var(--font-d);font-size:9px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:rgba(138,155,176,.25);padding:16px;text-align:center}\n.itin-body{padding:32px 28px;display:flex;flex-direction:column;justify-content:center}\n.itin-duration{font-family:var(--font-d);font-size:9px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--gold-500);margin-bottom:8px}\n.itin-name{font-family:var(--font-d);font-size:18px;font-weight:700;letter-spacing:-.01em;color:var(--text-primary);line-height:1.2;margin-bottom:10px}\n.itin-desc{font-family:var(--font-b);font-size:13px;color:var(--text-secondary);line-height:1.65;margin-bottom:14px}\n.itin-meta{display:flex;gap:16px;margin-bottom:14px;font-family:var(--font-d);font-size:9px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--text-muted)}\n.itin-cta{font-family:var(--font-d);font-size:10px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--gold-500);display:inline-flex;align-items:center;gap:6px;background:none;border:none;cursor:pointer;padding:0;transition:gap .15s}\n.itin-cta:hover{gap:12px}\n.itin-cta::after{content:'\u2192'}\n.why-section{padding:72px 52px;background:var(--bg-page);border-bottom:1px solid var(--border-subtle)}\n.why-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:3px}\n.why-item{background:var(--bg-elevated);border:1px solid var(--border-subtle);padding:32px 28px;transition:border-color .2s}\n.why-item:hover{border-color:var(--border-gold)}\n.why-icon{width:44px;height:44px;border:1px solid var(--border-gold);display:flex;align-items:center;justify-content:center;margin-bottom:20px;color:var(--gold-500);font-size:18px}\n.why-title{font-family:var(--font-d);font-size:14px;font-weight:700;color:var(--text-primary);margin-bottom:8px}\n.why-desc{font-family:var(--font-b);font-size:13px;color:var(--text-secondary);line-height:1.6}\n.seasons-strip{background:var(--bg-surface);border-bottom:1px solid var(--border-subtle);padding:64px 52px}\n.seasons-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:3px}\n.season-item{padding:28px 28px;border:1px solid var(--border-subtle);background:var(--bg-elevated)}\n.season-item--best{border-color:var(--border-gold);background:var(--accent-subtle)}\n.season-name{font-family:var(--font-d);font-size:10px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--text-secondary);margin-bottom:8px}\n.season-item--best .season-name{color:var(--gold-500)}\n.season-months{font-family:var(--font-d);font-size:18px;font-weight:600;color:var(--text-primary);margin-bottom:10px}\n.season-desc{font-family:var(--font-b);font-size:13px;color:var(--text-muted);line-height:1.6}\n.season-badge{display:inline-block;margin-top:10px;font-family:var(--font-d);font-size:8px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;padding:4px 10px;background:var(--gold-500);color:var(--navy-900)}\n.testimonial-section{padding:80px 52px;background:var(--navy-800);border-bottom:1px solid var(--border-subtle);text-align:center}\n.testimonial-mark{font-family:var(--font-d);font-size:80px;font-weight:700;color:var(--gold-500);opacity:.2;line-height:1;margin-bottom:-20px}\n.testimonial-quote{font-family:var(--font-d);font-size:clamp(16px,2.2vw,22px);font-weight:400;font-style:italic;color:var(--cream-100);line-height:1.65;max-width:780px;margin:0 auto 24px}\n.testimonial-attr{font-family:var(--font-d);font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--gold-500)}\n.mark-note{padding:72px 52px;background:var(--bg-surface);border-bottom:1px solid var(--border-subtle)}\n.mark-note__grid{display:grid;grid-template-columns:auto 1fr;gap:48px;max-width:840px;margin:0 auto;align-items:start}\n.mark-note__photo{width:96px;height:96px;object-fit:contain;filter:drop-shadow(0 4px 16px rgba(201,168,76,.2));flex-shrink:0}\n.mark-note__name{font-family:var(--font-d);font-size:16px;font-weight:700;color:var(--gold-500);margin-bottom:2px}\n.mark-note__title{font-family:var(--font-b);font-size:12px;color:var(--text-muted);letter-spacing:.04em;margin-bottom:20px}\n.mark-note__quote{font-family:var(--font-b);font-size:15px;color:var(--text-secondary);line-height:1.8;font-style:italic}\n.dest-cta{padding:96px 52px;background:var(--bg-page);text-align:center;border-bottom:1px solid var(--border-subtle)}\n.dest-cta__title{font-family:var(--font-d);font-size:clamp(28px,3.5vw,44px);font-weight:700;letter-spacing:-.02em;color:var(--text-primary);margin-bottom:16px}\n.dest-cta__body{font-family:var(--font-b);font-size:16px;color:var(--text-secondary);line-height:1.7;max-width:52ch;margin:0 auto 36px}\n.dest-cta__note{font-family:var(--font-b);font-size:12px;color:var(--text-muted);margin-top:16px;letter-spacing:.04em}\n@media(max-width:900px){\n  .breadcrumb{padding:12px 28px}.intro-section{grid-template-columns:1fr}.intro-content{padding:48px 28px}.intro-image{min-height:280px;aspect-ratio:16/9}.places-grid{grid-template-columns:1fr 1fr}.place-card--featured{grid-column:span 2}.itineraries-grid{grid-template-columns:1fr}.itin-card{grid-template-columns:1fr}.itin-image{min-height:180px}.why-grid{grid-template-columns:repeat(2,1fr)}.seasons-grid{grid-template-columns:1fr}.mark-note__grid{grid-template-columns:1fr;text-align:center}.mark-note__photo{margin:0 auto}.places-section,.itineraries-section,.why-section,.seasons-strip,.testimonial-section,.mark-note,.dest-cta{padding-left:28px;padding-right:28px}.dest-hero__content{padding:0 28px}\n}\n@media(max-width:540px){\n  .places-grid{grid-template-columns:1fr;grid-auto-rows:240px}.place-card--featured{grid-column:span 1}.why-grid{grid-template-columns:1fr}\n}\n.page-faq{padding:80px 52px;background:var(--bg-surface);border-top:1px solid var(--border-subtle);border-bottom:1px solid var(--border-subtle)}\n.page-faq__header{max-width:640px;margin-bottom:48px}\n.page-faq__label{font-family:var(--font-d);font-size:10px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--gold-500);margin-bottom:12px}\n.page-faq__title{font-family:var(--font-d);font-size:clamp(24px,3vw,36px);font-weight:700;letter-spacing:-.02em;color:var(--text-primary);margin-bottom:16px}\n.page-faq__sub{font-family:var(--font-b);font-size:15px;color:var(--text-secondary);line-height:1.7}\n.pf-grid{display:grid;grid-template-columns:1fr 1fr;gap:3px}\n.pf-item{background:var(--bg-elevated);border:1px solid var(--border-subtle);transition:border-color .2s}\n.pf-item.open{border-color:var(--border-gold)}\n.pf-q{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;padding:24px 28px;cursor:pointer}\n.pf-q__text{font-family:var(--font-d);font-size:14px;font-weight:700;color:var(--text-primary);line-height:1.35}\n.pf-q__icon{width:28px;height:28px;flex-shrink:0;border:1px solid var(--border-subtle);display:flex;align-items:center;justify-content:center;color:var(--gold-500);font-size:18px;line-height:1;transition:transform .2s,border-color .2s;margin-top:2px}\n.pf-item.open .pf-q__icon{transform:rotate(45deg);border-color:var(--border-gold)}\n.pf-a{display:none;padding:0 28px 24px;font-family:var(--font-b);font-size:14px;color:var(--text-secondary);line-height:1.75}\n.pf-item.open .pf-a{display:block}\n.page-faq__more{margin-top:36px;display:flex;align-items:center;gap:12px}\n.page-faq__more-link{font-family:var(--font-d);font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--gold-500);text-decoration:none;display:inline-flex;align-items:center;gap:6px;transition:gap .15s}\n.page-faq__more-link:hover{gap:10px}\n.page-faq__more-link::after{content:'\u2192'}\n@media(max-width:768px){.pf-grid{grid-template-columns:1fr}.page-faq{padding:64px 28px}}\n";
---
<Base title="Portugal | Lisbon, Porto & the Douro Valley — Hit Your Mark Travel" description="Bespoke Portugal journeys — Lisbon's tasca culture, Porto's wine lodges, Douro Valley harvest, the slow Alentejo, and the western Algarve. Tables and quintas booked before you land." active="destinations" pageCss={pageCss}>
  <Fragment set:html={Content} />
</Base>
