---
import DestinationLayout from "../../../layouts/DestinationLayout.astro";
import Content from "../../../content-pages/destinations__europe.html?raw";
---
<DestinationLayout
  title="Europe — Hit Your Mark Travel"
  description="Italy, France, Spain, Portugal, Greece, and the United Kingdom. European travel planned around the specific places, guides, and access that most itineraries never reach — not the highlights, but the depth behind them."
  schemaType="website"
  name={"Europe"}
  hero={{
    image: "/assets/img/e-06-tuscan-landscape.jpg",
    eyebrow: "Europe",
    headline: "The Depth Is What<br>Most People Miss.",
    sub: "Italy, France, Spain, Portugal, and Greece contain some of the most traveled destinations in the world and some of the most overlooked ones. The difference between a European trip that checks boxes and one that stays with you for twenty years is almost always the same thing: knowing which version of each place you're actually getting.",
    ctaPrimary: { label: "Plan a Europe Trip", href: "/plan-your-trip/" },
    ctaSecondary: { label: "Explore Destinations ↓", href: "#places" },
    // Best For and Flight Time still need Mark: fill docs/hero-stat-rail-worksheet.csv.
    // Format follows destinations/maldives: value: "Honeymoons<br>&amp; Couples" and
    // value: "~10h from NYC<br>~9h from LHR". Do not estimate flight times.
    stats: [
      { label: "Best Season", value: "April – June &amp; September – October" },
    ],
  }}
>
  <Fragment set:html={Content} />
</DestinationLayout>
