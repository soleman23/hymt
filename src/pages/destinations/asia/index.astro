---
import DestinationLayout from "../../../layouts/DestinationLayout.astro";
import Content from "../../../content-pages/destinations__asia.html?raw";
---
<DestinationLayout
  title="Asia | Japan, Thailand & Bali — Hit Your Mark Travel"
  description="Japan, Bali, Thailand, Vietnam, India and Sri Lanka — planned around the guides, properties and windows that reveal the depth, not the surface."
  schemaType="website"
  name={"Asia"}
  hero={{
    image: "/assets/img/dh-02-asia-temple-valley.jpg",
    eyebrow: "Asia",
    headline: "Go Deep<br>or Go Home.",
    sub: "Asia contains more diversity — in culture, cuisine, landscape, and pace — than any other region in the world. A surface pass produces interesting photographs and a pleasant memory. Going deep produces something else entirely: a private tea ceremony in Kyoto, a pre-dawn market in Osaka, a Balinese healer in a ceremony village, a silk merchant in Hoi An whose family has been weaving for seven generations. The planning work is knowing which version you're getting.",
    ctaPrimary: { label: "Plan an Asia Trip", href: "/plan-your-trip/" },
    ctaSecondary: { label: "Explore Destinations ↓", href: "#places" },
    // Best For and Flight Time still need Mark: fill docs/hero-stat-rail-worksheet.csv.
    // Format follows destinations/maldives: value: "Honeymoons<br>&amp; Couples" and
    // value: "~10h from NYC<br>~9h from LHR". Do not estimate flight times.
    stats: [
      { label: "Best Season", value: "March – May &amp; October – November" },
    ],
  }}
>
  <Fragment set:html={Content} />
</DestinationLayout>
