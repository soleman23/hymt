---
import DestinationLayout from "../../../layouts/DestinationLayout.astro";
import Content from "../../../content-pages/destinations__greece.html?raw";
---
<DestinationLayout
  title="Greece | Aegean Islands & the Peloponnese — Hit Your Mark Travel"
  description="Athens, Santorini, Mykonos, Crete, the Peloponnese and Rhodes — archaeological access, island combinations, and the right property on each."
  schemaType="website"
  name={"Greece"}
  region={{ label: "Europe", href: "/destinations/europe/" }}
  hero={{
    image: "/assets/img/dh-07-greece-caldera-dusk.jpg",
    eyebrow: "Southern Europe",
    headline: "Where History and<br>Landscape Are<br>the Same Thing.",
    sub: "Greece is the destination where history is not separate from landscape — the temples stand on the headlands, the theaters are carved into the hillsides, and the harbors still look like what Odysseus left when he sailed for Troy. The work of planning Greece is choosing which version you want: the island archetype, the Peloponnese road trip, the Athens deep dive, or the combination that converts a Greek Islands postcard trip into something rarer.",
    ctaPrimary: { label: "Plan a Greece Trip", href: "/plan-your-trip/" },
    ctaSecondary: { label: "Explore Greece ↓", href: "#places" },
    // Best For and Flight Time still need Mark: fill docs/hero-stat-rail-worksheet.csv.
    // Format follows destinations/maldives: value: "Honeymoons<br>&amp; Couples" and
    // value: "~10h from NYC<br>~9h from LHR". Do not estimate flight times.
    stats: [
      { label: "Best Season", value: "September – October" },
    ],
  }}
>
  <Fragment set:html={Content} />
</DestinationLayout>
