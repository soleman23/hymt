    ctaPrimary: { label: "Plan a New Zealand Trip", href: "/plan-your-trip/" },
    ctaSecondary: { label: "Explore New Zealand ↓", href: "#places" },
    // Add { label: "Best For", value: "..." } and "Flight Time" as the copy is written.
