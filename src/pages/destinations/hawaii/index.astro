---
import DestinationLayout from "../../../layouts/DestinationLayout.astro";
import Content from "../../../content-pages/destinations__hawaii.html?raw";
---
<DestinationLayout
  title="Hawaii | Maui, Kauai & the Big Island — Hit Your Mark Travel"
  description="Maui, Kauai, the Big Island and Lanai — island selection, inter-island sequencing, and the experiences that make it more than a beach trip."
  schemaType="website"
  name={"Hawaii"}
  region={{ label: "North America", href: "/destinations/north-america/" }}
  hero={{
    image: "/assets/img/dh-08-hawaii-napali-coast.jpg",
    eyebrow: "North America",
    headline: "Not All Islands<br>Are Created Equal.",
    sub: "Maui and Kauai are essentially different destinations. The Big Island and Oahu have almost nothing in common beyond the state name. Most travelers choose the wrong island for what they actually want — and then think they've done Hawaii. The planning work here starts with one question before anything else: which island, and why.",
    ctaPrimary: { label: "Plan a Hawaii Trip", href: "/plan-your-trip/" },
    ctaSecondary: { label: "Explore the Islands ↓", href: "#places" },
    // Best For and Flight Time still need Mark: fill docs/hero-stat-rail-worksheet.csv.
    // Format follows destinations/maldives: value: "Honeymoons<br>&amp; Couples" and
    // value: "~10h from NYC<br>~9h from LHR". Do not estimate flight times.
    stats: [
      { label: "Best Season", value: "April – June" },
    ],
  }}
>
  <Fragment set:html={Content} />
</DestinationLayout>
