---
import DestinationLayout from "../../../layouts/DestinationLayout.astro";
import Content from "../../../content-pages/destinations__bali.html?raw";
---
<DestinationLayout
  title="Bali | Ubud, Komodo & the Nusa Islands — Hit Your Mark Travel"
  description="Ubud, Sidemen Valley, the Nusa Islands, Komodo and Lombok — Bali's rice terrace culture and the surrounding islands most visitors never reach."
  schemaType="website"
  name={"Bali"}
  region={{ label: "Asia", href: "/destinations/asia/" }}
  hero={{
    image: "/assets/img/e-09-jungle-yoga-pavilion.jpg",
    eyebrow: "Southeast Asia",
    headline: "Spiritual Geography.<br>Real Depth.",
    sub: "Bali has a spiritual geography — a system of orientation between the mountains and the sea that shapes every compound, every temple, every ceremony on the island. Most visitors experience the island's beauty without understanding what underlies it. The ones who arrive with the right guide understand why the rice terraces are laid out the way they are, why every offering is placed where it is placed, and why the Balinese relationship to daily ceremony is not performance but practice.",
    ctaPrimary: { label: "Plan a Bali Trip", href: "/plan-your-trip/" },
    ctaSecondary: { label: "Explore Bali ↓", href: "#places" },
    // Best For and Flight Time still need Mark: fill docs/hero-stat-rail-worksheet.csv.
    // Format follows destinations/maldives: value: "Honeymoons<br>&amp; Couples" and
    // value: "~10h from NYC<br>~9h from LHR". Do not estimate flight times.
    stats: [
      { label: "Best Season", value: "May – October" },
    ],
  }}
>
  <Fragment set:html={Content} />
</DestinationLayout>
