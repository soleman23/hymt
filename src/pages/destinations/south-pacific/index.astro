---
import DestinationLayout from "../../../layouts/DestinationLayout.astro";
import Content from "../../../content-pages/destinations__south-pacific.html?raw";
---
<DestinationLayout
  title="South Pacific — Hit Your Mark Travel"
  description="French Polynesia, Fiji, New Zealand, Australia and the Cook Islands — the overwater villas, private islands and landscapes worth the distance."
  schemaType="website"
  name={"South Pacific"}
  hero={{
    image: "/assets/img/d-03-bora-bora-otemanu.jpg",
    eyebrow: "South Pacific",
    headline: "The Distance Is Real.<br>So Is the Payoff.",
    sub: "The South Pacific requires a commitment — a long flight, a genuine time zone shift, and a willingness to be genuinely far from home. What it offers in return is water that doesn't look real in photographs and turns out to be exactly that color, landscapes that have no comparison anywhere else on earth, and a pace of travel that the closer destinations can't replicate.",
    ctaPrimary: { label: "Plan a South Pacific Trip", href: "/plan-your-trip/" },
    ctaSecondary: { label: "Explore Destinations ↓", href: "#places" },
    // Best For and Flight Time still need Mark: fill docs/hero-stat-rail-worksheet.csv.
    // Format follows destinations/maldives: value: "Honeymoons<br>&amp; Couples" and
    // value: "~10h from NYC<br>~9h from LHR". Do not estimate flight times.
    stats: [
      { label: "Best Season", value: "May – October" },
    ],
  }}
>
  <Fragment set:html={Content} />
</DestinationLayout>
