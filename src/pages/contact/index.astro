---
import Base from "../../layouts/Base.astro";
import Content from "../../content-pages/contact.html?raw";
import { breadcrumbs, webPage } from "../../lib/schema";

const SITE = (Astro.site?.href ?? "https://www.hymtravel.com/").replace(/\/$/, "");
const description =
  "Get in touch with Mark Sole, Founder & Travel Director at Hit Your Mark Travel. Call, email, or send a message — we respond within 24 hours.";
const schema = [
  webPage(SITE, { type: "ContactPage", name: "Contact", description, path: "/contact/" }),
  breadcrumbs(SITE, [{ name: "Home", path: "/" }, { name: "Contact" }]),
];
const pageCss = "\n/* \u2500\u2500 CONTACT PAGE \u2500\u2500 */\n\n.page-hero {\n  position:relative;min-height:42vh;margin-top:76px;\n  background:var(--navy-800);display:flex;align-items:flex-end;overflow:hidden;\n}\n.page-hero__watermark {\n  position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);\n  width:min(400px,50vw);height:min(400px,50vw);object-fit:contain;\n  opacity:.04;pointer-events:none;\n}\n.page-hero__overlay {\n  position:absolute;inset:0;\n  background:linear-gradient(180deg,rgba(8,15,26,0) 0%,rgba(8,15,26,.5) 50%,rgba(8,15,26,.94) 100%);\n}\n.page-hero__content {\n  position:relative;z-index:1;width:100%;padding:0 52px 56px;\n}\n.page-hero__headline {\n  font-family:var(--font-d);font-size:clamp(32px,5vw,56px);font-weight:700;\n  letter-spacing:-.03em;line-height:1.0;color:var(--cream-100);margin-bottom:12px;margin-top:10px;\n}\n.page-hero__sub {\n  font-family:var(--font-b);font-size:16px;color:var(--silver-300);\n  line-height:1.7;max-width:52ch;\n}\n\n/* MAIN CONTACT LAYOUT */\n.contact-main {\n  display:grid;grid-template-columns:5fr 7fr;\n  background:var(--bg-surface);border-bottom:1px solid var(--border-subtle);\n}\n.contact-info { padding:72px 60px;border-right:1px solid var(--border-subtle) }\n.contact-form-col { padding:72px 60px }\n\n/* CONTACT INFO */\n.contact-photo {\n  width:100%;aspect-ratio:3/4;background:var(--bg-card);\n  display:flex;align-items:center;justify-content:center;margin-bottom:32px;\n  font-family:var(--font-d);font-size:10px;font-weight:600;\n  letter-spacing:.14em;text-transform:uppercase;color:rgba(138,155,176,.3);\n}\n.contact-name {\n  font-family:var(--font-d);font-size:24px;font-weight:700;\n  letter-spacing:-.01em;color:var(--text-primary);margin-bottom:4px;\n}\n.contact-title {\n  font-family:var(--font-d);font-size:10px;font-weight:700;\n  letter-spacing:.2em;text-transform:uppercase;color:var(--gold-500);\n  margin-bottom:28px;\n}\n.contact-intro {\n  font-family:var(--font-b);font-size:14px;color:var(--text-secondary);\n  line-height:1.75;margin-bottom:32px;\n}\n.contact-divider { height:1px;background:var(--border-subtle);margin-bottom:28px }\n.contact-methods { display:flex;flex-direction:column;gap:0 }\n.contact-method {\n  display:flex;align-items:flex-start;gap:16px;\n  padding:16px 0;border-bottom:1px solid var(--border-subtle);\n}\n.contact-method:last-child { border-bottom:none }\n.contact-method-label {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.2em;text-transform:uppercase;color:var(--gold-500);\n  width:52px;flex-shrink:0;margin-top:2px;\n}\n.contact-method-val {\n  font-family:var(--font-b);font-size:14px;line-height:1.5;\n}\n.contact-method-val a { color:var(--text-primary);transition:color .15s }\n.contact-method-val a:hover { color:var(--gold-400) }\n.contact-method-val small {\n  display:block;font-size:11px;color:var(--text-muted);margin-top:2px;\n}\n\n/* CONTACT FORM */\n.form-title {\n  font-family:var(--font-d);font-size:clamp(22px,2.5vw,30px);font-weight:700;\n  letter-spacing:-.02em;color:var(--text-primary);margin-bottom:8px;\n}\n.form-sub {\n  font-family:var(--font-b);font-size:14px;color:var(--text-secondary);\n  line-height:1.65;margin-bottom:36px;max-width:44ch;\n}\n.cf { margin-bottom:20px }\n.cf label {\n  display:block;font-family:var(--font-d);font-size:10px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;color:var(--text-secondary);\n  margin-bottom:8px;\n}\n.cf input,.cf textarea,.cf select {\n  width:100%;padding:14px 16px;\n  background:var(--bg-elevated);border:1px solid var(--border-subtle);\n  font-family:var(--font-b);font-size:14px;color:var(--text-primary);\n  outline:none;transition:border-color .15s;\n}\n.cf input::placeholder,.cf textarea::placeholder { color:var(--text-muted) }\n.cf input:focus,.cf textarea:focus,.cf select:focus { border-color:var(--gold-500) }\n.cf textarea { min-height:120px;resize:vertical;font-family:var(--font-b) }\n.cf-row { display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px }\n.cf-row .cf { margin-bottom:0 }\n.cf-submit {\n  width:100%;padding:16px;\n  background:var(--gold-500);color:var(--navy-900);border:none;\n  font-family:var(--font-d);font-size:11px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;\n  cursor:pointer;transition:all .15s;margin-top:8px;\n}\n.cf-submit:hover { background:var(--gold-400);box-shadow:0 0 24px rgba(201,168,76,.2) }\n.cf-note {\n  font-family:var(--font-b);font-size:11px;color:var(--text-muted);\n  margin-top:12px;line-height:1.5;\n}\n.cf-success {\n  display:none;padding:32px;background:var(--accent-subtle);\n  border:1px solid var(--border-gold);text-align:center;\n}\n.cf-success.show { display:block }\n.cf-success-title {\n  font-family:var(--font-d);font-size:18px;font-weight:700;\n  color:var(--text-primary);margin-bottom:8px;\n}\n.cf-success-body {\n  font-family:var(--font-b);font-size:14px;color:var(--text-secondary);line-height:1.6;\n}\n\n/* HOURS STRIP */\n.hours-strip {\n  padding:56px 52px;background:var(--bg-page);\n  border-bottom:1px solid var(--border-subtle);\n  display:grid;grid-template-columns:1fr 1fr 1fr;gap:3px;\n}\n.hours-item {\n  background:var(--bg-elevated);border:1px solid var(--border-subtle);padding:28px 32px;\n}\n.hours-label {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.2em;text-transform:uppercase;color:var(--gold-500);\n  margin-bottom:8px;display:block;\n}\n.hours-val {\n  font-family:var(--font-d);font-size:16px;font-weight:600;\n  color:var(--text-primary);margin-bottom:4px;\n}\n.hours-note {\n  font-family:var(--font-b);font-size:12px;color:var(--text-muted);line-height:1.5;\n}\n\n/* FAQ */\n.faq-section {\n  padding:80px 52px;background:var(--bg-surface);\n  border-bottom:1px solid var(--border-subtle);\n}\n.faq-header { margin-bottom:48px }\n.faq-title {\n  font-family:var(--font-d);font-size:clamp(24px,2.8vw,36px);font-weight:700;\n  letter-spacing:-.02em;color:var(--text-primary);margin-bottom:10px;\n}\n.faq-sub {\n  font-family:var(--font-b);font-size:15px;color:var(--text-secondary);\n  line-height:1.65;max-width:52ch;\n}\n.faq-grid { display:grid;grid-template-columns:1fr 1fr;gap:3px }\n.faq-item {\n  background:var(--bg-elevated);border:1px solid var(--border-subtle);\n  padding:32px 36px;cursor:pointer;transition:border-color .15s;\n}\n.faq-item:hover { border-color:var(--border-gold) }\n.faq-q-h { margin:0;font:inherit }\n.faq-q {\n  font-family:var(--font-d);font-size:15px;font-weight:700;\n  letter-spacing:-.01em;color:var(--text-primary);margin-bottom:12px;\n  display:flex;align-items:flex-start;justify-content:space-between;gap:16px;\n  width:100%;background:none;border:none;padding:0;text-align:left;\n  cursor:pointer;appearance:none;-webkit-appearance:none;\n}\n.faq-q::after {\n  content:'+';font-size:18px;font-weight:300;color:var(--gold-500);\n  flex-shrink:0;line-height:1;transition:transform .2s;\n}\n.faq-item.open .faq-q::after { transform:rotate(45deg) }\n.faq-a {\n  font-family:var(--font-b);font-size:14px;color:var(--text-secondary);\n  line-height:1.75;padding-top:4px;\n}\n.js-accordion .faq-a { display:none }\n.js-accordion .faq-item.open .faq-a { display:block }\n\n/* SOCIAL */\n.social-strip {\n  padding:64px 52px;background:var(--bg-page);\n  display:grid;grid-template-columns:1fr auto;gap:48px;align-items:center;\n}\n.social-strip__title {\n  font-family:var(--font-d);font-size:clamp(20px,2.5vw,28px);font-weight:700;\n  letter-spacing:-.01em;color:var(--text-primary);margin-bottom:8px;\n}\n.social-strip__sub {\n  font-family:var(--font-b);font-size:14px;color:var(--text-secondary);line-height:1.6;\n}\n.social-links { display:flex;gap:3px }\n.social-link {\n  display:flex;align-items:center;gap:10px;padding:14px 20px;\n  background:var(--bg-elevated);border:1px solid var(--border-subtle);\n  font-family:var(--font-d);font-size:10px;font-weight:700;\n  letter-spacing:.14em;text-transform:uppercase;color:var(--text-secondary);\n  text-decoration:none;transition:all .15s;white-space:nowrap;\n}\n.social-link:hover { border-color:var(--border-gold);color:var(--gold-400) }\n\n@media(max-width:900px){\n  .contact-main { grid-template-columns:1fr }\n  .contact-info { border-right:none;border-bottom:1px solid var(--border-subtle);padding:48px 28px }\n  .contact-form-col { padding:48px 28px }\n  .contact-photo { aspect-ratio:16/9 }\n  .hours-strip { grid-template-columns:1fr;padding:40px 28px }\n  .faq-grid { grid-template-columns:1fr }\n  .social-strip { grid-template-columns:1fr;gap:28px;padding:48px 28px }\n  .faq-section { padding:64px 28px }\n}\n";
---
<Base title="Contact — Hit Your Mark Travel" description={description} active="contact" pageCss={pageCss} schemaType="website" schema={schema}>
  <Fragment set:html={Content} />
</Base>
