---
import Base from "../../layouts/Base.astro";
import Content from "../../content-pages/experiences.html?raw";
import { breadcrumbs, collection } from "../../lib/schema";

/* P2-5: CollectionPage + ItemList of the 12 experience pages. Discovered
   from the filesystem; the name map restores the punctuation the slugs
   flatten (every experience name carries an ampersand or hyphen). */
const SITE = (Astro.site?.href ?? "https://www.hymtravel.com/").replace(/\/$/, "");
const description =
  "Twelve luxury travel experiences — beach escapes, family and multigenerational trips, adventure, wellness, food and wine, cruises, safari and sport.";
const NAMES: Record<string, string> = {
  "adventure-active-travel": "Adventure & Active Travel",
  "all-inclusive-vacations": "All-Inclusive Vacations",
  "beach-island-escapes": "Beach & Island Escapes",
  "cruises": "Cruises",
  "culture-immersive-travel": "Culture & Immersive Travel",
  "family-travel": "Family Travel",
  "food-wine-travel": "Food & Wine Travel",
  "multigenerational-travel": "Multigenerational Travel",
  "romance-celebration-travel": "Romance & Celebration Travel",
  "safari-wildlife-travel": "Safari & Wildlife Travel",
  "sports-event-travel": "Sports & Event Travel",
  "wellness-retreat-travel": "Wellness & Retreat Travel",
};
/* The ItemList has to match the order a visitor reads the cards in, so the
   card order lives here rather than falling out of the alphabetical glob.
   A slug missing from ORDER still ships — it sorts in alphabetically after
   the listed ones, so adding a page can never drop it from the schema. */
const ORDER = [
  "sports-event-travel",
  "beach-island-escapes",
  "all-inclusive-vacations",
  "family-travel",
  "multigenerational-travel",
  "adventure-active-travel",
  "wellness-retreat-travel",
  "culture-immersive-travel",
  "food-wine-travel",
  "cruises",
  "romance-celebration-travel",
  "safari-wildlife-travel",
];
const rank = (s: string) => {
  const i = ORDER.indexOf(s);
  return i === -1 ? ORDER.length : i;
};
const children = Object.keys(import.meta.glob("./*/index.astro"))
  .map((p) => p.replace("./", "").replace("/index.astro", ""))
  .sort((a, b) => rank(a) - rank(b) || a.localeCompare(b));
const schema = [
  collection(SITE, {
    name: "Experiences",
    description,
    path: "/experiences/",
    items: children.map((s) => ({
      name: NAMES[s] ?? s.split("-").map((w) => w[0].toUpperCase() + w.slice(1)).join(" "),
      path: `/experiences/${s}/`,
    })),
  }),
  breadcrumbs(SITE, [{ name: "Home", path: "/" }, { name: "Experiences" }]),
];
const pageCss = "\n/* \u2500\u2500 EXPERIENCES PAGE EXTRAS \u2500\u2500 */\n\n/* PAGE HERO */\n.page-hero {\n  position:relative;min-height:52vh;margin-top:76px;\n  background:var(--navy-800);display:flex;align-items:flex-end;overflow:hidden;\n}\n.page-hero__bg {\n  position:absolute;inset:0;background:var(--navy-800);\n  display:flex;align-items:center;justify-content:center;\n}\n.page-hero__watermark {\n  position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);\n  width:min(460px,58vw);height:min(460px,58vw);object-fit:contain;\n  opacity:.04;pointer-events:none;\n}\n.page-hero__overlay {\n  position:absolute;inset:0;\n  background:linear-gradient(180deg,rgba(8,15,26,0) 0%,rgba(8,15,26,.55) 55%,rgba(8,15,26,.94) 100%);\n}\n.page-hero__content {\n  position:relative;z-index:1;width:100%;padding:0 52px 64px;\n}\n.page-hero__headline {\n  font-family:var(--font-d);font-size:clamp(32px,5vw,60px);font-weight:700;\n  letter-spacing:-.03em;line-height:1.0;color:var(--cream-100);margin-bottom:14px;margin-top:12px;\n}\n.page-hero__sub {\n  font-family:var(--font-b);font-size:17px;color:var(--silver-300);\n  line-height:1.7;max-width:54ch;\n}\n\n/* EXPERIENCE GRID */\n.exp-section { padding:72px 52px;background:var(--bg-page) }\n.exp-grid {\n  display:grid;grid-template-columns:repeat(3,1fr);gap:3px;\n}\n.exp-card {\n  background:var(--bg-elevated);border:1px solid var(--border-subtle);\n  padding:44px 40px;display:flex;flex-direction:column;\n  transition:border-color .2s,box-shadow .2s;position:relative;overflow:hidden;\n}\n.exp-card:hover { border-color:var(--border-gold);box-shadow:0 0 32px rgba(201,168,76,.08) }\n.exp-card__cat { margin-bottom:14px }\n.exp-card__title {\n  font-family:var(--font-d);font-size:22px;font-weight:700;\n  letter-spacing:-.01em;color:var(--text-primary);margin-bottom:14px;line-height:1.2;\n}\n.exp-card__body {\n  font-family:var(--font-b);font-size:14px;color:var(--text-secondary);\n  line-height:1.75;margin-bottom:20px;flex:1;\n}\n.exp-card__dests {\n  margin-bottom:28px;\n}\n.exp-card__dests-label {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.2em;text-transform:uppercase;color:var(--text-muted);\n  margin-bottom:8px;display:block;\n}\n.exp-card__tags { display:flex;flex-wrap:wrap;gap:6px }\n.exp-tag {\n  font-family:var(--font-b);font-size:11px;color:var(--silver-300);\n  padding:4px 10px;background:var(--bg-card);\n  border:1px solid var(--border-subtle);\n}\n.exp-card__cta {\n  display:inline-flex;align-items:center;gap:8px;align-self:flex-start;\n  font-family:var(--font-d);font-size:10px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;color:var(--gold-500);\n  transition:gap .15s;background:none;border:none;cursor:pointer;padding:0;\n}\n.exp-card__cta:hover { gap:14px }\n.exp-card__cta::after { content:'\u2192' }\n\n/* FEATURED EXPERIENCE */\n.exp-featured {\n  background:var(--bg-surface);border-top:1px solid var(--border-subtle);\n  border-bottom:1px solid var(--border-subtle);\n}\n.exp-featured__grid {\n  display:grid;grid-template-columns:1fr 1fr;min-height:560px;\n}\n.exp-featured__image {\n  background:var(--bg-card);position:relative;\n  display:flex;align-items:center;justify-content:center;min-height:420px;\n}\n.exp-featured__image-ph {\n  font-family:var(--font-d);font-size:10px;font-weight:600;\n  letter-spacing:.16em;text-transform:uppercase;color:rgba(138,155,176,.3);\n  text-align:center;padding:24px;\n}\n.exp-featured__content {\n  padding:64px 60px;display:flex;flex-direction:column;justify-content:center;\n}\n.exp-featured__title {\n  font-family:var(--font-d);font-size:clamp(26px,3vw,40px);font-weight:700;\n  letter-spacing:-.02em;line-height:1.1;color:var(--text-primary);margin-bottom:18px;\n}\n.exp-featured__body {\n  font-family:var(--font-b);font-size:16px;color:var(--text-secondary);\n  line-height:1.8;max-width:48ch;margin-bottom:16px;\n}\n.exp-featured__tags { display:flex;flex-wrap:wrap;gap:8px;margin-bottom:36px }\n.exp-featured__cta {\n  display:inline-flex;align-items:center;gap:10px;align-self:flex-start;\n  font-family:var(--font-d);font-size:11px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;\n  background:var(--gold-500);color:var(--navy-900);\n  padding:15px 32px;border:none;cursor:pointer;transition:all .15s;\n}\n.exp-featured__cta:hover { background:var(--gold-400);box-shadow:0 0 28px rgba(201,168,76,.25) }\n\n/* PLANNING STRIP */\n.planning-strip {\n  padding:80px 52px;background:var(--bg-page);\n  border-bottom:1px solid var(--border-subtle);\n  display:grid;grid-template-columns:1fr auto;gap:64px;align-items:center;\n}\n.planning-strip__title {\n  font-family:var(--font-d);font-size:clamp(24px,3vw,36px);font-weight:700;\n  letter-spacing:-.02em;color:var(--text-primary);margin-bottom:12px;\n}\n.planning-strip__body {\n  font-family:var(--font-b);font-size:15px;color:var(--text-secondary);\n  line-height:1.7;max-width:52ch;\n}\n.planning-strip__cta {\n  display:inline-flex;align-items:center;gap:10px;flex-shrink:0;\n  font-family:var(--font-d);font-size:11px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;\n  border:1px solid var(--gold-500);color:var(--gold-500);\n  background:transparent;padding:15px 32px;cursor:pointer;transition:all .15s;\n}\n.planning-strip__cta:hover { background:var(--gold-500);color:var(--navy-900) }\n\n/* RESPONSIVE */\n@media (max-width:900px) {\n  .exp-grid { grid-template-columns:1fr }\n  .exp-featured__grid { grid-template-columns:1fr }\n  .planning-strip { grid-template-columns:1fr;gap:28px }\n  .page-hero__content,.exp-section,.planning-strip { padding-left:28px;padding-right:28px }\n}\n";
---
<Base title="Experiences — Hit Your Mark Travel" description={description} active="experiences" pageCss={pageCss} schemaType="website" schema={schema}>
  <Fragment set:html={Content} />
</Base>
