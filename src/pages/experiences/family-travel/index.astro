---
import ExperienceLayout from "../../../layouts/ExperienceLayout.astro";
import Content from "../../../content-pages/experiences__family-travel.html?raw";
---
<ExperienceLayout
  title="Family Travel — Hit Your Mark Travel"
  description="Mexico, Costa Rica, Hawaii and Europe — family travel planned around how families actually travel, not adult itineraries with children added on."
  schemaType="website"
  name={"Family Travel"}
  hero={{
    image: "/assets/img/e-16-safari-vehicle-sunrise.jpg",
    eyebrow: "Traveling with Kids",
    headline: "Family Travel<br>That Works",
    sub: "Family travel has different failure points than adult travel. The flight timing, the room configuration, the beach entry, the pace of the itinerary — get these right and the trip runs. Miss one and it doesn't matter how good the destination is.",
    ctaPrimary: { label: "Plan a Family Trip", href: "/plan-your-trip/" },
    ctaSecondary: { label: "Explore Destinations ↓", href: "#destinations" },
  }}
>
  <Fragment set:html={Content} />
</ExperienceLayout>
