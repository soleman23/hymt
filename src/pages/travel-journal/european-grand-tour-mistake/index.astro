const pageCss = "\n.post-hero {\n  position:relative;min-height:70vh;margin-top:76px;\n  background:var(--navy-800);display:flex;align-items:flex-end;overflow:hidden;\n}\n.post-hero__bg {\n  position:absolute;inset:0;background:var(--navy-800);\n  display:flex;align-items:center;justify-content:center;\n}\n.post-hero__bg-ph {\n  font-family:var(--font-d);font-size:11px;font-weight:600;\n  letter-spacing:.18em;text-transform:uppercase;color:rgba(138,155,176,.25);\n  text-align:center;padding:24px;\n}\n.post-hero__watermark {\n  position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);\n  width:min(440px,55vw);height:min(440px,55vw);object-fit:contain;opacity:.04;pointer-events:none;\n}\n.post-hero__overlay {\n  position:absolute;inset:0;\n  background:linear-gradient(180deg,rgba(8,15,26,.1) 0%,rgba(8,15,26,.5) 45%,rgba(8,15,26,.95) 100%);\n}\n.post-hero__content { position:relative;z-index:1;width:100%;padding:0 52px 72px;max-width:900px }\n.post-hero__meta { display:flex;align-items:center;gap:20px;margin-bottom:20px;flex-wrap:wrap }\n.post-hero__cat { font-family:var(--font-d);font-size:9px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--gold-500) }\n.post-hero__dot { width:3px;height:3px;background:var(--silver-400);border-radius:50% }\n.post-hero__date { font-family:var(--font-b);font-size:12px;color:var(--silver-400) }\n.post-hero__read { font-family:var(--font-b);font-size:12px;color:var(--silver-400) }\n.post-hero__headline {\n  font-family:var(--font-d);font-size:clamp(28px,5vw,58px);font-weight:700;\n  letter-spacing:-.03em;line-height:1.05;color:var(--cream-100);margin-bottom:20px;\n}\n.post-hero__deck { font-family:var(--font-b);font-size:18px;color:var(--silver-300);line-height:1.65;max-width:56ch }\n.breadcrumb {\n  padding:18px 52px;background:var(--bg-surface);border-bottom:1px solid var(--border-subtle);\n  display:flex;align-items:center;gap:10px;\n}\n.breadcrumb a, .breadcrumb span {\n  font-family:var(--font-d);font-size:10px;font-weight:600;\n  letter-spacing:.14em;text-transform:uppercase;color:var(--text-muted);transition:color .15s;text-decoration:none;\n}\n.breadcrumb a:hover { color:var(--gold-400) }\n.breadcrumb__sep { color:var(--text-muted);font-size:12px;opacity:.5 }\n.breadcrumb__current { color:var(--text-secondary) }\n.post-layout {\n  display:grid;grid-template-columns:1fr min(720px,100%) 1fr;\n  background:var(--bg-page);padding:80px 0;\n}\n.post-layout > * { grid-column:2 }\n.post-byline {\n  display:flex;align-items:center;gap:18px;\n  padding-bottom:36px;margin-bottom:40px;border-bottom:1px solid var(--border-subtle);\n}\n.post-byline__avatar {\n  width:48px;height:48px;border-radius:50%;background:var(--bg-card);\n  border:1px solid var(--border-gold);flex-shrink:0;display:flex;align-items:center;justify-content:center;\n}\n.post-byline__avatar-ph { font-family:var(--font-d);font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--gold-700) }\n.post-byline__info { display:flex;flex-direction:column;gap:3px }\n.post-byline__name { font-family:var(--font-d);font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--text-primary) }\n.post-byline__role { font-family:var(--font-b);font-size:12px;color:var(--text-muted) }\n.post-byline__share { margin-left:auto;display:flex;align-items:center;gap:12px }\n.post-byline__share-label { font-family:var(--font-d);font-size:9px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--text-muted) }\n.share-btn {\n  width:34px;height:34px;display:flex;align-items:center;justify-content:center;\n  border:1px solid var(--border-subtle);background:transparent;cursor:pointer;\n  color:var(--silver-400);transition:all .15s;\n}\n.share-btn:hover { border-color:var(--border-gold);color:var(--gold-400) }\n.share-btn svg { width:14px;height:14px }\n.post-body { font-family:var(--font-b);font-size:17px;color:var(--text-secondary);line-height:1.8 }\n.post-body p { margin-bottom:24px }\n.post-body p:last-child { margin-bottom:0 }\n.post-body h2 {\n  font-family:var(--font-d);font-size:clamp(20px,2.5vw,28px);font-weight:700;\n  letter-spacing:-.02em;color:var(--text-primary);margin:52px 0 18px;line-height:1.15;\n}\n.post-body strong { color:var(--text-primary);font-weight:600 }\n.post-body ul { padding-left:0;list-style:none;margin-bottom:24px;display:flex;flex-direction:column;gap:10px }\n.post-body ul li { font-size:16px;color:var(--text-secondary);line-height:1.7;padding-left:20px;position:relative }\n.post-body ul li::before { content:'';position:absolute;left:0;top:11px;width:5px;height:1px;background:var(--gold-500) }\n.post-pullquote { border-left:2px solid var(--gold-500);padding:8px 0 8px 32px;margin:44px 0 }\n.post-pullquote p {\n  font-family:var(--font-d);font-size:clamp(18px,2vw,24px);font-weight:600;\n  font-style:italic;letter-spacing:-.01em;line-height:1.4;color:var(--text-primary);margin-bottom:0;\n}\n.post-callout {\n  background:var(--bg-elevated);border:1px solid var(--border-gold);padding:32px 36px;margin:40px 0;\n}\n.post-callout__label { font-family:var(--font-d);font-size:9px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--gold-500);margin-bottom:14px;display:block }\n.post-callout p { font-family:var(--font-b);font-size:15px;color:var(--text-secondary);line-height:1.7;margin-bottom:0 }\n.post-divider { border:none;border-top:1px solid var(--border-subtle);margin:56px 0 }\n.post-footer {\n  padding-top:40px;border-top:1px solid var(--border-subtle);\n  display:flex;align-items:flex-start;justify-content:space-between;gap:40px;flex-wrap:wrap;\n}\n.post-footer__tags { display:flex;gap:8px;flex-wrap:wrap;align-items:center }\n.post-footer__tags-label { font-family:var(--font-d);font-size:9px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--text-muted);margin-right:4px }\n.post-tag { font-family:var(--font-d);font-size:9px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;border:1px solid var(--border-subtle);color:var(--text-muted);padding:6px 14px }\n.post-footer__share { display:flex;align-items:center;gap:10px }\n.post-footer__share-label { font-family:var(--font-d);font-size:9px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--text-muted) }\n.author-card { background:var(--bg-surface);border-top:1px solid var(--border-subtle);border-bottom:1px solid var(--border-subtle);padding:64px 52px }\n.author-card__inner { max-width:720px;margin:0 auto;display:grid;grid-template-columns:80px 1fr;gap:32px;align-items:start }\n.author-card__photo { width:80px;height:80px;border-radius:50%;background:var(--bg-card);border:1px solid var(--border-gold);display:flex;align-items:center;justify-content:center }\n.author-card__photo-ph { font-family:var(--font-d);font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--gold-700);text-align:center;padding:8px }\n.author-card__label { margin-bottom:6px }\n.author-card__name { font-family:var(--font-d);font-size:22px;font-weight:700;letter-spacing:-.01em;color:var(--text-primary);margin-bottom:4px }\n.author-card__title { font-family:var(--font-d);font-size:10px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--gold-500);margin-bottom:16px }\n.author-card__bio { font-family:var(--font-b);font-size:14px;color:var(--text-secondary);line-height:1.75;margin-bottom:20px;max-width:52ch }\n.author-card__cta { display:inline-flex;align-items:center;gap:8px;font-family:var(--font-d);font-size:10px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--gold-500);text-decoration:none;transition:gap .15s }\n.author-card__cta:hover { gap:14px }\n.author-card__cta::after { content:'\u2192' }\n.related { padding:80px 52px;background:var(--bg-page);border-top:1px solid var(--border-subtle) }\n.related__header { display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:40px }\n.related__title { font-family:var(--font-d);font-size:clamp(20px,2vw,28px);font-weight:700;letter-spacing:-.02em;color:var(--text-primary);margin-top:10px }\n.related__all { font-family:var(--font-d);font-size:10px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--gold-500);display:inline-flex;align-items:center;gap:6px;transition:gap .15s;white-space:nowrap;text-decoration:none }\n.related__all:hover { gap:12px }\n.related__all::after { content:'\u2192' }\n.related__grid { display:grid;grid-template-columns:repeat(3,1fr);gap:3px }\n.article-card { background:var(--bg-elevated);border:1px solid var(--border-subtle);display:flex;flex-direction:column;overflow:hidden;transition:border-color .2s;text-decoration:none }\n.article-card:hover { border-color:var(--border-gold) }\n.article-card__image { height:200px;background:var(--bg-card);overflow:hidden;position:relative }\n.article-card__image-inner { width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-family:var(--font-d);font-size:9px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:rgba(138,155,176,.3);transition:transform .4s cubic-bezier(.16,1,.3,1) }\n.article-card:hover .article-card__image-inner { transform:scale(1.04) }\n.article-card__body { padding:28px 28px 32px;flex:1;display:flex;flex-direction:column }\n.article-card__meta { display:flex;align-items:center;gap:14px;margin-bottom:12px }\n.article-card__cat { font-family:var(--font-d);font-size:9px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--gold-500) }\n.article-card__date { font-family:var(--font-b);font-size:11px;color:var(--text-muted) }\n.article-card__title { font-family:var(--font-d);font-size:18px;font-weight:700;letter-spacing:-.01em;line-height:1.25;color:var(--text-primary);margin-bottom:10px }\n.article-card__excerpt { font-family:var(--font-b);font-size:13px;color:var(--text-secondary);line-height:1.65;flex:1;margin-bottom:20px }\n.article-card__read { font-family:var(--font-d);font-size:10px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--gold-500);display:inline-flex;align-items:center;gap:6px;align-self:flex-start;transition:gap .15s }\n.article-card:hover .article-card__read { gap:12px }\n.article-card__read::after { content:'\u2192' }\n.post-plan-cta { padding:80px 52px;background:var(--bg-surface);border-top:1px solid var(--border-subtle);display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center }\n.post-plan-cta__title { font-family:var(--font-d);font-size:clamp(22px,2.5vw,32px);font-weight:700;letter-spacing:-.02em;color:var(--text-primary);margin-bottom:14px }\n.post-plan-cta__body { font-family:var(--font-b);font-size:15px;color:var(--text-secondary);line-height:1.75;margin-bottom:28px;max-width:46ch }\n.post-plan-cta__btn { display:inline-flex;align-items:center;gap:10px;font-family:var(--font-d);font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;background:var(--gold-500);color:var(--navy-900);padding:16px 36px;text-decoration:none;transition:all .15s }\n.post-plan-cta__btn:hover { background:var(--gold-400) }\n.post-plan-cta__details { display:flex;flex-direction:column;gap:3px }\n.post-plan-cta__detail-item { display:flex;align-items:center;justify-content:space-between;padding:14px 20px;background:var(--bg-elevated);border:1px solid var(--border-subtle) }\n.post-plan-cta__detail-item label { font-family:var(--font-d);font-size:9px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--text-muted) }\n.post-plan-cta__detail-item span { font-family:var(--font-b);font-size:13px;color:var(--text-secondary) }\n.label { font-family:var(--font-d);font-size:9px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--gold-500) }\n@media (max-width:900px) {\n  .post-hero__content { padding:0 28px 56px }\n  .post-layout { padding:52px 0;grid-template-columns:28px 1fr 28px }\n  .breadcrumb { padding:14px 28px }\n  .related { padding:60px 28px }\n  .related__grid { grid-template-columns:1fr }\n  .related__header { flex-direction:column;align-items:flex-start;gap:12px }\n  .post-plan-cta { grid-template-columns:1fr;gap:40px;padding:60px 28px }\n  .author-card { padding:48px 28px }\n  .author-card__inner { grid-template-columns:1fr }\n}\n@media (max-width:600px) {\n  .post-hero__headline { font-size:clamp(26px,8vw,44px) }\n  .post-byline__share { display:none }\n}\n";
