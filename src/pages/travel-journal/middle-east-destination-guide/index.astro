---
import Base from "../../../layouts/Base.astro";
import Content from "../../../content-pages/travel-journal__middle-east-destination-guide.html?raw";
const pageCss = "\n/* \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n   JOURNAL POST \u2014 Page Styles\n   Extends homepage/style.css\n   DESTINATION GUIDE TEMPLATE: additional classes\n   .dg-strip, .island-card, .timing-grid, .prop-grid\n\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 */\n\n.post-hero {\n  position:relative;min-height:70vh;margin-top:76px;\n  background:var(--navy-800);display:flex;align-items:flex-end;overflow:hidden;\n}\n.post-hero__bg {\n  position:absolute;inset:0;background:var(--navy-800);\n  display:flex;align-items:center;justify-content:center;overflow:hidden;\n}\n.post-hero__bg img {\n  width:100%;height:100%;object-fit:cover;object-position:center 55%;\n  opacity:.72;\n}\n.post-hero__bg-ph {\n  font-family:var(--font-d);font-size:11px;font-weight:600;\n  letter-spacing:.18em;text-transform:uppercase;color:rgba(138,155,176,.25);\n  text-align:center;padding:24px;position:absolute;\n}\n.post-hero__watermark {\n  position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);\n  width:min(440px,55vw);height:min(440px,55vw);object-fit:contain;\n  opacity:.04;pointer-events:none;\n}\n.post-hero__overlay {\n  position:absolute;inset:0;\n  background:linear-gradient(180deg,rgba(8,15,26,.05) 0%,rgba(8,15,26,.4) 45%,rgba(8,15,26,.92) 100%);\n}\n.post-hero__content {\n  position:relative;z-index:1;width:100%;padding:0 52px 72px;max-width:900px;\n}\n.post-hero__meta {\n  display:flex;align-items:center;gap:20px;margin-bottom:20px;flex-wrap:wrap;\n}\n.post-hero__cat {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.22em;text-transform:uppercase;color:var(--gold-500);\n}\n.post-hero__dot { width:3px;height:3px;background:var(--silver-400);border-radius:50% }\n.post-hero__date { font-family:var(--font-b);font-size:12px;color:var(--silver-400) }\n.post-hero__read { font-family:var(--font-b);font-size:12px;color:var(--silver-400) }\n.post-hero__headline {\n  font-family:var(--font-d);font-size:clamp(28px,5vw,58px);font-weight:700;\n  letter-spacing:-.03em;line-height:1.05;color:var(--cream-100);margin-bottom:20px;\n}\n.post-hero__deck {\n  font-family:var(--font-b);font-size:18px;color:var(--silver-300);\n  line-height:1.65;max-width:56ch;\n}\n\n.breadcrumb {\n  padding:18px 52px;background:var(--bg-surface);\n  border-bottom:1px solid var(--border-subtle);\n  display:flex;align-items:center;gap:10px;\n}\n.breadcrumb a, .breadcrumb span {\n  font-family:var(--font-d);font-size:10px;font-weight:600;\n  letter-spacing:.14em;text-transform:uppercase;color:var(--text-muted);transition:color .15s;\n  text-decoration:none;\n}\n.breadcrumb a:hover { color:var(--gold-400) }\n.breadcrumb__sep { color:var(--text-muted);font-size:12px;opacity:.5 }\n.breadcrumb__current { color:var(--text-secondary) }\n\n.post-layout {\n  display:grid;\n  grid-template-columns:1fr min(740px,100%) 1fr;\n  background:var(--bg-page);\n  padding:80px 0;\n}\n.post-layout > * { grid-column:2 }\n\n.post-byline {\n  display:flex;align-items:center;gap:18px;\n  padding-bottom:36px;margin-bottom:40px;\n  border-bottom:1px solid var(--border-subtle);grid-column:2;\n}\n.post-byline__avatar {\n  width:48px;height:48px;border-radius:50%;background:var(--bg-card);\n  border:1px solid var(--border-gold);flex-shrink:0;\n  display:flex;align-items:center;justify-content:center;overflow:hidden;\n}\n.post-byline__avatar-ph {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.1em;text-transform:uppercase;color:var(--gold-700);\n}\n.post-byline__info { display:flex;flex-direction:column;gap:3px }\n.post-byline__name {\n  font-family:var(--font-d);font-size:12px;font-weight:700;\n  letter-spacing:.1em;text-transform:uppercase;color:var(--text-primary);\n}\n.post-byline__role { font-family:var(--font-b);font-size:12px;color:var(--text-muted) }\n.post-byline__share { margin-left:auto;display:flex;align-items:center;gap:12px }\n.post-byline__share-label {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.18em;text-transform:uppercase;color:var(--text-muted);\n}\n.share-btn {\n  width:34px;height:34px;display:flex;align-items:center;justify-content:center;\n  border:1px solid var(--border-subtle);background:transparent;cursor:pointer;\n  color:var(--silver-400);transition:all .15s;\n}\n.share-btn:hover { border-color:var(--border-gold);color:var(--gold-400) }\n.share-btn svg { width:14px;height:14px }\n\n.post-body {\n  grid-column:2;\n  font-family:var(--font-b);font-size:17px;color:var(--text-secondary);line-height:1.8;\n}\n.post-body p { margin-bottom:24px }\n.post-body p:last-child { margin-bottom:0 }\n.post-body h2 {\n  font-family:var(--font-d);font-size:clamp(20px,2.5vw,28px);font-weight:700;\n  letter-spacing:-.02em;color:var(--text-primary);margin:52px 0 18px;line-height:1.15;\n}\n.post-body h3 {\n  font-family:var(--font-d);font-size:18px;font-weight:700;\n  letter-spacing:-.01em;color:var(--text-primary);margin:36px 0 14px;\n}\n.post-body strong { color:var(--text-primary);font-weight:600 }\n.post-body em { font-style:italic;color:var(--gold-400) }\n.post-body a { color:var(--gold-500);text-decoration:underline;text-underline-offset:3px;transition:color .15s }\n.post-body a:hover { color:var(--gold-400) }\n.post-body ul, .post-body ol {\n  padding-left:0;list-style:none;margin-bottom:24px;\n  display:flex;flex-direction:column;gap:10px;\n}\n.post-body ul li, .post-body ol li {\n  font-size:16px;color:var(--text-secondary);line-height:1.7;\n  padding-left:20px;position:relative;\n}\n.post-body ul li::before {\n  content:'';position:absolute;left:0;top:11px;\n  width:5px;height:1px;background:var(--gold-500);\n}\n\n.post-pullquote {\n  grid-column:2;border-left:2px solid var(--gold-500);\n  padding:8px 0 8px 32px;margin:44px 0;\n}\n.post-pullquote p {\n  font-family:var(--font-d);font-size:clamp(18px,2vw,24px);font-weight:600;\n  font-style:italic;letter-spacing:-.01em;line-height:1.4;\n  color:var(--text-primary);margin-bottom:0;\n}\n\n.post-callout {\n  grid-column:2;\n  background:var(--bg-elevated);border:1px solid var(--border-gold);\n  padding:32px 36px;margin:40px 0;\n}\n.post-callout__label {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.22em;text-transform:uppercase;color:var(--gold-500);\n  margin-bottom:14px;display:block;\n}\n.post-callout p {\n  font-family:var(--font-b);font-size:15px;color:var(--text-secondary);\n  line-height:1.7;margin-bottom:12px;\n}\n.post-callout p:last-child { margin-bottom:0 }\n.post-callout a { color:var(--gold-400);text-underline-offset:3px }\n\n.post-divider {\n  grid-column:2;border:none;\n  border-top:1px solid var(--border-subtle);margin:56px 0;\n}\n\n.post-footer {\n  grid-column:2;\n  padding-top:40px;border-top:1px solid var(--border-subtle);\n  display:flex;align-items:flex-start;justify-content:space-between;gap:40px;flex-wrap:wrap;\n}\n.post-footer__tags { display:flex;gap:8px;flex-wrap:wrap;align-items:center }\n.post-footer__tags-label {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.18em;text-transform:uppercase;color:var(--text-muted);margin-right:4px;\n}\n.post-tag {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.14em;text-transform:uppercase;\n  border:1px solid var(--border-subtle);color:var(--text-muted);\n  padding:6px 14px;transition:all .15s;cursor:pointer;\n}\n.post-tag:hover { border-color:var(--border-gold);color:var(--gold-400) }\n.post-footer__share { display:flex;align-items:center;gap:10px }\n.post-footer__share-label {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.18em;text-transform:uppercase;color:var(--text-muted);\n}\n\n.author-card {\n  background:var(--bg-surface);border-top:1px solid var(--border-subtle);\n  border-bottom:1px solid var(--border-subtle);padding:64px 52px;\n}\n.author-card__inner {\n  max-width:720px;margin:0 auto;\n  display:grid;grid-template-columns:80px 1fr;gap:32px;align-items:start;\n}\n.author-card__photo {\n  width:80px;height:80px;border-radius:50%;background:var(--bg-card);\n  border:1px solid var(--border-gold);\n  display:flex;align-items:center;justify-content:center;overflow:hidden;\n}\n.author-card__photo-ph {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.1em;text-transform:uppercase;color:var(--gold-700);\n  text-align:center;padding:8px;\n}\n.author-card__name {\n  font-family:var(--font-d);font-size:22px;font-weight:700;\n  letter-spacing:-.01em;color:var(--text-primary);margin-bottom:4px;\n}\n.author-card__title {\n  font-family:var(--font-d);font-size:10px;font-weight:700;\n  letter-spacing:.18em;text-transform:uppercase;color:var(--gold-500);margin-bottom:16px;\n}\n.author-card__bio {\n  font-family:var(--font-b);font-size:14px;color:var(--text-secondary);\n  line-height:1.75;margin-bottom:20px;max-width:52ch;\n}\n.author-card__cta {\n  display:inline-flex;align-items:center;gap:8px;\n  font-family:var(--font-d);font-size:10px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;color:var(--gold-500);transition:gap .15s;\n  text-decoration:none;\n}\n.author-card__cta:hover { gap:14px }\n.author-card__cta::after { content:'\u2192' }\n\n.related {\n  padding:80px 52px;background:var(--bg-page);border-top:1px solid var(--border-subtle);\n}\n.related__header {\n  display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:40px;\n}\n.related__title {\n  font-family:var(--font-d);font-size:clamp(20px,2vw,28px);font-weight:700;\n  letter-spacing:-.02em;color:var(--text-primary);margin-top:10px;\n}\n.related__all {\n  font-family:var(--font-d);font-size:10px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;color:var(--gold-500);\n  display:inline-flex;align-items:center;gap:6px;transition:gap .15s;white-space:nowrap;\n  text-decoration:none;\n}\n.related__all:hover { gap:12px }\n.related__all::after { content:'\u2192' }\n.related__grid { display:grid;grid-template-columns:repeat(3,1fr);gap:3px }\n\n.article-card {\n  background:var(--bg-elevated);border:1px solid var(--border-subtle);\n  display:flex;flex-direction:column;overflow:hidden;transition:border-color .2s;cursor:pointer;\n  text-decoration:none;\n}\n.article-card:hover { border-color:var(--border-gold) }\n.article-card__image {\n  height:200px;background:var(--bg-card);\n  display:flex;align-items:center;justify-content:center;\n  font-family:var(--font-d);font-size:9px;font-weight:600;\n  letter-spacing:.14em;text-transform:uppercase;color:rgba(138,155,176,.3);\n  overflow:hidden;position:relative;\n}\n.article-card__image-inner {\n  width:100%;height:100%;display:flex;align-items:center;justify-content:center;\n  transition:transform .4s cubic-bezier(.16,1,.3,1);\n}\n.article-card:hover .article-card__image-inner { transform:scale(1.04) }\n.article-card__body { padding:28px 28px 32px;flex:1;display:flex;flex-direction:column }\n.article-card__meta { display:flex;align-items:center;gap:14px;margin-bottom:12px }\n.article-card__cat {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.2em;text-transform:uppercase;color:var(--gold-500);\n}\n.article-card__date { font-family:var(--font-b);font-size:11px;color:var(--text-muted) }\n.article-card__title {\n  font-family:var(--font-d);font-size:18px;font-weight:700;\n  letter-spacing:-.01em;line-height:1.25;color:var(--text-primary);margin-bottom:10px;\n}\n.article-card__excerpt {\n  font-family:var(--font-b);font-size:13px;color:var(--text-secondary);\n  line-height:1.65;flex:1;margin-bottom:20px;\n}\n.article-card__read {\n  font-family:var(--font-d);font-size:10px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;color:var(--gold-500);\n  display:inline-flex;align-items:center;gap:6px;align-self:flex-start;transition:gap .15s;\n}\n.article-card:hover .article-card__read { gap:12px }\n.article-card__read::after { content:'\u2192' }\n\n.post-plan-cta {\n  padding:80px 52px;background:var(--bg-surface);border-top:1px solid var(--border-subtle);\n  display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;\n}\n.post-plan-cta__title {\n  font-family:var(--font-d);font-size:clamp(22px,2.5vw,32px);font-weight:700;\n  letter-spacing:-.02em;color:var(--text-primary);margin-bottom:14px;\n}\n.post-plan-cta__body {\n  font-family:var(--font-b);font-size:15px;color:var(--text-secondary);\n  line-height:1.75;margin-bottom:28px;max-width:46ch;\n}\n.post-plan-cta__btn {\n  display:inline-flex;align-items:center;gap:10px;\n  font-family:var(--font-d);font-size:11px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;\n  background:var(--gold-500);color:var(--navy-900);\n  padding:16px 36px;border:none;cursor:pointer;transition:all .15s;text-decoration:none;\n}\n.post-plan-cta__btn:hover { background:var(--gold-400);box-shadow:0 0 32px rgba(201,168,76,.2) }\n.post-plan-cta__details { display:flex;flex-direction:column;gap:3px }\n.post-plan-cta__detail-item {\n  display:flex;align-items:center;justify-content:space-between;\n  padding:14px 20px;background:var(--bg-elevated);border:1px solid var(--border-subtle);\n}\n.post-plan-cta__detail-item label {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;color:var(--text-muted);\n}\n.post-plan-cta__detail-item span { font-family:var(--font-b);font-size:13px;color:var(--text-secondary) }\n\n/* \u2550\u2550 DESTINATION GUIDE TEMPLATE CLASSES \u2550\u2550 */\n\n.dg-strip {\n  grid-column:1 / -1;\n  background:var(--bg-surface);\n  border-top:1px solid var(--border-subtle);border-bottom:1px solid var(--border-subtle);\n  padding:56px 52px;margin:56px 0;\n}\n.dg-strip__inner { max-width:740px;margin:0 auto }\n.dg-strip__label {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.22em;text-transform:uppercase;color:var(--gold-500);margin-bottom:12px;\n}\n.dg-strip__title {\n  font-family:var(--font-d);font-size:clamp(18px,2.2vw,24px);font-weight:700;\n  letter-spacing:-.01em;color:var(--text-primary);margin-bottom:28px;\n}\n.dg-stats {\n  display:grid;grid-template-columns:repeat(4,1fr);gap:3px;\n}\n.dg-stat {\n  background:var(--bg-elevated);border:1px solid var(--border-subtle);padding:20px 20px;\n}\n.dg-stat__num {\n  font-family:var(--font-d);font-size:26px;font-weight:700;\n  letter-spacing:-.02em;color:var(--gold-500);line-height:1;margin-bottom:4px;\n}\n.dg-stat__label {\n  font-family:var(--font-b);font-size:12px;color:var(--text-muted);line-height:1.4;\n}\n\n.island-section {\n  grid-column:1 / -1;\n  background:var(--bg-page);padding:0 52px 64px;\n}\n.island-section__inner { max-width:740px;margin:0 auto }\n.island-section__head {\n  padding:40px 0 28px;\n  border-bottom:1px solid var(--border-subtle);\n  margin-bottom:3px;\n}\n.island-section__label {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.22em;text-transform:uppercase;color:var(--gold-500);margin-bottom:8px;\n}\n.island-section__title {\n  font-family:var(--font-d);font-size:clamp(18px,2vw,22px);font-weight:700;\n  letter-spacing:-.01em;color:var(--text-primary);\n}\n\n.island-card {\n  background:var(--bg-elevated);border:1px solid var(--border-subtle);\n  margin-bottom:3px;display:grid;grid-template-columns:auto 1fr;\n  transition:border-color .2s;\n}\n.island-card:hover { border-color:var(--border-gold) }\n.island-card__num {\n  width:52px;background:var(--bg-surface);\n  border-right:1px solid var(--border-subtle);\n  display:flex;align-items:flex-start;justify-content:center;\n  padding-top:24px;\n  font-family:var(--font-d);font-size:11px;font-weight:700;\n  letter-spacing:.1em;color:var(--gold-700);\n}\n.island-card__body { padding:20px 24px 22px }\n.island-card__top {\n  display:flex;align-items:flex-start;justify-content:space-between;\n  gap:12px;margin-bottom:8px;flex-wrap:wrap;\n}\n.island-card__name {\n  font-family:var(--font-d);font-size:16px;font-weight:700;\n  letter-spacing:-.01em;color:var(--text-primary);\n}\n.island-card__badges { display:flex;gap:5px;flex-wrap:wrap;flex-shrink:0 }\n.island-badge {\n  font-family:var(--font-d);font-size:7px;font-weight:700;\n  letter-spacing:.14em;text-transform:uppercase;\n  padding:3px 8px;border:1px solid var(--border-subtle);color:var(--text-muted);\n}\n.island-badge--top { border-color:var(--border-gold);color:var(--gold-500);background:var(--accent-subtle) }\n.island-badge--char { border-color:rgba(255,255,255,.15);color:var(--silver-300) }\n.island-card__sub {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;color:var(--text-muted);\n  margin-bottom:10px;\n}\n.island-card__desc {\n  font-family:var(--font-b);font-size:13px;color:var(--text-secondary);\n  line-height:1.65;margin-bottom:12px;\n}\n.island-card__facts {\n  display:flex;gap:20px;flex-wrap:wrap;\n}\n.island-fact {\n  font-family:var(--font-b);font-size:11px;color:var(--text-muted);\n  display:flex;align-items:center;gap:5px;\n}\n.island-fact strong {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.1em;text-transform:uppercase;color:var(--gold-700);\n}\n\n.timing-section {\n  grid-column:1 / -1;\n  background:var(--bg-surface);\n  border-top:1px solid var(--border-subtle);border-bottom:1px solid var(--border-subtle);\n  padding:64px 52px;margin:0;\n}\n.timing-section__inner { max-width:740px;margin:0 auto }\n.timing-section__label {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.22em;text-transform:uppercase;color:var(--gold-500);margin-bottom:10px;\n}\n.timing-section__title {\n  font-family:var(--font-d);font-size:clamp(18px,2.2vw,24px);font-weight:700;\n  letter-spacing:-.01em;color:var(--text-primary);margin-bottom:28px;\n}\n.timing-grid {\n  display:grid;grid-template-columns:repeat(4,1fr);gap:3px;\n}\n.timing-card {\n  background:var(--bg-elevated);border:1px solid var(--border-subtle);padding:24px 22px;\n}\n.timing-card--best {\n  border-color:var(--border-gold);background:var(--accent-subtle);\n}\n.timing-months {\n  font-family:var(--font-d);font-size:18px;font-weight:700;\n  letter-spacing:-.01em;color:var(--text-primary);margin-bottom:6px;line-height:1.15;\n}\n.timing-card--best .timing-months { color:var(--gold-500) }\n.timing-name {\n  font-family:var(--font-d);font-size:10px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;color:var(--text-muted);margin-bottom:12px;\n}\n.timing-card--best .timing-name { color:var(--gold-700) }\n.timing-desc {\n  font-family:var(--font-b);font-size:12px;color:var(--text-muted);line-height:1.6;\n}\n.timing-badge {\n  display:inline-block;margin-top:12px;\n  font-family:var(--font-d);font-size:8px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;\n  padding:4px 10px;background:var(--gold-500);color:var(--navy-900);\n}\n\n.prop-section {\n  grid-column:2;margin:52px 0;\n}\n.prop-section__label {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.22em;text-transform:uppercase;color:var(--gold-500);margin-bottom:8px;\n}\n.prop-section__title {\n  font-family:var(--font-d);font-size:clamp(18px,2vw,22px);font-weight:700;\n  letter-spacing:-.01em;color:var(--text-primary);margin-bottom:6px;\n}\n.prop-section__sub {\n  font-family:var(--font-b);font-size:14px;color:var(--text-secondary);\n  line-height:1.65;margin-bottom:24px;\n}\n.prop-grid {\n  display:grid;grid-template-columns:1fr 1fr;gap:3px;\n}\n.prop-card {\n  background:var(--bg-elevated);border:1px solid var