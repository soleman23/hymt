---
import Base from "../../layouts/Base.astro";
import Content from "../../content-pages/travel-journal.html?raw";
const pageCss = "\n/* \u2500\u2500 JOURNAL PAGE \u2500\u2500 */\n\n.page-hero {\n  position:relative;min-height:48vh;margin-top:76px;\n  background:var(--navy-800);display:flex;align-items:flex-end;overflow:hidden;\n}\n.page-hero__watermark {\n  position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);\n  width:min(440px,55vw);height:min(440px,55vw);object-fit:contain;\n  opacity:.04;pointer-events:none;\n}\n.page-hero__overlay {\n  position:absolute;inset:0;\n  background:linear-gradient(180deg,rgba(8,15,26,0) 0%,rgba(8,15,26,.55) 55%,rgba(8,15,26,.94) 100%);\n}\n.page-hero__content {\n  position:relative;z-index:1;width:100%;padding:0 52px 64px;\n}\n.page-hero__headline {\n  font-family:var(--font-d);font-size:clamp(32px,5vw,60px);font-weight:700;\n  letter-spacing:-.03em;line-height:1.0;color:var(--cream-100);margin-bottom:14px;margin-top:12px;\n}\n.page-hero__sub {\n  font-family:var(--font-b);font-size:17px;color:var(--silver-300);\n  line-height:1.7;max-width:54ch;\n}\n\n/* FEATURED ARTICLE */\n.journal-featured {\n  background:var(--bg-surface);border-bottom:1px solid var(--border-subtle);\n}\n.journal-featured__grid {\n  display:grid;grid-template-columns:1fr 1fr;min-height:520px;\n}\n.journal-featured__image {\n  background:var(--bg-card);position:relative;\n  display:flex;align-items:center;justify-content:center;min-height:400px;overflow:hidden;\n}\n.journal-featured__image-ph {\n  font-family:var(--font-d);font-size:10px;font-weight:600;\n  letter-spacing:.16em;text-transform:uppercase;color:rgba(138,155,176,.3);\n  text-align:center;padding:24px;position:relative;z-index:1;\n}\n.journal-featured__content {\n  padding:64px 60px;display:flex;flex-direction:column;justify-content:center;\n}\n.journal-featured__meta {\n  display:flex;align-items:center;gap:16px;margin-bottom:20px;\n}\n.journal-featured__cat {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.22em;text-transform:uppercase;color:var(--gold-500);\n}\n.journal-featured__date {\n  font-family:var(--font-b);font-size:12px;color:var(--text-muted);\n}\n.journal-featured__title {\n  font-family:var(--font-d);font-size:clamp(24px,3vw,36px);font-weight:700;\n  letter-spacing:-.02em;line-height:1.15;color:var(--text-primary);margin-bottom:18px;\n}\n.journal-featured__excerpt {\n  font-family:var(--font-b);font-size:15px;color:var(--text-secondary);\n  line-height:1.8;max-width:50ch;margin-bottom:28px;\n}\n.journal-featured__cta {\n  display:inline-flex;align-items:center;gap:8px;align-self:flex-start;\n  font-family:var(--font-d);font-size:10px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;color:var(--gold-500);\n  transition:gap .15s;\n}\n.journal-featured__cta:hover { gap:14px }\n.journal-featured__cta::after { content:'\u2192' }\n\n/* ARTICLE GRID */\n.journal-section { padding:72px 52px;background:var(--bg-page) }\n.journal-grid {\n  display:grid;grid-template-columns:repeat(3,1fr);gap:3px;\n}\n.article-card {\n  background:var(--bg-elevated);border:1px solid var(--border-subtle);\n  display:flex;flex-direction:column;overflow:hidden;\n  transition:border-color .2s;cursor:pointer;\n}\n.article-card:hover { border-color:var(--border-gold) }\n.article-card__image {\n  height:200px;background:var(--bg-card);\n  display:flex;align-items:center;justify-content:center;\n  font-family:var(--font-d);font-size:9px;font-weight:600;\n  letter-spacing:.14em;text-transform:uppercase;color:rgba(138,155,176,.3);\n  overflow:hidden;position:relative;\n}\n.article-card__image-inner {\n  width:100%;height:100%;display:flex;align-items:center;justify-content:center;\n  transition:transform .4s cubic-bezier(.16,1,.3,1);\n}\n.article-card:hover .article-card__image-inner { transform:scale(1.04) }\n.article-card__body { padding:28px 28px 32px;flex:1;display:flex;flex-direction:column }\n.article-card__meta {\n  display:flex;align-items:center;gap:14px;margin-bottom:12px;\n}\n.article-card__cat {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.2em;text-transform:uppercase;color:var(--gold-500);\n}\n.article-card__date {\n  font-family:var(--font-b);font-size:11px;color:var(--text-muted);\n}\n.article-card__title {\n  font-family:var(--font-d);font-size:18px;font-weight:700;\n  letter-spacing:-.01em;line-height:1.25;color:var(--text-primary);\n  margin-bottom:10px;\n}\n.article-card__excerpt {\n  font-family:var(--font-b);font-size:13px;color:var(--text-secondary);\n  line-height:1.65;flex:1;margin-bottom:20px;\n}\n.article-card__read {\n  font-family:var(--font-d);font-size:10px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;color:var(--gold-500);\n  display:inline-flex;align-items:center;gap:6px;align-self:flex-start;\n  transition:gap .15s;\n}\n.article-card:hover .article-card__read { gap:12px }\n.article-card__read::after { content:'\u2192' }\n\n/* LOAD MORE */\n.journal-more {\n  text-align:center;padding:0 52px 72px;background:var(--bg-page);\n  border-top:1px solid var(--border-subtle);padding-top:48px;\n}\n.journal-more__btn {\n  display:inline-flex;align-items:center;gap:10px;\n  font-family:var(--font-d);font-size:10px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;\n  border:1px solid var(--border-mid);color:var(--text-secondary);\n  background:transparent;padding:14px 32px;cursor:pointer;transition:all .15s;\n}\n.journal-more__btn:hover { border-color:var(--gold-500);color:var(--gold-400) }\n.journal-more__count {\n  font-family:var(--font-b);font-size:13px;color:var(--text-muted);\n  margin-top:16px;\n}\n\n/* ABOUT STRIP */\n.journal-about {\n  padding:72px 52px;background:var(--bg-surface);\n  border-top:1px solid var(--border-subtle);border-bottom:1px solid var(--border-subtle);\n  display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;\n}\n.journal-about__title {\n  font-family:var(--font-d);font-size:clamp(22px,2.5vw,32px);font-weight:700;\n  letter-spacing:-.02em;color:var(--text-primary);margin-bottom:14px;\n}\n.journal-about__body {\n  font-family:var(--font-b);font-size:15px;color:var(--text-secondary);\n  line-height:1.75;margin-bottom:24px;\n}\n.journal-about__cta {\n  display:inline-flex;align-items:center;gap:10px;\n  font-family:var(--font-d);font-size:11px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;\n  background:var(--gold-500);color:var(--navy-900);\n  padding:15px 32px;border:none;cursor:pointer;transition:all .15s;\n}\n.journal-about__cta:hover { background:var(--gold-400) }\n.journal-about__categories { display:flex;flex-direction:column;gap:3px }\n.journal-about__cat-item {\n  display:flex;align-items:center;justify-content:space-between;\n  padding:14px 20px;background:var(--bg-elevated);border:1px solid var(--border-subtle);\n  font-family:var(--font-d);font-size:10px;font-weight:700;letter-spacing:.14em;\n  text-transform:uppercase;color:var(--text-secondary);cursor:pointer;transition:all .15s;\n}\n.journal-about__cat-item:hover { border-color:var(--border-gold);color:var(--gold-400) }\n.journal-about__cat-item::after { content:'\u2192';color:var(--gold-700) }\n\n@media(max-width:900px){\n  .journal-featured__grid { grid-template-columns:1fr }\n  .journal-grid { grid-template-columns:1fr }\n  .journal-about { grid-template-columns:1fr;gap:40px }\n  .page-hero__content,.journal-section,.journal-more,.journal-about,.newsletter { padding-left:28px;padding-right:28px }\n}\n";
---
<Base title="Travel Journal — Hit Your Mark Travel" description="The Hit Your Mark Travel Journal — destination notes, shoulder-season guides, and considered opinions on how to travel exceptionally well." active="journal" pageCss={pageCss} schemaType="website">
  <Fragment set:html={Content} />
</Base>
