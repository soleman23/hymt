---
import Base from "../../layouts/Base.astro";
import Content from "../../content-pages/travel-journal.html?raw";
import { breadcrumbs, collection, plain } from "../../lib/schema";

/* P2-5: CollectionPage + ItemList of every post, parsed from the hub
   content this page already imports (featured block + article cards) so
   there is no second hand-maintained list to drift.

   Deduped by path: the featured post is also a card in the grid, so it
   parses out twice, and the ItemList shipped with numberOfItems one higher
   than the site had posts and one URL at two positions. The verifier's
   schema-itemlist check now fails the build on either. */
const SITE = (Astro.site?.href ?? "https://www.hymtravel.com/").replace(/\/$/, "");
const description =
  "The Hit Your Mark Travel Journal — destination notes, shoulder-season guides, and considered opinions on how to travel exceptionally well.";
const posts: { name: string; path: string }[] = [];
{
  const seen = new Set<string>();
  const add = (name: string, path: string) => {
    if (seen.has(path)) return;
    seen.add(path);
    posts.push({ name: plain(name), path });
  };
  const feat = Content.match(
    /journal-featured__title">([\s\S]*?)<\/h2>[\s\S]*?href="(\/travel-journal\/[^"]+)" class="journal-featured__cta"/
  );
  if (feat) add(feat[1], feat[2]);
  for (const chunk of Content.split('<div class="article-card"').slice(1)) {
    const name = chunk.match(/article-card__title">([\s\S]*?)<\/h3>/)?.[1];
    const path = chunk.match(/href="(\/travel-journal\/[^"]+)" class="article-card__read"/)?.[1];
    if (name && path) add(name, path);
  }
}
const schema = [
  collection(SITE, { name: "Travel Journal", description, path: "/travel-journal/", items: posts }),
  breadcrumbs(SITE, [{ name: "Home", path: "/" }, { name: "Travel Journal" }]),
];
const pageCss = "\n/* \u2500\u2500 JOURNAL PAGE \u2500\u2500 */\n\n.page-hero {\n  position:relative;min-height:48vh;margin-top:76px;\n  background:var(--navy-800);display:flex;align-items:flex-end;overflow:hidden;\n}\n.page-hero__watermark {\n  position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);\n  width:min(440px,55vw);height:min(440px,55vw);object-fit:contain;\n  opacity:.04;pointer-events:none;\n}\n.page-hero__overlay {\n  position:absolute;inset:0;\n  background:linear-gradient(180deg,rgba(8,15,26,0) 0%,rgba(8,15,26,.55) 55%,rgba(8,15,26,.94) 100%);\n}\n.page-hero__content {\n  position:relative;z-index:1;width:100%;padding:0 52px 64px;\n}\n.page-hero__headline {\n  font-family:var(--font-d);font-size:clamp(32px,5vw,60px);font-weight:700;\n  letter-spacing:-.03em;line-height:1.0;color:var(--cream-100);margin-bottom:14px;margin-top:12px;\n}\n.page-hero__sub {\n  font-family:var(--font-b);font-size:17px;color:var(--silver-300);\n  line-height:1.7;max-width:54ch;\n}\n\n/* FEATURED ARTICLE */\n.journal-featured {\n  background:var(--bg-surface);border-bottom:1px solid var(--border-subtle);\n}\n.journal-featured__grid {\n  display:grid;grid-template-columns:1fr 1fr;min-height:520px;\n}\n.journal-featured__image {\n  background:var(--bg-card);position:relative;\n  display:flex;align-items:center;justify-content:center;min-height:400px;overflow:hidden;\n}\n.journal-featured__image-ph {\n  font-family:var(--font-d);font-size:10px;font-weight:600;\n  letter-spacing:.16em;text-transform:uppercase;color:rgba(138,155,176,.3);\n  text-align:center;padding:24px;position:relative;z-index:1;\n}\n.journal-featured__content {\n  padding:64px 60px;display:flex;flex-direction:column;justify-content:center;\n}\n.journal-featured__meta {\n  display:flex;align-items:center;gap:16px;margin-bottom:20px;\n}\n.journal-featured__cat {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.22em;text-transform:uppercase;color:var(--gold-500);\n}\n.journal-featured__date {\n  font-family:var(--font-b);font-size:12px;color:var(--text-muted);\n}\n.journal-featured__title {\n  font-family:var(--font-d);font-size:clamp(24px,3vw,36px);font-weight:700;\n  letter-spacing:-.02em;line-height:1.15;color:var(--text-primary);margin-bottom:18px;\n}\n.journal-featured__excerpt {\n  font-family:var(--font-b);font-size:15px;color:var(--text-secondary);\n  line-height:1.8;max-width:50ch;margin-bottom:28px;\n}\n.journal-featured__cta {\n  display:inline-flex;align-items:center;gap:8px;align-self:flex-start;\n  font-family:var(--font-d);font-size:10px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;color:var(--gold-500);\n  transition:gap .15s;\n}\n.journal-featured__cta:hover { gap:14px }\n.journal-featured__cta::after { content:'\u2192' }\n\n/* ARTICLE GRID */\n.journal-section { padding:72px 52px;background:var(--bg-page) }\n.journal-grid {\n  display:grid;grid-template-columns:repeat(3,1fr);gap:3px;\n}\n.article-card {\n  background:var(--bg-elevated);border:1px solid var(--border-subtle);\n  display:flex;flex-direction:column;overflow:hidden;\n  transition:border-color .2s;cursor:pointer;\n}\n.article-card:hover { border-color:var(--border-gold) }\n.article-card__image {\n  height:200px;background:var(--bg-card);\n  display:flex;align-items:center;justify-content:center;\n  font-family:var(--font-d);font-size:9px;font-weight:600;\n  letter-spacing:.14em;text-transform:uppercase;color:rgba(138,155,176,.3);\n  overflow:hidden;position:relative;\n}\n/* #87: a real lazy image element replaces the background-image these cards\n   carried, so they can defer. object-fit:cover reproduces what\n   background-size:cover did, and the hover scale moves onto it. */\n.article-card__img {\n  position:absolute;inset:0;width:100%;height:100%;object-fit:cover;\n  transition:transform .4s cubic-bezier(.16,1,.3,1);\n}\n.article-card:hover .article-card__img { transform:scale(1.04) }\n.journal-featured__img {\n  position:absolute;inset:0;width:100%;height:100%;object-fit:cover;\n}\n.article-card__image-inner {\n  width:100%;height:100%;display:flex;align-items:center;justify-content:center;\n  transition:transform .4s cubic-bezier(.16,1,.3,1);\n}\n.article-card:hover .article-card__image-inner { transform:scale(1.04) }\n.article-card__body { padding:28px 28px 32px;flex:1;display:flex;flex-direction:column }\n.article-card__meta {\n  display:flex;align-items:center;gap:14px;margin-bottom:12px;\n}\n.article-card__cat {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.2em;text-transform:uppercase;color:var(--gold-500);\n}\n.article-card__date {\n  font-family:var(--font-b);font-size:11px;color:var(--text-muted);\n}\n.article-card__title {\n  font-family:var(--font-d);font-size:18px;font-weight:700;\n  letter-spacing:-.01em;line-height:1.25;color:var(--text-primary);\n  margin-bottom:10px;\n}\n.article-card__excerpt {\n  font-family:var(--font-b);font-size:13px;color:var(--text-secondary);\n  line-height:1.65;flex:1;margin-bottom:20px;\n}\n.article-card__read {\n  font-family:var(--font-d);font-size:10px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;color:var(--gold-500);\n  display:inline-flex;align-items:center;gap:6px;align-self:flex-start;\n  transition:gap .15s;\n}\n.article-card:hover .article-card__read { gap:12px }\n.article-card__read::after { content:'\u2192' }\n\n/* LOAD MORE */\n.journal-more {\n  text-align:center;padding:0 52px 72px;background:var(--bg-page);\n  border-top:1px solid var(--border-subtle);padding-top:48px;\n}\n.journal-more__btn {\n  display:inline-flex;align-items:center;gap:10px;\n  font-family:var(--font-d);font-size:10px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;\n  border:1px solid var(--border-mid);color:var(--text-secondary);\n  background:transparent;padding:14px 32px;cursor:pointer;transition:all .15s;\n}\n.journal-more__btn:hover { border-color:var(--gold-500);color:var(--gold-400) }\n.journal-more__count {\n  font-family:var(--font-b);font-size:13px;color:var(--text-muted);\n  margin-top:16px;\n}\n\n/* ABOUT STRIP */\n.journal-about {\n  padding:72px 52px;background:var(--bg-surface);\n  border-top:1px solid var(--border-subtle);border-bottom:1px solid var(--border-subtle);\n  display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;\n}\n.journal-about__title {\n  font-family:var(--font-d);font-size:clamp(22px,2.5vw,32px);font-weight:700;\n  letter-spacing:-.02em;color:var(--text-primary);margin-bottom:14px;\n}\n.journal-about__body {\n  font-family:var(--font-b);font-size:15px;color:var(--text-secondary);\n  line-height:1.75;margin-bottom:24px;\n}\n.journal-about__cta {\n  display:inline-flex;align-items:center;gap:10px;\n  font-family:var(--font-d);font-size:11px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;\n  background:var(--gold-500);color:var(--navy-900);\n  padding:15px 32px;border:none;cursor:pointer;transition:all .15s;\n}\n.journal-about__cta:hover { background:var(--gold-400) }\n.journal-about__categories { display:flex;flex-direction:column;gap:3px }\n.journal-about__cat-item {\n  display:flex;align-items:center;justify-content:space-between;\n  padding:14px 20px;background:var(--bg-elevated);border:1px solid var(--border-subtle);\n  font-family:var(--font-d);font-size:10px;font-weight:700;letter-spacing:.14em;\n  text-transform:uppercase;color:var(--text-secondary);cursor:pointer;transition:all .15s;\n}\n.journal-about__cat-item:hover { border-color:var(--border-gold);color:var(--gold-400) }\n.journal-about__cat-item::after { content:'\u2192';color:var(--gold-700) }\n\n/* \u2500\u2500 FILTERING + PAGINATION (#105) \u2500\u2500\n   .article-card is display:flex, which overrides the UA [hidden] rule, so\n   hiding a card needs this explicitly. */\n.article-card[hidden] { display:none }\n.journal-about__cat-item[aria-pressed=\"true\"] {\n  border-color:var(--gold-500);color:var(--gold-400);background:var(--accent-subtle);\n}\n.journal-about__cat-item { font:inherit;text-align:left;width:100% }\n\n/* \u2500\u2500 WHOLE-CARD CLICK (#100) \u2500\u2500\n   Every card was a div carrying an inline onclick that set\n   window.location.href — something a CSP has to permit with 'unsafe-inline',\n   and something no keyboard user and no crawler could follow. The card's own\n   Read more anchor now stretches over the card instead: the same click\n   target, a real link, and no JS. ::before, because ::after on that anchor\n   already carries the arrow glyph. */\n.article-card { position:relative }\n.article-card__read::before { content:'';position:absolute;inset:0 }\n\n@media(max-width:900px){\n  .journal-featured__grid { grid-template-columns:1fr }\n  .journal-grid { grid-template-columns:1fr }\n  .journal-about { grid-template-columns:1fr;gap:40px }\n  .page-hero__content,.journal-section,.journal-more,.journal-about,.newsletter { padding-left:28px;padding-right:28px }\n}\n";
---
<Base title="Travel Journal — Hit Your Mark Travel" description={description} active="journal" pageCss={pageCss} schemaType="website" schema={schema}>
  <Fragment set:html={Content} />

{/* #105: the category filters and Load More were markup only. The filters
    called filterArticles('<slug>'), which was never defined AND never
    implementable as written, because the cards carried no category hook to
    filter on. The count said "Showing 36 of 39 articles" while all 39 rendered.

    Progressive enhancement: the HTML ships every card visible and the Load More
    button hidden, so with JS off you get all 39 articles and no dead control.
    This then paginates and reveals the button. */}
<script is:inline>
  (function () {
    var PAGE = 12;                       // 3-column grid, so 4 rows a page
    var grid = document.querySelector(".journal-grid");
    var countEl = document.getElementById("journalCount");
    var moreBtn = document.getElementById("loadMore");
    if (!grid || !countEl || !moreBtn) return;

    var cards = [].slice.call(grid.querySelectorAll(".article-card"));
    var filters = [].slice.call(document.querySelectorAll("[data-filter]"));
    var active = "all";
    var shown = PAGE;

    function matching() {
      return active === "all"
        ? cards
        : cards.filter(function (c) { return c.getAttribute("data-category") === active; });
    }

    function render() {
      var list = matching();
      /* A filtered view shows everything that matches: paginating inside a
         category people chose is friction with no payoff at these counts. */
      var limit = active === "all" ? Math.min(shown, list.length) : list.length;

      cards.forEach(function (c) { c.hidden = true; });
      list.slice(0, limit).forEach(function (c) { c.hidden = false; });

      var label = active === "all"
        ? ""
        : " in " + (filters.filter(function (f) { return f.getAttribute("data-filter") === active; })[0] || {}).textContent;
      countEl.textContent = limit === list.length
        ? list.length + (list.length === 1 ? " article" : " articles") + label
        : "Showing " + limit + " of " + list.length + " articles" + label;

      moreBtn.hidden = limit >= list.length;
    }

    filters.forEach(function (btn) {
      btn.addEventListener("click", function () {
        active = btn.getAttribute("data-filter");
        shown = PAGE;
        filters.forEach(function (f) {
          f.setAttribute("aria-pressed", String(f === btn));
        });
        render();
        grid.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    moreBtn.addEventListener("click", function () {
      /* The first still-hidden match IS the first card about to be revealed.
         An earlier version computed an index from `shown` instead and focused
         the wrong card, because 7 cards in this grid contain no <a> at all and
         the anchor lookup silently no-opped. Take the element, not the index. */
      var firstNew = matching().filter(function (c) { return c.hidden; })[0];
      shown += PAGE;
      render();
      /* Send focus to the newly revealed content so keyboard and screen reader
         users land there rather than back at the top. Prefer the card's link;
         fall back to the card itself, which not every card has a link inside. */
      if (firstNew && !firstNew.hidden) {
        var target = firstNew.querySelector("a") || firstNew;
        target.setAttribute("tabindex", "-1");
        target.focus();
      }
    });

    render();
  })();
</script>
</Base>
