---
import Base from "../../../layouts/Base.astro";
import Content from "../../../content-pages/travel-journal__polar-destination-guide.html?raw";
const pageCss = "\n/* \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n   JOURNAL POST \u2014 Page Styles\n   Extends homepage/style.css\n   DESTINATION GUIDE TEMPLATE: additional classes\n   .dg-strip, .island-card, .timing-grid, .prop-grid\n\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 */\n\n.post-hero {\n  position:relative;min-height:70vh;margin-top:76px;\n  background:var(--navy-800);display:flex;align-items:flex-end;overflow:hidden;\n}\n.post-hero__bg {\n  position:absolute;inset:0;background:var(--navy-800);\n  display:flex;align-items:center;justify-content:center;overflow:hidden;\n}\n.post-hero__bg img {\n  width:100%;height:100%;object-fit:cover;object-position:center 40%;\n  opacity:.72;\n}\n.post-hero__bg-ph {\n  font-family:var(--font-d);font-size:11px;font-weight:600;\n  letter-spacing:.18em;text-transform:uppercase;color:rgba(138,155,176,.25);\n  text-align:center;padding:24px;position:absolute;\n}\n.post-hero__watermark {\n  position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);\n  width:min(440px,55vw);height:min(440px,55vw);object-fit:contain;\n  opacity:.04;pointer-events:none;\n}\n.post-hero__overlay {\n  position:absolute;inset:0;\n  background:linear-gradient(180deg,rgba(8,15,26,.05) 0%,rgba(8,15,26,.4) 45%,rgba(8,15,26,.92) 100%);\n}\n.post-hero__content {\n  position:relative;z-index:1;width:100%;padding:0 52px 72px;max-width:900px;\n}\n.post-hero__meta {\n  display:flex;align-items:center;gap:20px;margin-bottom:20px;flex-wrap:wrap;\n}\n.post-hero__cat {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.22em;text-transform:uppercase;color:var(--gold-500);\n}\n.post-hero__dot { width:3px;height:3px;background:var(--silver-400);border-radius:50% }\n.post-hero__date { font-family:var(--font-b);font-size:12px;color:var(--silver-400) }\n.post-hero__read { font-family:var(--font-b);font-size:12px;color:var(--silver-400) }\n.post-hero__headline {\n  font-family:var(--font-d);font-size:clamp(28px,5vw,58px);font-weight:700;\n  letter-spacing:-.03em;line-height:1.05;color:var(--cream-100);margin-bottom:20px;\n}\n.post-hero__deck {\n  font-family:var(--font-b);font-size:18px;color:var(--silver-300);\n  line-height:1.65;max-width:56ch;\n}\n\n.breadcrumb {\n  padding:18px 52px;background:var(--bg-surface);\n  border-bottom:1px solid var(--border-subtle);\n  display:flex;align-items:center;gap:10px;\n}\n.breadcrumb a, .breadcrumb span {\n  font-family:var(--font-d);font-size:10px;font-weight:600;\n  letter-spacing:.14em;text-transform:uppercase;color:var(--text-muted);transition:color .15s;\n  text-decoration:none;\n}\n.breadcrumb a:hover { color:var(--gold-400) }\n.breadcrumb__sep { color:var(--text-muted);font-size:12px;opacity:.5 }\n.breadcrumb__current { color:var(--text-secondary) }\n\n.post-layout {\n  display:grid;\n  grid-template-columns:1fr min(740px,100%) 1fr;\n  background:var(--bg-page);\n  padding:80px 0;\n}\n.post-layout > * { grid-column:2 }\n\n.post-byline {\n  display:flex;align-items:center;gap:18px;\n  padding-bottom:36px;margin-bottom:40px;\n  border-bottom:1px solid var(--border-subtle);grid-column:2;\n}\n.post-byline__avatar {\n  width:48px;height:48px;border-radius:50%;background:var(--bg-card);\n  border:1px solid var(--border-gold);flex-shrink:0;\n  display:flex;align-items:center;justify-content:center;overflow:hidden;\n}\n.post-byline__avatar-ph {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.1em;text-transform:uppercase;color:var(--gold-700);\n}\n.post-byline__info { display:flex;flex-direction:column;gap:3px }\n.post-byline__name {\n  font-family:var(--font-d);font-size:12px;font-weight:700;\n  letter-spacing:.1em;text-transform:uppercase;color:var(--text-primary);\n}\n.post-byline__role { font-family:var(--font-b);font-size:12px;color:var(--text-muted) }\n.post-byline__share { margin-left:auto;display:flex;align-items:center;gap:12px }\n.post-byline__share-label {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.18em;text-transform:uppercase;color:var(--text-muted);\n}\n.share-btn {\n  width:34px;height:34px;display:flex;align-items:center;justify-content:center;\n  border:1px solid var(--border-subtle);background:transparent;cursor:pointer;\n  color:var(--silver-400);transition:all .15s;\n}\n.share-btn:hover { border-color:var(--border-gold);color:var(--gold-400) }\n.share-btn svg { width:14px;height:14px }\n\n.post-lede {\n  font-family:var(--font-b);font-size:20px;line-height:1.7;\n  color:var(--text-secondary);margin-bottom:36px;font-weight:400;\n}\n.post-body { font-family:var(--font-b);font-size:16px;line-height:1.8;color:var(--text-secondary) }\n.post-body p { margin-bottom:1.6em }\n.post-body h2 {\n  font-family:var(--font-d);font-size:24px;font-weight:700;\n  letter-spacing:-.02em;color:var(--text-primary);\n  margin:2.4em 0 .8em;\n}\n.post-body h3 {\n  font-family:var(--font-d);font-size:18px;font-weight:700;\n  color:var(--text-primary);margin:2em 0 .6em;\n}\n.post-pullquote {\n  grid-column:2;\n  border-left:2px solid var(--gold-500);\n  padding:24px 32px;margin:48px 0;\n  background:var(--accent-subtle);\n}\n.post-pullquote p {\n  font-family:var(--font-d);font-size:20px;font-weight:600;\n  letter-spacing:-.01em;line-height:1.5;color:var(--cream-100);\n  margin:0 0 10px;\n}\n.post-pullquote cite {\n  font-family:var(--font-b);font-size:12px;color:var(--text-muted);\n  font-style:normal;letter-spacing:.05em;\n}\n\n/* \u2500\u2500 DESTINATION GUIDE STRIP \u2500\u2500 */\n.dg-strip {\n  grid-column:1/-1;\n  background:var(--navy-900);\n  border-top:1px solid var(--border-subtle);\n  border-bottom:1px solid var(--border-subtle);\n  padding:28px 52px;\n  display:flex;gap:0;\n}\n.dg-stats {\n  display:flex;gap:0;flex-wrap:wrap;flex:1;\n}\n.dg-stat {\n  padding:0 40px 0 0;\n  display:flex;flex-direction:column;gap:5px;\n}\n.dg-stat + .dg-stat {\n  padding-left:40px;\n  border-left:1px solid var(--border-subtle);\n}\n.dg-stat__label {\n  font-family:var(--font-d);font-size:8px;font-weight:700;\n  letter-spacing:.2em;text-transform:uppercase;color:var(--text-muted);\n}\n.dg-stat__value {\n  font-family:var(--font-d);font-size:15px;font-weight:700;\n  color:var(--cream-100);letter-spacing:-.01em;\n}\n\n/* \u2500\u2500 ISLAND SECTION (regions) \u2500\u2500 */\n.island-section {\n  grid-column:1/-1;\n  background:var(--bg-surface);\n  padding:80px 52px;\n}\n.island-section__header {\n  max-width:740px;margin:0 auto 56px;\n}\n.island-section__label {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.22em;text-transform:uppercase;color:var(--gold-500);\n  margin-bottom:14px;\n}\n.island-section__title {\n  font-family:var(--font-d);font-size:clamp(22px,3vw,34px);font-weight:700;\n  letter-spacing:-.02em;color:var(--cream-100);margin-bottom:16px;\n}\n.island-section__body {\n  font-family:var(--font-b);font-size:16px;line-height:1.75;color:var(--text-secondary);\n  max-width:64ch;\n}\n.island-grid {\n  display:grid;\n  grid-template-columns:repeat(auto-fill,minmax(320px,1fr));\n  gap:2px;max-width:1200px;margin:0 auto;\n}\n.island-card {\n  background:var(--bg-card);\n  padding:36px 32px;\n  border:1px solid var(--border-subtle);\n  position:relative;overflow:hidden;\n  transition:border-color .2s;\n}\n.island-card:hover { border-color:var(--border-gold) }\n.island-card__num {\n  font-family:var(--font-d);font-size:11px;font-weight:700;\n  letter-spacing:.14em;color:var(--text-muted);margin-bottom:20px;\n}\n.island-card__badges {\n  display:flex;flex-wrap:wrap;gap:8px;margin-bottom:20px;\n}\n.island-badge--top {\n  font-family:var(--font-d);font-size:8px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;\n  background:var(--accent-subtle);color:var(--gold-500);\n  border:1px solid var(--border-gold);padding:5px 10px;\n}\n.island-badge--char {\n  font-family:var(--font-d);font-size:8px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;\n  background:transparent;color:var(--text-muted);\n  border:1px solid var(--border-subtle);padding:5px 10px;\n}\n.island-card__name {\n  font-family:var(--font-d);font-size:20px;font-weight:700;\n  letter-spacing:-.01em;color:var(--cream-100);margin-bottom:6px;\n}\n.island-card__sub {\n  font-family:var(--font-b);font-size:12px;color:var(--gold-500);\n  letter-spacing:.04em;margin-bottom:18px;\n  text-transform:uppercase;font-weight:600;\n}\n.island-card__desc {\n  font-family:var(--font-b);font-size:14px;line-height:1.75;\n  color:var(--text-secondary);margin-bottom:22px;\n}\n.island-card__props {\n  display:flex;flex-direction:column;gap:6px;margin-bottom:22px;\n}\n.island-card__prop {\n  font-family:var(--font-b);font-size:12px;color:var(--text-muted);\n  display:flex;align-items:flex-start;gap:8px;line-height:1.5;\n}\n.island-card__prop::before {\n  content:'';width:4px;height:4px;background:var(--gold-500);\n  border-radius:50%;flex-shrink:0;margin-top:5px;\n}\n.island-card__gateway {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.14em;text-transform:uppercase;\n  color:var(--text-muted);\n  padding-top:18px;border-top:1px solid var(--border-subtle);\n}\n.island-card__gateway span { color:var(--silver-300) }\n\n/* \u2500\u2500 TIMING SECTION \u2500\u2500 */\n.timing-section {\n  grid-column:1/-1;\n  background:var(--navy-900);\n  padding:80px 52px;\n}\n.timing-section__header {\n  max-width:740px;margin:0 auto 52px;\n}\n.timing-section__label {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.22em;text-transform:uppercase;color:var(--gold-500);\n  margin-bottom:14px;\n}\n.timing-section__title {\n  font-family:var(--font-d);font-size:clamp(22px,3vw,32px);font-weight:700;\n  letter-spacing:-.02em;color:var(--cream-100);\n}\n.timing-grid {\n  display:grid;\n  grid-template-columns:repeat(auto-fill,minmax(260px,1fr));\n  gap:2px;max-width:1200px;margin:0 auto;\n}\n.timing-card {\n  background:var(--bg-card);\n  padding:32px 28px;\n  border:1px solid var(--border-subtle);\n  position:relative;\n}\n.timing-card--best {\n  background:rgba(201,168,76,.06);\n  border-color:rgba(201,168,76,.25);\n}\n.timing-badge {\n  font-family:var(--font-d);font-size:8px;font-weight:700;\n  letter-spacing:.18em;text-transform:uppercase;\n  color:var(--gold-500);margin-bottom:14px;display:block;\n}\n.timing-card__window {\n  font-family:var(--font-d);font-size:18px;font-weight:700;\n  color:var(--cream-100);margin-bottom:8px;letter-spacing:-.01em;\n}\n.timing-card__name {\n  font-family:var(--font-b);font-size:13px;font-weight:600;\n  color:var(--gold-400);margin-bottom:14px;\n}\n.timing-card__desc {\n  font-family:var(--font-b);font-size:13px;line-height:1.7;\n  color:var(--text-muted);\n}\n\n/* \u2500\u2500 PROPERTIES SECTION \u2500\u2500 */\n.prop-section {\n  grid-column:1/-1;\n  background:var(--bg-page);\n  padding:80px 52px;\n}\n.prop-section__header {\n  max-width:740px;margin:0 auto 52px;\n}\n.prop-section__label {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.22em;text-transform:uppercase;color:var(--gold-500);\n  margin-bottom:14px;\n}\n.prop-section__title {\n  font-family:var(--font-d);font-size:clamp(22px,3vw,32px);font-weight:700;\n  letter-spacing:-.02em;color:var(--cream-100);margin-bottom:14px;\n}\n.prop-section__body {\n  font-family:var(--font-b);font-size:15px;line-height:1.75;\n  color:var(--text-secondary);max-width:64ch;\n}\n.prop-grid {\n  display:grid;\n  grid-template-columns:repeat(auto-fill,minmax(340px,1fr));\n  gap:2px;max-width:1200px;margin:0 auto;\n}\n.prop-card {\n  background:var(--bg-card);\n  padding:36px 32px;\n  border:1px solid var(--border-subtle);\n  transition:border-color .2s;\n}\n.prop-card:hover { border-color:var(--border-gold) }\n.prop-card__top {\n  display:flex;align-items:flex-start;justify-content:space-between;\n  gap:12px;margin-bottom:6px;\n}\n.prop-card__name {\n  font-family:var(--font-d);font-size:17px;font-weight:700;\n  color:var(--cream-100);letter-spacing:-.01em;\n}\n.prop-card__tier {\n  font-family:var(--font-d);font-size:8px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;\n  background:var(--accent-subtle);color:var(--gold-500);\n  border:1px solid var(--border-gold);padding:4px 9px;\n  white-space:nowrap;flex-shrink:0;\n}\n.prop-card__location {\n  font-family:var(--font-b);font-size:12px;color:var(--text-muted);\n  margin-bottom:16px;\n}\n.prop-card__desc {\n  font-family:var(--font-b);font-size:13px;line-height:1.75;\n  color:var(--text-secondary);\n}\n\n/* \u2500\u2500 POST CALLOUT \u2500\u2500 */\n.post-callout {\n  grid-column:2;\n  background:var(--bg-surface);\n  border:1px solid var(--border-gold);\n  padding:36px 40px;\n  margin:56px 0 48px;\n}\n.post-callout .post-callout__label {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.2em;text-transform:uppercase;color:var(--gold-500);\n  margin-bottom:14px;display:block;\n}\n.post-callout p {\n  font-family:var(--font-b);font-size:15px;line-height:1.75;\n  color:var(--text-secondary);margin-bottom:1em;\n}\n.post-callout p:last-child { margin-bottom:0 }\n.post-callout a { color:var(--gold-400);text-decoration:underline;text-decoration-color:rgba(201,168,76,.35) }\n.post-callout a:hover { color:var(--gold-300) }\n\n/* \u2500\u2500 DIVIDER \u2500\u2500 */\n.post-divider {\n  grid-column:2;\n  height:1px;background:var(--border-subtle);margin:8px 0;\n}\n\n/* \u2500\u2500 PLAN CTA \u2500\u2500 */\n.post-plan-cta {\n  background:var(--navy-900);\n  border-top:1px solid var(--border-subtle);\n  border-bottom:1px solid var(--border-subtle);\n  padding:72px 52px;\n  display:grid;\n  grid-template-columns:1fr 1fr;\n  gap:60px;align-items:start;\n}\n.post-plan-cta__title {\n  font-family:var(--font-d);font-size:clamp(22px,3vw,36px);font-weight:700;\n  letter-spacing:-.02em;color:var(--cream-100);line-height:1.15;margin-bottom:20px;\n}\n.post-plan-cta__body {\n  font-family:var(--font-b);font-size:15px;line-height:1.75;\n  color:var(--text-secondary);margin-bottom:32px;\n}\n.post-plan-cta__btn {\n  display:inline-block;\n  font-family:var(--font-d);font-size:10px;font-weight:700;\n  letter-spacing:.18em;text-transform:uppercase;\n  background:var(--gold-500);color:var(--navy-900);\n  padding:14px 32px;text-decoration:none;\n  transition:background .15s;\n}\n.post-plan-cta__btn:hover { background:var(--gold-400) }\n.post-plan-cta__details { display:flex;flex-direction:column;gap:20px }\n.post-plan-cta__detail-item {\n  display:flex;flex-direction:column;gap:4px;\n  padding-bottom:20px;border-bottom:1px solid var(--border-subtle);\n}\n.post-plan-cta__detail-item:last-child { border-bottom:none;padding-bottom:0 }\n.post-plan-cta__detail-item label {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.18em;text-transform:uppercase;color:var(--gold-500);\n}\n.post-plan-cta__detail-item span {\n  font-family:var(--font-b);font-size:14px;color:var(--text-secondary);\n}\n\n/* \u2500\u2500 POST FOOTER / TAGS \u2500\u2500 */\n.post-footer {\n  grid-column:2;\n  display:flex;align-items:center;justify-content:space-between;\n  flex-wrap:wrap;gap:20px;\n  padding:40px 0;\n}\n.post-footer__tags { display:flex;align-items:center;gap:8px;flex-wrap:wrap }\n.post-footer__tags-label {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.18em;text-transform:uppercase;color:var(--text-muted);\n  margin-right:4px;\n}\n.post-tag {\n  font-family:var(--font-d);font-size:9px;font-weight:600;\n  letter-spacing:.12em;text-transform:uppercase;\n  border:1px solid var(--border-subtle);color:var(--text-muted);\n  padding:5px 10px;\n}\n.post-footer__share { display:flex;align-items:center;gap:12px }\n.post-footer__share-label {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.18em;text-transform:uppercase;color:var(--text-muted);\n}\n\n/* \u2500\u2500 AUTHOR CARD \u2500\u2500 */\n.author-card {\n  background:var(--bg-surface);\n  border-top:1px solid var(--border-subtle);\n  border-bottom:1px solid var(--border-subtle);\n  padding:56px 52px;\n}\n.author-card__inner {\n  max-width:740px;margin:0 auto;\n  display:flex;gap:32px;align-items:flex-start;\n}\n.author-card__photo {\n  width:72px;height:72px;border-radius:50%;\n  background:var(--bg-card);border:1px solid var(--border-gold);\n  flex-shrink:0;display:flex;align-items:center;justify-content:center;\n}\n.author-card__photo-ph {\n  font-family:var(--font-d);font-size:13px;font-weight:700;\n  letter-spacing:.1em;color:var(--gold-600);\n}\n.author-card__name {\n  font-family:var(--font-d);font-size:15px;font-weight:700;\n  letter-spacing:.04em;color:var(--cream-100);margin-bottom:3px;\n}\n.author-card__title {\n  font-family:var(--font-b);font-size:12px;color:var(--text-muted);\n  margin-bottom:14px;\n}\n.author-card__bio {\n  font-family:var(--font-b);font-size:14px;line-height:1.75;\n  color:var(--text-secondary);margin-bottom:16px;\n}\n.author-card__cta {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;\n  color:var(--gold-500);text-decoration:none;\n}\n.author-card__cta:hover { color:var(--gold-300) }\n\n/* \u2500\u2500 RELATED \u2500\u2500 */\n.related {\n  padding:80px 52px;background:var(--bg-page);\n}\n.related__header {\n  max-width:1200px;margin:0 auto 48px;\n  display:flex;align-items:flex-end;justify-content:space-between;\n}\n.related__title {\n  font-family:var(--font-d);font-size:28px;font-weight:700;\n  letter-spacing:-.02em;color:var(--cream-100);\n}\n.related__all {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.18em;text-transform:uppercase;\n  color:var(--gold-500);text-decoration:none;\n}\n.related__grid {\n  display:grid;\n  grid-template-columns:repeat(auto-fill,minmax(280px,1fr));\n  gap:2px;max-width:1200px;margin:0 auto;\n}\n\n/* \u2500\u2500 NEWSLETTER \u2500\u2500 */\n.newsletter {\n  background:var(--navy-900);\n  border-top:1px solid var(--border-subtle);\n  padding:72px 52px;\n  display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;\n}\n.newsletter__title {\n  font-family:var(--font-d);font-size:clamp(20px,3vw,32px);font-weight:700;\n  letter-spacing:-.02em;color:var(--cream-100);margin-bottom:16px;\n}\n.newsletter__body {\n  font-family:var(--font-b);font-size:15px;line-height:1.75;color:var(--text-secondary);\n}\n.newsletter__form { display:flex;gap:0;margin-bottom:12px }\n.newsletter__input {\n  flex:1;background:var(--bg-card);border:1px solid var(--border-subtle);\n  border-right:none;padding:13px 18px;\n  font-family:var(--font-b);font-size:14px;color:var(--text-primary);\n  outline:none;\n}\n.newsletter__input::placeholder { color:var(--text-muted) }\n.newsletter__submit {\n  background:var(--gold-500);color:var(--navy-900);border:none;\n  padding:13px 28px;cursor:pointer;\n  font-family:var(--font-d);font-size:9px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;\n  transition:background .15s;\n}\n.newsletter__submit:hover { background:var(--gold-400) }\n.newsletter__fine {\n  font-family:var(--font-b);font-size:11px;color:var(--text-muted);\n}\n\n/* \u2500\u2500 FOOTER \u2500\u2500 */\n.footer { background:var(--navy-900);border-top:1px solid var(--border-subtle) }\n.footer__top {\n  padding:64px 52px;display:grid;\n  grid-template-columns:1.4fr 1fr 1fr 1fr 1fr;gap:40px;\n}\n.footer__brand-logo { height:28px;width:auto;object-fit:contain;margin-bottom:14px;display:block }\n.footer__tagline {\n  font-family:var(--font-d);font-size:11px;font-weight:700;letter-spacing:.12em;\n  text-transform:uppercase;color:var(--cream-100);margin-bottom:16px;\n}\n.footer__contact {\n  font-family:var(--font-b);font-size:13px;line-height:1.9;color:var(--text-muted);\n}\n.footer__contact a { color:var(--text-muted);text-decoration:none }\n.footer__contact a:hover { color:var(--gold-400) }\n.footer__col-title {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.2em;text-transform:uppercase;color:var(--text-muted);\n  margin-bottom:20px;\n}\n.footer__links { list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:10px }\n.footer__link {\n  font-family:var(--font-b);font-size:13px;color:var(--text-muted);\n  text-decoration:none;transition:color .15s;\n}\n.footer__link:hover { color:var(--gold-400) }\n.footer__bottom {\n  padding:20px 52px;border-top:1px solid var(--border-subtle);\n  display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;\n}\n.footer__legal { font-family:var(--font-b);font-size:11px;color:var(--text-muted) }\n.footer__copy { font-family:var(--font-b);font-size:11px;color:var(--text-muted) }\n\n/* \u2500\u2500 NAV (minimal reuse) \u2500\u2500 */\n.nav { position:fixed;top:0;left:0;right:0;z-index:100;height:76px;\n  display:flex;align-items:center;justify-content:space-between;padding:0 52px;\n  background:rgba(8,15,26,.92);backdrop-filter:blur(12px);\n  border-bottom:1px solid var(--border-subtle);\n}\n.nav__logo { display:flex;align-items:center;gap:12px;text-decoration:none }\n.nav__logo-img { height:26px;width:auto;object-fit:contain }\n.nav__logo-text {\n  font-family:var(--font-d);font-size:12px;font-weight:700;\n  letter-spacing:.14em;text-transform:uppercase;color:var(--cream-100);\n}\n.nav__links { display:flex;align-items:center;gap:36px }\n.nav__link {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.18em;text-transform:uppercase;color:var(--silver-400);\n  text-decoration:none;transition:color .15s;\n}\n.nav__link:hover { color:var(--gold-400) }\n.nav__cta {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.18em;text-transform:uppercase;\n  background:var(--gold-500);color:var(--navy-900);\n  padding:10px 22px;text-decoration:none;transition:background .15s;\n}\n.nav__cta:hover { background:var(--gold-400) }\n\n.label {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.22em;text-transform:uppercase;color:var(--gold-500);\n}\n";
