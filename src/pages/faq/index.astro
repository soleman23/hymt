---
import Base from "../../layouts/Base.astro";
import Content from "../../content-pages/faq.html?raw";
const pageCss = "\n\n.breadcrumb {\n  background:var(--bg-surface);border-bottom:1px solid var(--border-subtle);\n  padding:14px 52px;margin-top:76px;\n}\n.breadcrumb__inner {\n  display:flex;flex-wrap:wrap;align-items:center;gap:10px;\n  font-family:var(--font-d);font-size:10px;font-weight:600;\n  letter-spacing:.12em;text-transform:uppercase;\n}\n.breadcrumb__link { color:var(--text-muted);text-decoration:none;transition:color .15s }\n.breadcrumb__link:hover { color:var(--gold-400) }\n.breadcrumb__sep { color:var(--text-muted);font-size:10px }\n.breadcrumb__current { color:var(--gold-500) }\n\n/* \u2500\u2500 PAGE HERO \u2500\u2500 */\n.faq-hero {\n  background:var(--bg-surface);border-bottom:1px solid var(--border-subtle);\n  padding:80px 52px 72px;\n}\n.faq-hero__inner { max-width:860px }\n.faq-hero__label {\n  font-family:var(--font-d);font-size:10px;font-weight:700;\n  letter-spacing:.2em;text-transform:uppercase;color:var(--gold-500);margin-bottom:18px;\n}\n.faq-hero__title {\n  font-family:var(--font-d);font-size:clamp(34px,5vw,58px);font-weight:700;\n  letter-spacing:-.03em;color:var(--text-primary);line-height:1.02;margin-bottom:22px;\n}\n.faq-hero__sub {\n  font-family:var(--font-b);font-size:16px;color:var(--text-secondary);\n  line-height:1.75;max-width:62ch;margin-bottom:36px;\n}\n.faq-hero__cta {\n  display:inline-flex;align-items:center;gap:8px;\n  font-family:var(--font-d);font-size:11px;font-weight:700;\n  letter-spacing:.16em;text-transform:uppercase;\n  background:var(--gold-500);color:var(--navy-900);\n  padding:15px 32px;text-decoration:none;transition:background .15s;\n}\n.faq-hero__cta:hover { background:var(--gold-400) }\n\n/* \u2500\u2500 CATEGORY NAV \u2500\u2500 */\n.faq-cats {\n  background:var(--bg-page);border-bottom:1px solid var(--border-subtle);\n  padding:0 52px;position:sticky;top:64px;z-index:80;\n}\n.faq-cats__inner {\n  display:flex;gap:0;overflow-x:auto;\n  scrollbar-width:none;\n}\n.faq-cats__inner::-webkit-scrollbar { display:none }\n.faq-cat-btn {\n  flex-shrink:0;\n  font-family:var(--font-d);font-size:10px;font-weight:700;\n  letter-spacing:.14em;text-transform:uppercase;\n  color:var(--text-muted);background:none;border:none;cursor:pointer;\n  padding:18px 22px;border-bottom:2px solid transparent;\n  transition:color .15s,border-color .15s;white-space:nowrap;\n}\n.faq-cat-btn:hover { color:var(--gold-400) }\n.faq-cat-btn.active { color:var(--gold-500);border-bottom-color:var(--gold-500) }\n\n/* \u2500\u2500 MAIN LAYOUT \u2500\u2500 */\n.faq-layout {\n  display:grid;grid-template-columns:220px 1fr;\n  max-width:1200px;margin:0 auto;padding:0 52px;\n  align-items:start;\n}\n\n/* \u2500\u2500 STICKY SIDEBAR \u2500\u2500 */\n.faq-sidebar {\n  position:sticky;top:130px;\n  padding:48px 0;padding-right:48px;\n}\n.faq-sidebar__title {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.2em;text-transform:uppercase;color:var(--text-muted);\n  margin-bottom:20px;\n}\n.faq-sidebar__list { list-style:none;padding:0;margin:0;border-left:1px solid var(--border-subtle) }\n.faq-sidebar__link {\n  display:block;padding:7px 0 7px 18px;\n  font-family:var(--font-b);font-size:12px;color:var(--text-muted);\n  text-decoration:none;line-height:1.4;\n  border-left:2px solid transparent;margin-left:-1px;\n  transition:color .15s,border-color .15s;\n}\n.faq-sidebar__link:hover { color:var(--gold-400);border-left-color:var(--gold-500) }\n.faq-sidebar__link.active { color:var(--gold-500);border-left-color:var(--gold-500) }\n\n/* \u2500\u2500 FAQ CONTENT \u2500\u2500 */\n.faq-content {\n  padding:48px 0 96px;\n  border-left:1px solid var(--border-subtle);\n  padding-left:52px;\n}\n\n/* \u2500\u2500 CATEGORY SECTION \u2500\u2500 */\n.faq-group {\n  margin-bottom:64px;\n}\n.faq-group__header {\n  display:flex;align-items:center;gap:16px;\n  margin-bottom:8px;padding-bottom:20px;\n  border-bottom:1px solid var(--border-subtle);\n}\n.faq-group__icon {\n  width:40px;height:40px;flex-shrink:0;\n  border:1px solid var(--border-gold);\n  display:flex;align-items:center;justify-content:center;\n  font-size:16px;color:var(--gold-500);\n}\n.faq-group__label {\n  font-family:var(--font-d);font-size:9px;font-weight:700;\n  letter-spacing:.2em;text-transform:uppercase;color:var(--gold-500);margin-bottom:3px;\n}\n.faq-group__title {\n  font-family:var(--font-d);font-size:20px;font-weight:700;\n  letter-spacing:-.01em;color:var(--text-primary);margin:0;\n}\n\n/* \u2500\u2500 ACCORDION \u2500\u2500 */\n.faq-item {\n  border-bottom:1px solid var(--border-subtle);\n}\n.faq-item:first-of-type { border-top:1px solid var(--border-subtle) }\n.faq-q-h { margin:0;font:inherit }\n.faq-q {\n  width:100%;display:flex;align-items:center;justify-content:space-between;gap:20px;\n  background:none;border:none;cursor:pointer;\n  padding:20px 0;text-align:left;\n  appearance:none;-webkit-appearance:none;\n  transition:color .15s;\n}\n.faq-q:hover .faq-q__text { color:var(--gold-400) }\n.faq-q__text {\n  font-family:var(--font-d);font-size:15px;font-weight:600;\n  color:var(--text-primary);line-height:1.3;transition:color .15s;\n}\n.faq-q__icon {\n  flex-shrink:0;width:28px;height:28px;\n  border:1px solid var(--border-subtle);\n  display:flex;align-items:center;justify-content:center;\n  color:var(--gold-500);font-size:16px;font-weight:300;\n  transition:transform .25s,border-color .15s,background .15s;\n}\n.faq-item.open .faq-q__icon {\n  transform:rotate(45deg);\n  border-color:var(--gold-500);background:var(--accent-subtle);\n}\n.faq-a {\n  padding:0 48px 24px 0;\n}\n.js-accordion .faq-a { display:none }\n.js-accordion .faq-item.open .faq-a { display:block }\n.faq-a p {\n  font-family:var(--font-b);font-size:14px;color:var(--text-secondary);\n  line-height:1.85;margin-bottom:14px;\n}\n.faq-a p:last-child { margin-bottom:0 }\n.faq-a a {\n  color:var(--gold-400);text-decoration:none;\n  border-bottom:1px solid rgba(201,168,76,.3);transition:border-color .15s;\n}\n.faq-a a:hover { border-bottom-color:var(--gold-400) }\n.faq-a ul {\n  list-style:none;padding:0;margin:0 0 14px;\n}\n.faq-a ul li {\n  font-family:var(--font-b);font-size:14px;color:var(--text-secondary);\n  line-height:1.8;padding-left:18px;position:relative;margin-bottom:4px;\n}\n.faq-a ul li::before {\n  content:'\u2014';position:absolute;left:0;color:var(--gold-500);font-size:11px;\n}\n.faq-a-note {\n  background:var(--accent-subtle);border:1px solid var(--border-gold);\n  border-left:3px solid var(--gold-500);\n  padding:14px 18px;margin-top:14px;\n}\n.faq-a-note p {\n  font-family:var(--font-b);font-size:13px;color:var(--text-secondary);\n  line-height:1.7;margin:0;\n}\n.faq-a-note strong { color:var(--text-primary) }\n\n/* \u2500\u2500 STILL HAVE QUESTIONS \u2500\u2500 */\n.faq-cta {\n  background:var(--navy-800);border-top:1px solid var(--border-subtle);\n  padding:80px 52px;text-align:center;\n}\n.faq-cta__title {\n  font-family:var(--font-d);font-size:clamp(26px,3vw,38px);font-weight:700;\n  letter-spacing:-.02em;color:var(--cream-100);margin-bottom:14px;\n}\n.faq-cta__body {\n  font-family:var(--font-b);font-size:15px;color:var(--silver-300);\n  line-height:1.75;max-width:52ch;margin:0 auto 32px;\n}\n.faq-cta__btns { display:flex;gap:14px;justify-content:center;flex-wrap:wrap }\n.btn-primary-gold {\n  display:inline-flex;align-items:center;gap:8px;\n  font-family:var(--font-d);font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;\n  background:var(--gold-500);color:var(--navy-900);\n  padding:16px 36px;border:none;cursor:pointer;transition:background .15s;text-decoration:none;\n}\n.btn-primary-gold:hover { background:var(--gold-400) }\n.btn-ghost-gold {\n  display:inline-flex;align-items:center;gap:8px;\n  font-family:var(--font-d);font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;\n  background:transparent;color:var(--cream-100);\n  padding:15px 32px;border:1px solid rgba(255,255,255,.25);\n  cursor:pointer;transition:all .15s;text-decoration:none;\n}\n.btn-ghost-gold:hover { border-color:var(--gold-500);color:var(--gold-400) }\n\n/* \u2500\u2500 RESPONSIVE \u2500\u2500 */\n@media(max-width:960px){\n  .breadcrumb,.faq-hero,.faq-cats { padding-left:28px;padding-right:28px }\n  .faq-layout { grid-template-columns:1fr;padding:0 28px }\n  .faq-sidebar { display:none }\n  .faq-content { border-left:none;padding-left:0;padding-top:40px }\n  .faq-cta { padding:64px 28px }\n}\n@media(max-width:540px){\n  .faq-cats { padding:0 16px }\n  .faq-cat-btn { padding:16px 14px;font-size:9px }\n}\n";
---
<Base title="Frequently Asked Questions — Hit Your Mark Travel" description="Answers to the most common questions about working with Hit Your Mark Travel — from how we charge to what happens when something goes wrong." active="" pageCss={pageCss} schemaType="website">
  <Fragment set:html={Content} />
</Base>
