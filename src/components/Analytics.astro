---
/**
 * Analytics — GA4 via gtag.js, direct, no Tag Manager (P0-5 / DECISION-1).
 *
 * The measurement ID lives in the GA4_ID constant below and nowhere else on
 * the site. It went live 2026-09-01, replacing the "G-XXXXXXXXXX" placeholder.
 * docs/analytics-events.md quotes the same value; change both together.
 *
 * The disclosure gate (SEC-2, #75) was CLEARED before the real ID landed: the
 * privacy policy names GA4, the four events below, and Google's policy as of
 * August 2026, so going live created no disclosure mismatch. If the event list
 * here ever changes, the policy's Cookies & Analytics section has to change
 * with it — that is the whole point of the gate. The same gate covers HOW the
 * tag loads: the policy states the load rule in one sentence, and the
 * 2026-09-02 fallback below changed that sentence in the same commit.
 *
 * Deliberate constraints — do not "improve" them away:
 *  - Never fires on staging or localhost: hard hostname gate below.
 *  - gtag.js loads on first user interaction (scroll/pointerdown/keydown), or
 *    FALLBACK_MS after the window load event for a visitor who never
 *    interacts. Either way ~90KB of third-party JS stays off the critical
 *    path: LCP is already at risk (F5/F6/F13) and analytics must not add to
 *    it. Before the fallback (GA4 review, 2026-09-02) a visitor who read above
 *    the fold and left sent nothing at all, so GA undercounted every page
 *    against its Search Console clicks. `load` fires after LCP has settled,
 *    and the delay keeps the fetch clear of anything the page still has in
 *    flight.
 *  - Exactly four events, documented in docs/analytics-events.md:
 *      form_start            first field focus on Plan Your Trip or Contact
 *      form_submit_success   a form's branded success state shown (primary conversion)
 *      phone_click           any tel: link, with link_location
 *      email_click           any mailto: link, with link_location
 *    Add nothing else without updating that doc.
 *  - Parameters say WHERE, never WHAT: page_path on every event, and
 *    link_location (header / footer / body) on the two click events. It
 *    replaced link_url on 2026-09-02: every tel: link is the one number and
 *    every mailto: the one address, so the URL could not tell placements
 *    apart and the report had one row per event.
 */
const GA4_ID = "G-J6VZEBPCBC";
/* Slack after `load` before the no-interaction fallback fetches gtag.js. */
const FALLBACK_MS = 3000;
---
<script is:inline define:vars={{ GA4_ID, FALLBACK_MS }}>
(function () {
  if (location.hostname !== 'www.hymtravel.com') return;

  window.dataLayer = window.dataLayer || [];
  function gtag() { dataLayer.push(arguments); }
  window.gtag = gtag;
  gtag('js', new Date());
  gtag('config', GA4_ID, { send_page_view: true });

  var loaded = false;
  function loadGtag() {
    if (loaded) return;
    loaded = true;
    var s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA4_ID;
    document.head.appendChild(s);
  }
  ['scroll', 'pointerdown', 'keydown'].forEach(function (ev) {
    addEventListener(ev, loadGtag, { once: true, passive: true });
  });
  /* No-interaction fallback. A visitor who reads above the fold and leaves
     never scrolls, taps or types, so without this their page view is lost.
     Armed after `load`, when LCP is settled, plus FALLBACK_MS of slack. */
  function armFallback() { setTimeout(loadGtag, FALLBACK_MS); }
  if (document.readyState === 'complete') armFallback();
  else addEventListener('load', armFallback, { once: true });

  /* phone_click / email_click — delegated so every tel:/mailto: link counts.
     link_location is where on the page the link sat. The site's <nav> is the
     header and sits outside <main>; a breadcrumb <nav> inside <main> is body. */
  function linkLocation(a) {
    if (a.closest('footer')) return 'footer';
    if (a.closest('header, nav') && !a.closest('main')) return 'header';
    return 'body';
  }
  document.addEventListener('click', function (e) {
    var a = e.target && e.target.closest && e.target.closest('a[href^="tel:"], a[href^="mailto:"]');
    if (!a) return;
    var isTel = a.getAttribute('href').indexOf('tel:') === 0;
    gtag('event', isTel ? 'phone_click' : 'email_click', {
      link_location: linkLocation(a),
      page_path: location.pathname
    });
  });

  /* form_start — first field focus inside the inquiry form, once per page
     view. Listens on the form's own container, not the document, so the
     newsletter field in the footer (present on Contact) cannot count as a
     start. Plan Your Trip's wizard has no <form>; .plan-multistep wraps it. */
  var inquiryForm = document.querySelector('.plan-multistep') || document.getElementById('contactForm');
  if (inquiryForm) {
    var started = false;
    inquiryForm.addEventListener('focusin', function (e) {
      if (started) return;
      var t = e.target;
      if (t && /^(INPUT|SELECT|TEXTAREA)$/.test(t.tagName)) {
        started = true;
        gtag('event', 'form_start', { page_path: location.pathname });
      }
    });
  }

  /* form_submit_success — the branded success state appearing is the one
     signal both forms share (#successState on Plan Your Trip, #cfSuccess on
     Contact). Watching it means no coupling to the form scripts. Primary
     conversion in GA4. */
  var successEl = document.getElementById('successState') || document.getElementById('cfSuccess');
  if (successEl && 'MutationObserver' in window) {
    var fired = false;
    new MutationObserver(function () {
      if (fired) return;
      if (successEl.classList.contains('show')) {
        fired = true;
        gtag('event', 'form_submit_success', { page_path: location.pathname });
      }
    }).observe(successEl, { attributes: true, attributeFilter: ['class'] });
  }
})();
</script>
