node_modules/
.astro/
*.log
.DS_Store
__pycache__/
*.pyc

# Binary images are stored as base64 in images-b64/ (GitHub push limitation).
# After running tools/restore_images.py these exist locally but stay untracked:
public/assets/img/
public/assets/*.jpg
public/assets/*.png
public/assets/fonts/
dist/assets/

# Local deployment tooling. These embed the Hostinger FTP host and username,
# and this repository is public - keep them off GitHub. They live in the
# working copy only; see docs/hostinger-deployment.md for the procedure.
deploy-to-hostinger.ps1
check-remote.ps1
cleanup-home-stray.ps1
upload-one-file.ps1

# Local scratch / rollback copies
dist-deployed-backup/
_partial_node_modules_stash/
*.bak
*.singlestep.bak

# 4K generation masters for the destination heroes. Local only — the web
# derivatives live in images-b64/ like every other image in this repo.
tools/hero-masters/

# Staging area for incoming source photography before it is sized and
# converted into images-b64/. Same rule as tools/hero-masters/: originals
# stay local, only the base64 web derivatives are tracked.
incoming-sports/

# Place-card image pipeline (tools/image-pipeline/). This repository is public,
# so the Google OAuth client secret and refresh token must never be committed:
# .secrets.json holds them locally and config.json holds the resolved ids, while
# only config.example.json is tracked. The browser profile carries a live
# higgsfield.ai session cookie, which is a credential in its own right.
tools/image-pipeline/.secrets.json
tools/image-pipeline/config.json
tools/image-pipeline/.browser-profile/
tools/image-pipeline/downloads/
tools/image-pipeline/probe/
tools/image-pipeline/*.jsonl

# Playwright MCP session output. Every page snapshot and console log it writes
# lands here under a timestamped name, including the full text of third-party
# sites opened while researching. Scratch only, and this repository is public.
.playwright-mcp/

# 9:16 generation masters for the featured-itinerary panel. Same rule as
# tools/hero-masters/: originals stay local, only the 600x1000 web crops in
# images-b64/ are tracked. The prompt behind each one is in tools/itin-brief.json.
tools/itin-masters/
