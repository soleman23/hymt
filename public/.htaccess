# ============================================================
# Hit Your Mark Travel — Hostinger / LiteSpeed production config
# Place in public_html alongside index.html
# ============================================================

# ── Force HTTPS (after free SSL is active in hPanel) ──
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force apex → www.hymtravel.com (the canonical host used by every
  # <link rel="canonical">, og:url and sitemap entry on the site).
  # Scoped to hymtravel.com on purpose: a blanket www rule would send
  # preview domains (*.hostingersite.com) to a hostname that does not exist.
  # MUST run before the HTTPS rule (P1-7): it targets https://www. directly,
  # so http://hymtravel.com reaches the canonical host in ONE 301. With the
  # HTTPS rule first, http://hymtravel.com would take two hops
  # (→ https://hymtravel.com → https://www.hymtravel.com).
  RewriteCond %{HTTP_HOST} ^hymtravel\.com$ [NC]
  RewriteRule ^ https://www.hymtravel.com%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Pretty directory URLs: /about → /about/ → /about/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*?)/?$ /$1/ [L,R=301]
</IfModule>

# ── Default document ──
DirectoryIndex index.html

# ── Custom 404 ──
ErrorDocument 404 /404.html

# ── Gzip / Brotli compression ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
  AddOutputFilterByType DEFLATE application/xml text/xml font/ttf font/otf
</IfModule>

# ── Browser caching (images are immutable; HTML always fresh) ──
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresDefault "access plus 1 week"
</IfModule>

# ── Staging: block all indexing on any non-production host ──
# Matches the Hostinger preview domain. Production (www.hymtravel.com)
# is unaffected, so this rule can and should ship in the same .htaccess.
<IfModule mod_setenvif.c>
  SetEnvIf Host "hostingersite\.com$" IS_STAGING=1
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet" env=IS_STAGING
</IfModule>

# ── Security headers ──
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Long-cache immutable hint for static assets
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # no-transform: Hostinger's CDN (server: hcdn) re-compresses HTML on the
  # way out, and on 2026-08-06 it compressed one page — /destinations/
  # caribbean-mexico/ — into a body that decompressed to nothing but the
  # document's closing tag. 13 bytes instead of 39,913, rendering blank.
  # The origin file was verified correct over FTP; requesting the same URL
  # with `Accept-Encoding: identity` returned all 39,913 bytes. So the fault
  # is entirely in their compression pass, and it survived both a re-upload
  # and a CDN purge.
  #
  # RFC 9111 5.2.2.6: no-transform forbids an intermediary from altering
  # the payload. That is the deliberate trade: slower pages beat blank ones.
  #
  # RETESTED 2026-08-17 against the staging host, on the same URL that
  # originally broke. The stated cost is NOT being paid: with this header in
  # place the edge still negotiates compression, and the body decompresses to
  # the complete document.
  #
  #   Accept-Encoding: (none)  51,355 B   identity
  #   Accept-Encoding: gzip    15,084 B   Content-Encoding: gzip
  #   Accept-Encoding: br      13,498 B   Content-Encoding: br
  #   curl --compressed        14,230 B   Content-Encoding: zstd
  #                                       -> decompressed to 51,355 B, intact
  #
  # So the header is NOT holding HTML at ~40 KB — pages already ship at
  # ~13.5 KB on the wire — and the 13-byte corruption does not reproduce.
  # Removing it would therefore buy nothing measurable while re-exposing a
  # bug whose failure mode is a blank page. KEEP IT until there is a reason
  # better than a saving that is already banked. See #95.
  #
  # Retest (read the wire size and Content-Encoding, NOT `| wc -c` — curl
  # decompresses, so a piped byte count always reports the full document):
  #   curl -s -H 'Accept-Encoding: br' -D - -o /dev/null -w 'wire=%{size_download}
' <url>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate, no-transform"
  </FilesMatch>
</IfModule>

# ── Block access to sensitive files ──
# Defence in depth for anything that lands in public_html by accident — the
# deploy scripts, a stray .env, an editor backup. The build itself ships no
# file of any type listed here, so this can only ever deny a mistake.
# Extensions beyond the original log/md/json/lock/sh/py set added for SEC-7 (#78).
<FilesMatch "(^\.|\.(log|md|json|lock|sh|py|env|ya?ml|toml|ps1|pem|key|bak)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
