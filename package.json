{
  "name": "hym-travel",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node tools/restore-images.mjs && node tools/verify-checks.test.mjs && node tools/verify-deployment.mjs",
    "restore": "node tools/restore-images.mjs",
    "preview": "astro preview",
    "verify": "node tools/verify-deployment.mjs",
    "verify:remote": "node tools/verify-deployment.mjs --remote https://brown-goose-754147.hostingersite.com",
    "verify:prod": "node tools/verify-deployment.mjs --remote https://www.hymtravel.com"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^5.0.0"
  }
}
