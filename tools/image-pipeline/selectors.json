{
  "_comment": [
    "Ordered candidate lists; the first visible match wins. Rewritten 2026-08-10",
    "from live probes of higgsfield.ai/ai/image (see probe/ dumps): the stable",
    "hooks are [id='hf:...'] and [data-tour-anchor='tour-image-*'] attributes.",
    "':visible' guards keep .first() from waiting on hidden mobile duplicates.",
    "modelOption/aspectRatioOption/resolutionOption match INSIDE an open picker,",
    "so --probe reports them MISS against the closed panel by design - they were",
    "verified by clicking the pickers open (ratio/resolution: [role='option']",
    "in a listbox portal; models: button rows in a [role='dialog']).",
    "unlimitedToggle/unlimitedActiveMarker/loggedInMarker still need a signed-in",
    "dump: the only 'unlimited' control logged out is a promo banner, excluded below.",
    "2026-08-11: probe-diag used /ai/image while config pointed at /create/image,",
    "which 301s here; config now matches what was probed. /ai/image then 307s to",
    "?model=nano-banana-pro, so modelSelector is always read off a Nano Banana Pro",
    "button on arrival - the candidate regex already covers that spelling."
  ],
  "loggedInMarker": [
    "[data-testid='user-menu']",
    "button:has(img[alt*='avatar' i])",
    "header [role='button']:has(img)",
    "a[href*='/account']",
    "a[href*='/profile']"
  ],
  "loginMarker": [
    "a[href*='/login']",
    "button:has-text('Log in')",
    "button:has-text('Sign in')",
    "text=/^(log ?in|sign ?in)$/i"
  ],
  "promptInput": [
    "[id='hf:tour-image-prompt']",
    "[data-tour-anchor='tour-image-prompt']",
    "[contenteditable='true'][role='textbox']"
  ],
  "modelSelector": [
    "[data-tour-anchor='tour-image-form'] button:visible:text-matches('Seedream|Soul|Nano Banana|Flux|GPT Image|Recraft|Kling|Z-Image|WAN', 'i')",
    "button:visible:text-matches('Seedream|Soul|Nano Banana', 'i')"
  ],
  "modelOption": [
    "[role='dialog'] button:visible:has-text('{{model}}')",
    "[role='option']:has-text('{{model}}')",
    "[role='menuitem']:has-text('{{model}}')"
  ],
  "unlimitedToggle": [
    "[data-testid='unlimited-toggle']",
    "[role='switch'][aria-label*='unlimited' i]",
    "label:has-text('Unlimited') [role='switch']",
    "label:has-text('Unlimited') input[type='checkbox']",
    "button[aria-label*='unlimited' i]:not([aria-label*='Seedance' i]):not([aria-label*='get up to' i])"
  ],
  "unlimitedActiveMarker": [
    "[data-testid='unlimited-toggle'][aria-checked='true']",
    "[role='switch'][aria-label*='unlimited' i][aria-checked='true']",
    "[role='switch'][aria-label*='unlimited' i][data-state='checked']",
    "label:has-text('Unlimited') input[type='checkbox']:checked",
    "[data-testid='unlimited-badge']",
    "text=/unlimited (mode )?(is )?(on|active|enabled)/i"
  ],
  "aspectRatioSelector": [
    "button[aria-haspopup='listbox']:visible:text-matches('\\d+:\\d+|Auto', 'i')"
  ],
  "aspectRatioOption": [
    "[role='option']:visible:has-text('{{ratio}}')"
  ],
  "resolutionSelector": [
    "button[aria-haspopup='listbox']:visible:text-matches('[124]K', '')"
  ],
  "resolutionOption": [
    "[role='option']:visible:has-text('{{resolution}}')"
  ],
  "generateButton": [
    "[id='hf:image-form-submit']",
    "button[data-tour-anchor='tour-image-generate']",
    "button[type='submit']:visible:has-text('Generate')"
  ],
  "resultImage": [
    "[data-testid='generation-result'] img",
    "[data-testid='result-image']",
    "figure img[src*='http']",
    "main img[src*='cdn']",
    "img[alt*='generated' i]"
  ],
  "downloadButton": [
    "[data-testid='download-button']",
    "button[aria-label*='download' i]",
    "a[download]",
    "button:has-text('Download')"
  ],
  "errorMarker": [
    "[role='alert']",
    "[data-testid='error-message']",
    "text=/(generation )?failed|something went wrong|try again|insufficient credits/i"
  ]
}
