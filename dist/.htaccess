# ============================================================
# Hit Your Mark Travel — Hostinger / LiteSpeed production config
# Place in public_html alongside index.html
# ============================================================

# ── Force HTTPS (after free SSL is active in hPanel) ──
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Force apex → www.hymtravel.com (the canonical host used by every
  # <link rel="canonical">, og:url and sitemap entry on the site).
  # Scoped to hymtravel.com on purpose: a blanket www rule would send
  # preview domains (*.hostingersite.com) to a hostname that does not exist.
  RewriteCond %{HTTP_HOST} ^hymtravel\.com$ [NC]
  RewriteRule ^ https://www.hymtravel.com%{REQUEST_URI} [R=301,L]

  # Pretty directory URLs: /about → /about/ → /about/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*?)/?$ /$1/ [L,R=301]
</IfModule>

# ── Default document ──
DirectoryIndex index.html

# ── Custom 404 ──
ErrorDocument 404 /404.html

# ── Gzip / Brotli compression ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
  AddOutputFilterByType DEFLATE application/xml text/xml font/ttf font/otf
</IfModule>

# ── Browser caching (images are immutable; HTML always fresh) ──
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresDefault "access plus 1 week"
</IfModule>

# ── Security headers ──
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Long-cache immutable hint for static assets
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # no-transform: Hostinger's CDN (server: hcdn) re-compresses HTML on the
  # way out, and on 2026-08-06 it compressed one page — /destinations/
  # caribbean-mexico/ — into a body that decompressed to nothing but the
  # document's closing tag. 13 bytes instead of 39,913, rendering blank.
  # The origin file was verified correct over FTP; requesting the same URL
  # with `Accept-Encoding: identity` returned all 39,913 bytes. So the fault
  # is entirely in their compression pass, and it survived both a re-upload
  # and a CDN purge.
  #
  # RFC 9111 5.2.2.6: no-transform forbids an intermediary from altering
  # the payload, which takes their compressor out of the path for pages.
  # HTML then ships uncompressed — roughly 40 KB per page rather than 12 KB.
  # That is the deliberate trade: slower pages beat blank ones.
  #
  # Remove this once Hostinger confirms the CDN bug is fixed, and re-test
  # with: curl --compressed -s <url> | wc -c
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate, no-transform"
  </FilesMatch>
</IfModule>

# ── Block access to sensitive files ──
<FilesMatch "(^\.|\.(log|md|json|lock|sh|py)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
