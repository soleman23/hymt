# ============================================================
# Hit Your Mark Travel — Hostinger / LiteSpeed production config
# Place in public_html alongside index.html
# ============================================================

# ── Force HTTPS (after free SSL is active in hPanel) ──
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Same-domain Wix migration redirects. Keep these before the structural
  # host/protocol rules so every old URL reaches its canonical replacement in
  # one hop, including http:// and apex requests.
  RewriteRule ^terms-conditions/?$ https://www.hymtravel.com/terms-and-conditions/ [R=301,L,NE]
  RewriteRule ^trips/?$ https://www.hymtravel.com/travel-journal/ [R=301,L,NE]

  # Force apex → www.hymtravel.com (the canonical host used by every
  # <link rel="canonical">, og:url and sitemap entry on the site).
  # Scoped to hymtravel.com on purpose: a blanket www rule would send
  # preview domains (*.hostingersite.com) to a hostname that does not exist.
  # MUST run before the HTTPS rule (P1-7): it targets https://www. directly,
  # so http://hymtravel.com reaches the canonical host in ONE 301. With the
  # HTTPS rule first, http://hymtravel.com would take two hops
  # (→ https://hymtravel.com → https://www.hymtravel.com).
  RewriteCond %{HTTP_HOST} ^hymtravel\.com$ [NC]
  RewriteRule ^ https://www.hymtravel.com%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Pretty directory URLs: /about → /about/ → /about/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*?)/?$ /$1/ [L,R=301]
</IfModule>

# ── Default document ──
DirectoryIndex index.html

# ── Custom 404 ──
ErrorDocument 404 /404.html

# ── Gzip / Brotli compression ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
  AddOutputFilterByType DEFLATE application/xml text/xml font/ttf font/otf
</IfModule>

# ── Browser caching (images are immutable; HTML always fresh) ──
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresDefault "access plus 1 week"
</IfModule>

# ── Staging: block all indexing on any non-production host ──
# Matches the Hostinger preview domain. Production (www.hymtravel.com)
# is unaffected, so this rule can and should ship in the same .htaccess.
<IfModule mod_setenvif.c>
  SetEnvIf Host "hostingersite\.com$" IS_STAGING=1
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet" env=IS_STAGING
</IfModule>

# ── Production: arm the host-scoped headers ──
# The mirror of IS_STAGING above. HSTS must be sent ONLY by the canonical
# host: pinning a preview domain to HTTPS relies on a certificate this repo
# does not control, and an expiry there would be unrecoverable from the
# browser side for the length of max-age.
<IfModule mod_setenvif.c>
  SetEnvIf Host "^(www\.)?hymtravel\.com$" IS_PROD=1
</IfModule>

# ── Security headers ──
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # ── SEC-4 (#79): HSTS, production host only ──
  # #79 reads as "add this after cutover", but the reason it exists is a
  # REGRESSION: www.hymtravel.com sends `strict-transport-security:
  # max-age=31556952` from the Wix edge today, and that header disappears the
  # moment DNS points here. Shipping it env=IS_PROD resolves the ordering —
  # inert on *.hostingersite.com, live the instant the canonical host
  # resolves to this box, so there is no window where HSTS is missing.
  #
  # A browser ignores HSTS received over a bad certificate, so this cannot
  # lock anyone out of a host whose SSL is not ready yet; what it can do is
  # commit them for max-age once SSL IS good. Hence the issue's 1-day ramp
  # value, not the 1-year target. Raising it is a deliberate two-place edit:
  # here, and the `expected` string in content-checks.mjs → htaccessGaps.
  # Confirm valid certs on BOTH apex and www (#32/#33) before raising.
  #
  # No `preload`. That is a one-way submission to a browser-shipped list and
  # #79 explicitly does not ask for it.
  Header always set Strict-Transport-Security "max-age=86400" env=IS_PROD

  # ── SEC-9 (#82): Content-Security-Policy, REPORT-ONLY ──
  # Report-only on purpose. It is a latent-XSS mitigation for author-controlled
  # static HTML, so it is hardening rather than a cutover blocker, and shipping
  # it enforcing without a browse first is how you find out at launch that the
  # inquiry form no longer submits. Violations surface in the browser console;
  # there is no report endpoint because a static host has nothing to receive
  # one. Switching to enforcing is #100, and only after a clean browse of the
  # homepage, a destination page, a journal post, Contact and Plan Your Trip.
  #
  # Inventory this was built from, against dist/ on 2026-08-17, script-src
  # revised 2026-08-18:
  #   script-src hashes       - every page carries inline <script>: 425 blocks
  #                             site-wide, but only 10 DISTINCT bodies, so
  #                             script-src names each by sha256 and carries no
  #                             'unsafe-inline'. The 141 inline onclick=
  #                             handlers the 08-17 inventory counted are 0 now
  #                             (#100 groundwork; the inline-handler check
  #                             holds it there). THE LIST IS GENERATED, NOT
  #                             MAINTAINED: the build's csp-script-src check
  #                             diffs it against every inline script in dist/
  #                             and fails with the exact value to paste here.
  #                             Do not hand-edit a hash. Two traps it guards:
  #                             (a) a browser hashes script text after CRLF is
  #                             normalised to LF, and three bodies (home,
  #                             Contact, Plan Your Trip) carry CR in dist/, so
  #                             a raw-byte hash is silently wrong on exactly
  #                             the conversion path; (b) once ANY hash is
  #                             present a browser ignores 'unsafe-inline', so
  #                             coverage is all-or-nothing and an edit to any
  #                             inline script changes its hash - under
  #                             report-only a console line, under enforcing
  #                             that script dead on every page carrying it.
  #                             ld+json blocks are not hashed: script-src does
  #                             not apply to a non-executable type.
  #   googletagmanager.com    - Analytics.astro injects gtag.js at runtime.
  #                             There is no <script src> in the HTML at all.
  #   api.web3forms.com       - connect-src for the three forms' fetch, and
  #                             form-action because the newsletter keeps a
  #                             native action= as its no-JS fallback (#83).
  #   'self' fonts            - Raleway and DM Sans are self-hosted under
  #                             /assets/fonts/. No Google Fonts origin needed.
  #   data: img               - none in the HTML today; allowed because it is
  #                             a common analytics beacon shape and costs
  #                             nothing to permit.
  #
  # Hostinger's edge already sends its own `Content-Security-Policy:
  # upgrade-insecure-requests`. This is a DIFFERENT header, so the two do not
  # merge or conflict — do not "consolidate" them.
  #
  # VERIFIED 2026-08-17 before shipping. dist/ was served locally with this
  # exact policy applied as *enforcing* — deliberately stricter than what ships
  # — and browsed: home, Contact, Plan Your Trip, a destination page. Zero
  # violations. 11 inline onclick handlers fired, 7 accordions toggled, 6
  # self-hosted fonts loaded, 12 images, 3 stylesheets, all clean.
  #
  # The controls matter more than the clean run: a fetch to an unlisted origin
  # was refused by `connect-src` and an unlisted <script src> by
  # `script-src-elem`, which is what proves the policy was actually live rather
  # than silently inert. api.web3forms.com was NOT blocked.
  #
  # ONE GAP, on purpose: gtag.js could not be exercised locally, because
  # Analytics.astro gates itself on `location.hostname === 'www.hymtravel.com'`
  # and does nothing anywhere else. The googletagmanager and google-analytics
  # entries above are therefore reasoned from the code, not observed. **That is
  # the specific thing to watch in the report-only console review before #100
  # flips this to enforcing.**
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'sha256-2C5uHkKXj70urOh+oF/cbrPHqtEPZdW90xiBzItXL/Q=' 'sha256-2enSBrTaqAgikPryFm7SETfa8CikvpEL0Zjk3GYqWpw=' 'sha256-A8nJuRMRV8gKhPBmgyiqQ1OaNtXjid2FlgDx+JCwpOg=' 'sha256-P3uTVPSPEXpwPPqzmktut6L5IDbUsWRhcj3hrwyuDeM=' 'sha256-PEeAqcxwbn/3mtFV3LurhrP3znaTQu4kaR5x45LYgDE=' 'sha256-VuDxb/TjA2hpjbD1CWiKjTjRHb5qd15mTvoFZA8cmkM=' 'sha256-XaxB7SY+bFMKA3tBIjRqAPMA80qdIvtlSh0lUTGeylg=' 'sha256-bRMg786r1QonXLQ4FIDlwwSkdN81Hmb1PCFGQP7HufU=' 'sha256-cP1sIPxo8K1aY23/HvN4WqswzaGCD6nzPEzQFDx6wzA=' 'sha256-wtlY0QypsoxQFoIz4YB1ZWUnA1Gnotp/yhzSc4cd7o4=' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com; font-src 'self'; connect-src 'self' https://api.web3forms.com https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com; form-action 'self' https://api.web3forms.com; frame-ancestors 'self'; frame-src 'none'; base-uri 'self'; object-src 'none'"
  # ── Static asset caching ──
  #
  # NOT `immutable`, deliberately (#107). `immutable` is a promise that the URL
  # will never change content, and it is only safe when the filename is
  # content-addressed. Astro hashes what it emits under /_astro/; everything
  # under /assets/img/ is hand-managed with stable names, so the same URL DOES
  # change content whenever an image is re-cut or replaced.
  #
  # It had `immutable, max-age=31536000` and the consequence was measured on
  # staging 2026-08-18: uploads landed at origin and never reached anyone.
  #
  #   HEAD -> x-hcdn-cache-status: MISS, Content-Length: 288,154  (new file)
  #   GET  -> x-hcdn-cache-status: HIT,  Content-Length: 295,047  (year-old copy)
  #
  # The GET also came back carrying the PREVIOUS Cache-Control value, which is
  # what gives it away: the edge was replaying a whole cached response. It
  # ignored `Cache-Control: no-cache` and `Pragma: no-cache` request headers,
  # because `immutable` tells a cache not to revalidate and it was obeying.
  #
  # Two earlier conclusions were wrong and are recorded so they are not redone:
  # a `?query=` cache-bust "proved" it was not caching (this CDN keys static
  # assets without the query string), and a HEAD showing MISS "proved" the
  # origin was stale (HEAD reaches origin, GET is served from edge). Diagnose
  # this class of bug with a GET, and read x-hcdn-cache-status.
  #
  # A month is long enough to be worth having and short enough that a mistake
  # ages out on its own. Revalidation still makes repeat views free.
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=2592000, no-transform"
  </FilesMatch>

  # no-transform: Hostinger's CDN (server: hcdn) re-compresses HTML on the
  # way out, and on 2026-08-06 it compressed one page — /destinations/
  # caribbean-mexico/ — into a body that decompressed to nothing but the
  # document's closing tag. 13 bytes instead of 39,913, rendering blank.
  # The origin file was verified correct over FTP; requesting the same URL
  # with `Accept-Encoding: identity` returned all 39,913 bytes. So the fault
  # is entirely in their compression pass, and it survived both a re-upload
  # and a CDN purge.
  #
  # RFC 9111 5.2.2.6: no-transform forbids an intermediary from altering
  # the payload. That is the deliberate trade: slower pages beat blank ones.
  #
  # RETESTED 2026-08-17 against the staging host, on the same URL that
  # originally broke. The stated cost is NOT being paid: with this header in
  # place the edge still negotiates compression, and the body decompresses to
  # the complete document.
  #
  #   Accept-Encoding: (none)  51,355 B   identity
  #   Accept-Encoding: gzip    15,084 B   Content-Encoding: gzip
  #   Accept-Encoding: br      13,498 B   Content-Encoding: br
  #   curl --compressed        14,230 B   Content-Encoding: zstd
  #                                       -> decompressed to 51,355 B, intact
  #
  # So the header is NOT holding HTML at ~40 KB — pages already ship at
  # ~13.5 KB on the wire — and the 13-byte corruption does not reproduce.
  # Removing it would therefore buy nothing measurable while re-exposing a
  # bug whose failure mode is a blank page. KEEP IT until there is a reason
  # better than a saving that is already banked. See #95.
  #
  # Retest (read the wire size and Content-Encoding, NOT `| wc -c` — curl
  # decompresses, so a piped byte count always reports the full document):
  #   curl -s -H 'Accept-Encoding: br' -D - -o /dev/null -w 'wire=%{size_download}
' <url>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate, no-transform"
  </FilesMatch>
</IfModule>

# ── Block access to sensitive files ──
# Defence in depth for anything that lands in public_html by accident — the
# deploy scripts, a stray .env, an editor backup. The build itself ships no
# file of any type listed here, so this can only ever deny a mistake.
# Extensions beyond the original log/md/json/lock/sh/py set added for SEC-7 (#78).
<FilesMatch "(^\.|\.(log|md|json|lock|sh|py|env|ya?ml|toml|ps1|pem|key|bak)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
