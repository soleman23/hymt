# Astro 7 refuses to run below Node 22.12.0. package.json engines.node says so,
# but by default npm only prints an EBADENGINE warning and installs anyway —
# leaving a node_modules that resolves fine and then cannot build.
#
# engine-strict turns that warning into an install-time failure, which is the
# point at which it is cheap to fix.
engine-strict=true
