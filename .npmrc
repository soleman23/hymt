# The dependency tree refuses to install below Node 22.19.0 — undici, reached
# through astro -> unifont, is the package that sets that floor. package.json
# engines.node mirrors it, but by default npm only prints an EBADENGINE warning
# and installs anyway — leaving a node_modules that resolves fine and then
# cannot build.
#
# engine-strict turns that warning into an install-time failure, which is the
# point at which it is cheap to fix.
#
# When a deploy fails with EBADENGINE, this line is NOT the bug. It is the
# check reporting that the host's Node is below what the tree requires, which
# is exactly its job — the 2026-08-29 Hostinger build died here on Node
# v22.18.0. Raise the Node version on the host; do not relax this to get an
# install that only appears to succeed.
engine-strict=true
